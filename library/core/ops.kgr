//! Implement these traits to give existing Kagari syntax a meaning for your types.
//! For a binary operator, the type on the left is `Self`, the type on the right
//! selects the trait application (`Rhs`), and the implementation chooses `Output`.
//! For example, a position plus a distance can be a position, while the difference
//! between two positions can be a distance. Neither operation implies a conversion.
//!
//! `RangeBounds` inspects endpoints without traversing a range. `Try` and
//! `FromResidual` describe how `?` can continue a calculation or leave it early.

/// Describes one endpoint, independently of the other end of a range. Match
/// the variant before using its value: an absent bound is not zero or a
/// maximum value. For example, the upper endpoint of `1..4` excludes `4`.
pub enum Bound<T> {
    /// The endpoint value itself is in bounds on this side.
    Included(T),

    /// The endpoint value itself is out of bounds on this side.
    Excluded(T),

    /// This side places no limit on the range.
    Unbounded,
}

pub use self::Bound::{Included, Excluded, Unbounded};

/// Signals whether a caller should stop or keep going. Unlike `Result`, a
/// `Break` need not mean failure: a tree visitor looking for a node can return
/// `Break(node)` when it finds the answer and `Continue(())` to keep searching.
/// The first type argument is the value carried *out*; the second is the value
/// passed to the next step.
///
/// Inside a function returning `ControlFlow`, `visit(child)?` unwraps a
/// `Continue` but returns a `Break` to the caller immediately. Nested visits
/// can therefore stop the whole search without reserving a special node value.
pub enum ControlFlow<B, C> {
    /// Stops the operation, carrying its early-exit value.
    Break(B),

    /// Continues the operation, carrying its next value.
    Continue(C),
}

/// Lets callers write `left + right` for a type that defines addition.
/// Implement `Add<Rhs>` on the **left** operand's type. For example,
/// `Add<i32> for Position` allows `p + 2`; it does not allow `2 + p`.
/// Even when both operands have the same type, write the right-hand type
/// explicitly: Kagari has no default for `Rhs`.
///
/// Here `Output` is `Position`, so the caller can use the result as a position
/// without converting it. The implementation constructs a new position. Its
/// inner `i32` addition uses Kagari's checked arithmetic and traps on overflow.
///
/// ```kagari
/// use core::ops::Add;
///
/// struct Position {
///     val x: i32
/// }
///
/// impl Add<i32> for Position {
///     type Output = Position;
///
///     fn add(self, distance: i32) -> Position {
///         Position { x: self.x + distance }
///     }
/// }
///
/// fn advance(p: Position) -> Position {
///     p + 2
/// }
/// ```
///
/// `advance(Position { x: 3 }).x` returns `5`.
#[lang = "add"]
pub trait Add<Rhs> {
    /// The type callers receive from `left + right`, chosen for this pair of operand types.
    type Output;

    /// Called as `left.add(right)` or `left + right`; this does not overload `+=`.
    fn add(self, rhs: Rhs) -> Self::Output;
}

/// Gives `left - right` a meaning for the selected right-hand type. For a
/// `Position`, two useful operations have different results: `p - distance`
/// can produce another position, while `end - start` can produce an `i32`
/// displacement. These need separate implementations, `Sub<i32>` and
/// `Sub<Position>`; implementing `Add` provides neither one.
#[lang = "sub"]
pub trait Sub<Rhs> {
    /// Type of the difference; it need not be the receiver type.
    type Output;

    /// Computes `self - rhs` in that order: `end - start` measures from `start` to `end`.
    fn sub(self, rhs: Rhs) -> Self::Output;
}

/// Defines `left * right`. Multiplying a vector by a scalar need not take two
/// operands of the same type. Builtin integer multiplication traps on overflow.
#[lang = "mul"]
pub trait Mul<Rhs> {
    /// Type of the product.
    type Output;

    /// Multiplies `self` by `rhs`.
    fn mul(self, rhs: Rhs) -> Self::Output;
}

/// Defines `left / right`. For builtin integers a zero divisor and signed
/// minimum divided by `-1` trap. A custom `div` is an ordinary method: if
/// some divisors are invalid for your type, decide how callers discover that
/// rather than relying on `/` to check before entering the method.
#[lang = "div"]
pub trait Div<Rhs> {
    /// Type of the quotient.
    type Output;

    /// Returns the quotient of `self / divisor`.
    fn div(self, divisor: Rhs) -> Self::Output;
}

/// Defines `left % right`, distinct from computing a quotient with `/`.
/// Builtin integer remainder traps on a zero divisor and on signed minimum `% -1`.
#[lang = "rem"]
pub trait Rem<Rhs> {
    /// Type of the remainder.
    type Output;

    /// Returns the remainder of dividing `self` by `divisor`.
    fn rem(self, divisor: Rhs) -> Self::Output;
}

/// Defines `left & right`. For bit masks, a result bit is set when both
/// input bits are set. Unlike `&&`, this evaluates both operands.
#[lang = "bit_and"]
pub trait BitAnd<Rhs> {
    /// Type of the conjunction.
    type Output;

    /// For masks, `flags & mask` keeps just the bits selected by `mask`.
    fn bitand(self, rhs: Rhs) -> Self::Output;
}

/// Defines `left | right`. For bit masks, a result bit is set when either
/// input bit is set. This is not the short-circuit operator `||`.
#[lang = "bit_or"]
pub trait BitOr<Rhs> {
    /// Type of the disjunction.
    type Output;

    /// For masks, `flags | mask` sets the selected bits without clearing the others.
    fn bitor(self, rhs: Rhs) -> Self::Output;
}

/// Defines `left ^ right`. For bit masks, a result bit is set when exactly
/// one of the two input bits is set; XOR with a mask toggles those bits.
#[lang = "bit_xor"]
pub trait BitXor<Rhs> {
    /// Type of the exclusive disjunction.
    type Output;

    /// For masks, applying the same mask twice restores the original bits.
    fn bitxor(self, rhs: Rhs) -> Self::Output;
}

/// Defines `value << count`. The right operand describes the shift rather
/// than a second value to combine. Builtin integers check the count against
/// the left operand's width and discard bits shifted past that width.
#[lang = "shl"]
pub trait Shl<Rhs> {
    /// Type of the left-shifted value.
    type Output;

    /// Shifts `self` left by `count` positions.
    fn shl(self, count: Rhs) -> Self::Output;
}

/// Defines `value >> count`. Builtin integers check the shift count; a signed
/// right shift extends the sign bit, unlike shifting an unsigned integer.
#[lang = "shr"]
pub trait Shr<Rhs> {
    /// Type of the right-shifted value.
    type Output;

    /// Shifts `self` right by `count` positions.
    fn shr(self, count: Rhs) -> Self::Output;
}

/// Defines unary `-value`, not subtraction of a right operand. Negating the
/// minimum builtin signed integer traps because its positive value does not fit.
#[lang = "neg"]
pub trait Neg {
    /// Type of the negated value.
    type Output;

    /// Returns the arithmetic negation of `self`.
    fn neg(self) -> Self::Output;
}

/// Defines unary `!value`. On a boolean this reverses truth; on an integer
/// it complements all bits at its declared width. It does not control `!=`.
#[lang = "not"]
pub trait Not {
    /// Type of the inverted value.
    type Output;

    /// Returns the implementation's inversion of `self`.
    fn not(self) -> Self::Output;
}

/// Defines what is read by `bag[key]`. Use it for element access, not to
/// expose a writable slot or a Rust reference. A returned object keeps its
/// usual shared identity. The implementation chooses how to handle a missing
/// key; provide an optional lookup if callers need to recover from absence.
#[lang = "index"]
pub trait Index<Key> {
    /// Type of the value returned by an indexed read.
    type Output;

    /// Called once for `bag[key]`. If it returns a struct, writing a writable
    /// field on that object is not a second call to write it back to `bag`.
    fn index(self, key: Key) -> Self::Output;
}

/// Makes a value callable with `f(args...)`. The trait takes one tuple type:
/// `Fn<(i32,)>` accepts one integer, whereas `Fn<()>` takes no arguments.
/// Calls evaluate arguments left to right, once each. Use a callable bound
/// when the caller need not know whether `f` is a closure or a callable object.
#[lang = "fn"]
pub trait Fn<Args> {
    /// Type produced by the call.
    type Output;

    /// Calls `self` with `args`, the tuple of evaluated arguments.
    fn call(self, args: Args) -> Self::Output;
}

/// Lets a caller inspect each endpoint without enumerating the values in a
/// range. For example, `1..4` and `1..=4` share an included start, but their
/// end bounds are respectively `Excluded(4)` and `Included(4)`.
pub trait RangeBounds<T> {
    /// Returns the lower bound, or `Unbounded` if there is no lower limit.
    fn start_bound(self) -> Bound<T>;

    /// Returns the upper bound, or `Unbounded` if there is no upper limit.
    fn end_bound(self) -> Bound<T>;
}

/// The half-open range `start..end`: includes `start` and excludes `end`.
/// For example, `2..5` describes the integers `2`, `3`, and `4`.
pub native type Range<T>;

/// The closed range `start..=end`: includes both endpoints. Use `2..=5`
/// rather than `2..5` when `5` itself belongs in the interval.
pub native type RangeInclusive<T>;

/// The range `start..` includes `start` and has no upper bound. For example,
/// `2..` describes an interval starting at `2` without specifying its end.
pub native type RangeFrom<T>;

/// The range `..end` has no lower bound and excludes `end`. It describes
/// a prefix, not an iterator starting at zero.
pub native type RangeTo<T>;

/// The range `..=end` has no lower bound and includes `end`. Use `..=4`
/// rather than `..4` when the prefix should include `4`.
pub native type RangeToInclusive<T>;

/// The range `..` leaves both endpoints unbounded. It stores no endpoint
/// value and can be used as `RangeBounds<T>` for any endpoint type `T`.
pub native type RangeFull;

native fn range_bound<T>(range: Range<T>, upper: bool) -> Bound<T>;

native fn inclusive_bound<T>(range: RangeInclusive<T>, upper: bool) -> Bound<T>;

native fn from_bound<T>(range: RangeFrom<T>, upper: bool) -> Bound<T>;

native fn to_bound<T>(range: RangeTo<T>, upper: bool) -> Bound<T>;

native fn to_inclusive_bound<T>(range: RangeToInclusive<T>, upper: bool) -> Bound<T>;

native fn full_bound<T>(range: RangeFull, upper: bool) -> Bound<T>;

impl<T> RangeBounds<T> for Range<T> {
    fn start_bound(self) -> Bound<T> {
        range_bound(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        range_bound(self, true)
    }
}

impl<T> RangeBounds<T> for RangeInclusive<T> {
    fn start_bound(self) -> Bound<T> {
        inclusive_bound(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        inclusive_bound(self, true)
    }
}

impl<T> RangeBounds<T> for RangeFrom<T> {
    fn start_bound(self) -> Bound<T> {
        from_bound(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        from_bound(self, true)
    }
}

impl<T> RangeBounds<T> for RangeTo<T> {
    fn start_bound(self) -> Bound<T> {
        to_bound(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        to_bound(self, true)
    }
}

impl<T> RangeBounds<T> for RangeToInclusive<T> {
    fn start_bound(self) -> Bound<T> {
        to_inclusive_bound(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        to_inclusive_bound(self, true)
    }
}

impl<T> RangeBounds<T> for RangeFull {
    fn start_bound(self) -> Bound<T> {
        full_bound::<T>(self, false)
    }

    fn end_bound(self) -> Bound<T> {
        full_bound::<T>(self, true)
    }
}

/// Defines the two paths of `value?`. The expression evaluates `value` and
/// calls `branch` once. A `Continue` supplies the expression's value; a
/// `Break` sends the residual to the enclosing return type's `FromResidual`.
/// Neither path catches traps. Implement this trait for a carrier, not for
/// the success or failure payload alone.
#[lang = "try"]
pub trait Try: FromResidual<Self::Residual> {
    /// The value available after `?` continues.
    type Output;

    /// What travels along the early-return path. For `Result<T, E>` this is
    /// `Result<!, E>`, not just `E`: it identifies which carrier stopped.
    type Residual;

    /// Wraps `output` on the successful path, e.g. `Some(output)` for an option.
    fn from_output(output: Self::Output) -> Self;

    /// Separates the successful value from the residual without converting either.
    fn branch(self) -> ControlFlow<Self::Residual, Self::Output>;
}

/// Constructs the enclosing return value when `?` stops early. Implement it
/// for a compatible residual; two carriers need not interoperate just because
/// their payloads happen to have the same type.
#[lang = "from_residual"]
pub trait FromResidual<R> {
    /// Returns the enclosing carrier's early-exit value, preserving the meaning of `residual`.
    fn from_residual(residual: R) -> Self;
}

impl<B, C> FromResidual<ControlFlow<B, !>> for ControlFlow<B, C> {
    fn from_residual(residual: ControlFlow<B, !>) -> Self {
        match residual {
            ControlFlow::Break(value) => ControlFlow::Break(value),
            ControlFlow::Continue(never) => match never {},
        }
    }
}

impl<B, C> Try for ControlFlow<B, C> {
    type Output = C;
    type Residual = ControlFlow<B, !>;

    fn from_output(output: C) -> Self {
        ControlFlow::Continue(output)
    }

    fn branch(self) -> ControlFlow<Self::Residual, C> {
        match self {
            ControlFlow::Continue(value) => ControlFlow::Continue(value),
            ControlFlow::Break(value) => ControlFlow::Break(ControlFlow::Break(value)),
        }
    }
}
