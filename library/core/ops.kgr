// Core ops traits. This source owns their declarations and language roles.

/// Adds a value to the receiver.
#[lang = "add"]
pub trait Add<T0> {
    type Output;
    fn add(self, arg1: T0) -> <Self as Add<T0>>::Output;
}

/// Subtracts a value from the receiver.
#[lang = "sub"]
pub trait Sub<T0> {
    type Output;
    fn sub(self, arg1: T0) -> <Self as Sub<T0>>::Output;
}

/// Multiplies the receiver by a value.
#[lang = "mul"]
pub trait Mul<T0> {
    type Output;
    fn mul(self, arg1: T0) -> <Self as Mul<T0>>::Output;
}

/// Divides the receiver by a value.
#[lang = "div"]
pub trait Div<T0> {
    type Output;
    fn div(self, arg1: T0) -> <Self as Div<T0>>::Output;
}

/// Computes the remainder of division.
#[lang = "rem"]
pub trait Rem<T0> {
    type Output;
    fn rem(self, arg1: T0) -> <Self as Rem<T0>>::Output;
}

/// Computes a bitwise conjunction.
#[lang = "bit_and"]
pub trait BitAnd<T0> {
    type Output;
    fn bitand(self, arg1: T0) -> <Self as BitAnd<T0>>::Output;
}

/// Computes a bitwise disjunction.
#[lang = "bit_or"]
pub trait BitOr<T0> {
    type Output;
    fn bitor(self, arg1: T0) -> <Self as BitOr<T0>>::Output;
}

/// Computes a bitwise exclusive disjunction.
#[lang = "bit_xor"]
pub trait BitXor<T0> {
    type Output;
    fn bitxor(self, arg1: T0) -> <Self as BitXor<T0>>::Output;
}

/// Shifts the receiver left.
#[lang = "shl"]
pub trait Shl<T0> {
    type Output;
    fn shl(self, arg1: T0) -> <Self as Shl<T0>>::Output;
}

/// Shifts the receiver right.
#[lang = "shr"]
pub trait Shr<T0> {
    type Output;
    fn shr(self, arg1: T0) -> <Self as Shr<T0>>::Output;
}

/// Negates the receiver.
#[lang = "neg"]
pub trait Neg {
    type Output;
    fn neg(self) -> <Self as Neg>::Output;
}

/// Inverts the receiver.
#[lang = "not"]
pub trait Not {
    type Output;
    fn not(self) -> <Self as Not>::Output;
}

/// Reads an indexed element.
#[lang = "index"]
pub trait Index<T0> {
    type Output;
    fn index(self, arg1: T0) -> <Self as Index<T0>>::Output;
}

/// Calls a value with an argument tuple.
#[lang = "fn"]
pub trait Fn<T0> {
    type Output;
    fn call(self, arg1: T0) -> <Self as Fn<T0>>::Output;
}
