// Core language traits. This source owns the declarations and language roles.

/// A shared cursor. Each next call advances it and returns Some(item), or None when exhausted.
#[lang = "iterator"]
pub trait Iterator {
    type Item;
    fn next(self) -> Option<<Self as Iterator>::Item>;
}

/// Produces an iterator whose Item matches this collection or sequence.
#[lang = "iterable"]
pub trait Iterable {
    type Item;
    type Iter: Iterator<Item = <Self as Iterable>::Item>;
    fn iter(self) -> <Self as Iterable>::Iter;
}

#[lang = "partial_eq"]
pub trait PartialEq {
    fn eq(self, arg1: Self) -> bool;
}

#[lang = "eq"]
pub trait Eq: PartialEq {
}

#[lang = "hash"]
pub trait Hash {
    fn hash(self) -> i64;
}

#[lang = "partial_ord"]
pub trait PartialOrd: PartialEq {
    fn partial_cmp(self, arg1: Self) -> Option<Ordering>;
}

#[lang = "ord"]
pub trait Ord: Eq + PartialOrd {
    fn cmp(self, arg1: Self) -> Ordering;
}

#[lang = "add"]
pub trait Add<T0> {
    type Output;
    fn add(self, arg1: T0) -> <Self as Add<T0>>::Output;
}

