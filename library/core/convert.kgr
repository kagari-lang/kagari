//! Define a conversion on the destination: `From` if every input is valid,
//! `TryFrom` if an input can be rejected. Core supplies the corresponding
//! receiver methods, `into` and `try_into`. Ordinary arguments, assignments
//! and returns do not implicitly call these conversions.

use core::result::Result;

/// Constructs `Self` from `S` without returning an error. Implement `from`
/// on the destination; the caller can then use either spelling:
///
/// ```kagari
/// use core::convert::{ From, Into };
///
/// struct Count {
///     val n: i32
/// }
///
/// impl From<i32> for Count {
///     fn from(value: i32) -> Self {
///         Count { n: value }
///     }
/// }
///
/// fn count(value: i32) -> Count {
///     value.into()
/// }
/// ```
///
/// `count(3).n` returns `3`, just as `Count::from(3).n` does.
#[lang = "from"]
pub trait From<S> {
    /// Builds the destination from `value`, without an error result.
    fn from(value: S) -> Self;
}

/// Use `S: Into<D>` on a function that accepts different inputs for the same
/// destination. In the `Count` example, the return type tells `value.into()`
/// which `From` implementation to call.
pub trait Into<D> {
    /// Returns the destination value. The blanket implementation calls `D`'s `from` once.
    fn into(self) -> D;
}

/// Checks the input before constructing `Self`. Choose an `Error` type that
/// tells the caller why the value was rejected:
///
/// ```kagari
/// use core::convert::{ TryFrom, TryInto };
///
/// use core::result::{ Result, Ok, Err };
///
/// struct Positive {
///     val n: i32
/// }
///
/// enum CountError {
///     NotPositive
/// }
///
/// impl TryFrom<i32> for Positive {
///     type Error = CountError;
///
///     fn try_from(value: i32) -> Result<Self, CountError> {
///         if value > 0 {
///             Ok(Positive { n: value })
///         } else {
///             Err(CountError::NotPositive)
///         }
///     }
/// }
/// ```
///
/// `Positive::try_from(3)` returns `Ok(Positive { n: 3 })`;
/// `Positive::try_from(0)` returns `Err(CountError::NotPositive)`.
pub trait TryFrom<S> {
    /// Describes why the source could not be converted.
    type Error;

    /// Returns `Ok` containing the destination, or `Err` containing `Self::Error`.
    fn try_from(value: S) -> Result<Self, Self::Error>;
}

/// The receiver form of `TryFrom`. In the `Positive` example,
/// `val r: Result<Positive, CountError> = 0.try_into();` returns the same
/// `Err(CountError::NotPositive)` as the direct call.
pub trait TryInto<D> {
    /// The destination's `TryFrom` error type when using the core implementation.
    type Error;

    /// Returns the converted destination or the conversion error.
    fn try_into(self) -> Result<D, Self::Error>;
}

impl<S, D: From<S>> Into<D> for S {
    fn into(self) -> D {
        <D as From<S>>::from(self)
    }
}

impl<S, D: TryFrom<S>> TryInto<D> for S {
    type Error = <D as TryFrom<S>>::Error;

    fn try_into(self) -> Result<D, <D as TryFrom<S>>::Error> {
        <D as TryFrom<S>>::try_from(self)
    }
}
