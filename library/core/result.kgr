//! Use `Result<T, E>` when a caller needs either a value or a reason for failure.
//! If there is no reason to report, `Option<T>` is enough.

use core::convert::{ From, Infallible };

use core::ops::{ ControlFlow, FromResidual, Try };

/// A success (`Ok`) or an error (`Err`). Returning `Err` does not trap: the
/// caller can match on the result and decide how to recover.
///
/// ```kagari
/// use alloc::string::String;
///
/// use core::result::{ Result, Ok, Err };
///
/// fn answer(found: bool) -> Result<i32, String> {
///     if found {
///         Ok(42)
///     } else {
///         Err("missing answer")
///     }
/// }
///
/// fn handled(found: bool) -> i32 {
///     match answer(found) {
///         Ok(n) => n,
///         Err(_) => 0
///     }
/// }
/// ```
///
/// `handled(true)` returns `42`. On `false`, `answer` returns `Err("missing answer")`;
/// `handled` chooses `0` instead. To pass the error on, use `answer(found)?` in a
/// `Result`-returning function: it yields `42` on success and returns early on failure.
pub enum Result<T, E> {
    /// Contains the successful value of type `T`.
    Ok(T),

    /// Contains an error of type `E`. Constructing `Err(e)` captures the current
    /// source location and stack on the result, not on the payload `e`.
    Err(E),
}

pub use self::Result::{ Ok, Err };

/// When `?` propagates into a different error type `F`, it calls `F`'s direct
/// `From<E>` conversion once and preserves the original `Err` location and stack.
/// Matching `Err(e)` and constructing a new `Err(e)` would record a new origin.
impl<T, E, F: From<E>> FromResidual<Result<Infallible, E>> for Result<T, F> {
    fn from_residual(residual: Result<Infallible, E>) -> Self {
        match residual {
            Ok(never) => match never {},
            Err(error) => {
                val converted: Result<T, F> = Err(<F as From<E>>::from(error));
                __forward_err_origin(residual, converted)
            }
        }
    }
}

/// `?` continues with the `Ok` payload without running an error conversion.
/// It propagates `Err` values, not runtime traps.
impl<T, E> Try for Result<T, E> {
    type Output = T;
    type Residual = Result<Infallible, E>;

    fn from_output(output: T) -> Self {
        Ok(output)
    }

    fn branch(self) -> ControlFlow<Self::Residual, T> {
        match self {
            Ok(value) => ControlFlow::Continue(value),
            Err(error) => {
                val residual: Result<Infallible, E> = Err(error);
                ControlFlow::Break(__forward_err_origin(self, residual))
            }
        }
    }
}
