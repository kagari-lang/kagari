struct Point {
    val n: i32
}

fn read() -> i32 {
    var (changed, stable) = (1, 2);
    val read = || changed;
    changed = 3;
    val (_, unused) = (4, 5);
    val base = Point { n: 1 };
    val copy = || Point { ..base };
    read() + stable + copy().n
}

fn capture_pair() -> i32 {
    var (left, right) = (1, 2);
    val bump = || {
        left += right;
        left
    };
    right = 3;
    bump()
}

fn read_only() -> i32 {
    val (readonly, _) = (1, 2);
    readonly
}
