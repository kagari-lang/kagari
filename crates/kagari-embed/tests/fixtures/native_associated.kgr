use game::associated::{Source, echo, forward};
use game::typed_associated::{TypedSource, Transform};
fn read<S: Source>(source: S) -> S::Item { source.head() }
fn dynamic_main() -> i32 {
    val source: Source<Item = ArrayList<i32>> = [[42]];
    source.head()[0usize]
}
fn dynamic_boxed() -> Source<Item = ArrayList<i32>> { [[42]] }
fn dynamic_empty() -> i32 {
    val empty: ArrayList<i32> = [];
    val source: Source<Item = i32> = empty;
    source.head()
}
struct ScriptSource { val values: ArrayList<i32> }
impl Source for ScriptSource {
    type Item = ArrayList<i32>;
    fn head(self) -> ArrayList<i32> { self.values }
}
fn callback_native_main() -> i32 { forward([[42]])[0usize] }
fn callback_script_main() -> i32 { forward(ScriptSource { values: [42] })[0usize] }
fn callback_native_empty() -> i32 {
    val empty: ArrayList<ArrayList<i32>> = [];
    forward(empty)[0usize]
}
fn main() -> i32 {
    val bag = [[21]];
    val first = read(bag);
    val copy = echo::<ArrayList<ArrayList<i32>>>(first, bag);
    copy[0usize] + read(bag)[0usize]
}

fn typed_read<S: TypedSource>(source: S) -> S::Item { source.head() }
fn typed_empty() -> i32 {
    val bag: ArrayList<i32> = [];
    typed_read(bag)
}
fn typed_main() -> i32 {
    val bag = [[42]];
    val item = typed_read(bag);
    val other = bag.keep(bag);
    match bag.swap(item, 0) {
        (offset, item) => match bag.round_trip(Some((item,))) {
            Some((value,)) => typed_read(other)[0usize] + value[0usize] - 42 + offset,
            None => 0,
        },
    }
}
