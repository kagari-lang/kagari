fn tan_value() -> f64 { math::tan(0.0) }

fn forward<T: OrderedNumber>(a: T, b: T) -> T { numbers::smaller(math::min(a, b), b) }
fn signed_forward<T: SignedNumber>(a: T) -> T { numbers::magnitude(math::abs(a)) }
fn forwarded() -> (i32, i32) { (forward(7, 3), signed_forward(-4)) }

fn ordered_arguments() -> i32 {
    math::clamp(numbers::record(4), numbers::record(1), numbers::record(3))
}
fn reversed_arguments() -> i32 {
    math::clamp(numbers::record(1), numbers::record(3), numbers::record(2))
}
