fn f32_min() -> f32 { math::min(0.0, 0.0) }
fn f32_max() -> f32 { math::max(0.0, 0.0) }
fn f32_clamp() -> f32 { math::clamp(0.0, 0.0, 0.0) }
fn f32_application() -> f32 { numbers::smaller(0.0, 0.0) }
