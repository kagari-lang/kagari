use std::math;
use game::numbers;

fn i8_min() -> i8 { math::min(0i8, 0i8) }
fn i8_max() -> i8 { math::max(0i8, 0i8) }
fn i8_clamp() -> i8 { math::clamp(0i8, 0i8, 0i8) }
fn i8_application() -> i8 { numbers::smaller(0i8, 0i8) }
fn i8_abs() -> i8 { math::abs(0i8) }
fn i8_magnitude() -> i8 { numbers::magnitude(0i8) }
