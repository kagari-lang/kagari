fn main() -> i32 { 42 }

fn required_methods() -> i32 {
    val values = [20, 22];
    change(values);
    val copied=ArrayList<i32>::from_iter(values);
    val total=i32::sum(copied);
    val parsed=i32::from_str("42");
    val narrow:Result<i8,TryFromIntError> = total.try_into();
    match parsed {Ok(n)=>match narrow {Ok(k)=>if i32::from(k)==n {n}else{0},Err(_)=>0},Err(_)=>0}
}

fn change<C: MutableList<i32>>(values: C) {
    values.set(0usize, 19);
    values.insert(1usize, 1);
    values.remove(2usize);
    values.push(22);
    values.set(0usize, 20);
    values.remove(1usize);
}


use std::collections::map;
use external::fixture::hold;

fn library_and_object() -> i32 {
    val values = [20, 1, 19]; values.sort();
    values.sort_by(|a, b| b.cmp(a));
    val offset = [2];
    val handler = hold(values, |items| { items[0] += offset[0]; items });
    val shared = handler.apply();
    var sum = 0;
    for item in map(shared, |value| value) { sum += item; }
    sum
}
