use game::selected::{Echo, invoke, invoke_both};
use game::external_selected::{external_echo, external_scalar};
impl Echo for i32 {
    type Output = Vec<i32>;
    fn echo(self) -> Vec<i32> { [self] }
    fn offset(self, by: i32) -> Vec<i32> { [self + by] }
}
fn script_main() -> i32 { invoke(42)[0usize] }
fn native_main() -> i32 { invoke([[42]])[0usize] }
fn method_main() -> i32 { [[[42]]].invoke_first()[0usize] }
fn both_script_main() -> i32 { invoke_both(41)[0usize] }
fn both_native_main() -> i32 { invoke_both([[42]])[0usize] }
fn external_script_main() -> i32 { external_echo(42)[0usize] }
fn external_native_main() -> i32 { external_echo([[42]])[0usize] }
fn external_method_main() -> i32 { [[[42]]].external_first()[0usize] }
fn external_impl_main() -> i32 { external_scalar(true) }
fn external_dynamic_main() -> i32 {
    val echo: Echo<Output = i32> = true;
    echo.echo()
}
use std::array::Vec;
