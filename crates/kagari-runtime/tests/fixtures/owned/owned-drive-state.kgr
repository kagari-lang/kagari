use test::drive::step;

struct State {
    var sum: i32,
    var kept: [i32]
}

fn helper(n: i32) -> i32 {
    n + 1
}

fn main() -> [i32] {
    val state = State { sum: 0, kept: [1, 2, 3] };
    var index = 0;
    while index < 3 {
        state.sum += helper(state.kept[index]);
        step("step");
        index += 1;
    }
    state.kept = [state.sum, state.kept[0]];
    state.kept
}

pub fn spin() {
    while true {}
}

pub fn recurse() -> i32 {
    recurse() + 1
}

pub fn ping() -> i32 {
    7
}
