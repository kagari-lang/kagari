mod dependency {
    pub fn value() -> i32 {
        3
    }
}

trait Forward<S> {
    fn forward(value: S) -> Self;
}

impl Forward<i32> for i32 {
    fn forward(value: i32) -> Self {
        value + 4
    }
}

fn shared<T>(value: T, delta: i32) -> i32 {
    delta + 2
}

fn recursive(n: i32) -> i32 {
    example::steps::step();
    if n == 0 {
        2
    } else {
        20 + recursive(n - 1)
    }
}

pub fn run(seed: [i32]) -> i32 {
    val kept = seed[0] + 1000;
    val result = recursive(2);
    kept + result + <i32 as Forward<i32>>::forward(0) + dependency::value() + shared(0, 4)
}

fn main() {}
