trait Read {
    fn read(self) -> i32;
}

impl Read for i32 {
    fn read(self) -> i32 {
        self
    }
}

trait Forward {
    fn forward<T: Read>(self, value: T) -> i32 {
        value.read()
    }
}

impl Forward for i32 {}

fn main() -> i32 {
    val receiver: Forward = 0;
    receiver.forward(7)
}
