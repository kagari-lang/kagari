trait Read {
    fn read(self) -> i32;
}

impl Read for i32 {
    fn read(self) -> i32 {
        self + 10
    }
}

trait Forward {
    fn forward<T: Read>(self, value: T) -> Read;
}

impl Forward for i64 {
    fn forward<T: Read>(self, value: T) -> Read {
        value
    }
}

impl Forward for i32 {
    fn forward<T: Read>(self, value: T) -> Read {
        value
    }
}

fn main() -> i32 {
    val receiver: Forward = 0;
    receiver.forward(7).read()
}

fn other() -> Forward {
    2i64
}
