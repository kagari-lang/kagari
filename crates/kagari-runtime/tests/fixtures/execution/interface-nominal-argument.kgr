struct A {
    val n: i32
}

struct B {
    val n: i32
}

trait Tag {
    fn read(self, x: A) -> i32;
}

impl Tag for i32 {
    fn read(self, x: A) -> i32 {
        x.n
    }
}

fn run<T: Tag>(x: T, a: A) -> i32 {
    x.read(a)
}

fn main() -> i32 {
    run(7, A { n: 1 })
}

pub fn make_a() -> A {
    A { n: 5 }
}

pub fn make_b() -> B {
    B { n: 9 }
}
