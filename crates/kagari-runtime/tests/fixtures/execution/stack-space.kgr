pub fn empty() {
    empty_again();
}

fn empty_again() {
    empty();
}

fn wide(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    val nested = wide(b, c, d, e, f, g, h, a);
    nested + a + b + c + d + e + f + g + h
}

pub fn larger() -> i64 {
    wide(1, 2, 3, 4, 5, 6, 7, 8)
}

pub fn healthy() -> i32 {
    9
}
