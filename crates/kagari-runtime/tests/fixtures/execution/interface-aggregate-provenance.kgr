struct Item {
    val value: i32
}

struct Box<T> {
    var item: T
}

enum Wrapped<T> {
    Some(T),
    None
}

fn keep<T>(value: T) -> T {
    value
}

trait Capture {
    fn capture<T>(self, value: T) -> fn() -> i32 {
        val boxed: Box<Wrapped<T>> = Box { item: Wrapped::Some(value) };
        boxed.item = Wrapped::Some(value);
        || {
            val held: Box<Wrapped<T>> = keep(boxed);
            match held.item {
                Wrapped::Some(inner) => {
                    val again: T = keep(inner);
                    helper()
                },
                Wrapped::None => 0
            }
        }
    }
}

impl Capture for i32 {}

fn helper() -> i32 {
    42
}

fn make(source: Capture) -> fn() -> i32 {
    source.capture(Item { value: 1 })
}

fn use_closure(call: fn() -> i32) -> i32 {
    call()
}
