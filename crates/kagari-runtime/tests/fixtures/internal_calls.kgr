use example::internal;

fn identity(value: i32) -> i32 {
    value
}

pub fn script(count: i32) -> i32 {
    var i = count;
    var sum = 0;
    loop {
        match i {
            0 => {
                break;
            },
            _ => {}
        };
        sum += identity(7);
        i -= 1;
    }
    sum
}

pub fn raw_empty(count: i32) -> i32 {
    var i = count;
    loop {
        match i {
            0 => {
                break;
            },
            _ => {}
        };
        internal::raw_empty();
        i -= 1;
    }
    0
}

