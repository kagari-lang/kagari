// Measurement reference only: stable O(n log n) sorting over the same compact
// ArrayList<i32>. Production algorithms remain Rust implementations.
trait Run {
    fn primitive(self, values: ArrayList<i32>, calls: ArrayList<usize>);
    fn callback(self, values: ArrayList<i32>, calls: ArrayList<usize>);
    fn interface_primitive(self, values: MutableList<i32>, calls: ArrayList<usize>);
    fn interface_callback(self, values: MutableList<i32>, calls: ArrayList<usize>);
    fn script(self, values: ArrayList<i32>, calls: ArrayList<usize>);
    fn view(self, values: ArrayList<i32>) -> MutableList<i32>;
}
struct Runner {}
impl Run for Runner {
    fn primitive(self, values: ArrayList<i32>, calls: ArrayList<usize>) { values.sort(); }
    fn callback(self, values: ArrayList<i32>, calls: ArrayList<usize>) {
        values.sort_by(|a,b| { calls[0] += 1usize; a.cmp(b) });
    }
    fn interface_primitive(self, values: MutableList<i32>, calls: ArrayList<usize>) {
        values.sort();
    }
    fn interface_callback(self, values: MutableList<i32>, calls: ArrayList<usize>) {
        values.sort_by(|a,b| { calls[0] += 1usize; a.cmp(b) });
    }
    fn script(self, values: ArrayList<i32>, calls: ArrayList<usize>) {
        merge_sort(values, |a,b| { calls[0] += 1usize; a.cmp(b) });
    }
    fn view(self, values: ArrayList<i32>) -> MutableList<i32> { values }
}
fn runner() -> Run { Runner {} }
fn merge_sort(values: ArrayList<i32>, compare: fn(i32,i32) -> Ordering) {
    val size = values.len();
    var source: ArrayList<i32> = []; var target: ArrayList<i32> = [];
    var index = 0usize;
    while index < size { source.push(values[index]); target.push(0); index += 1usize; }
    var width = 1usize;
    while width < size {
        var start = 0usize;
        while start < size {
            val middle = if start + width < size { start + width } else { size };
            val end = if middle + width < size { middle + width } else { size };
            var left = start; var right = middle; var output = start;
            while left < middle && right < end {
                if compare(source[left], source[right]) != Ordering::Greater {
                    target[output] = source[left]; left += 1usize;
                } else { target[output] = source[right]; right += 1usize; }
                output += 1usize;
            }
            while left < middle { target[output] = source[left]; left += 1usize; output += 1usize; }
            while right < end { target[output] = source[right]; right += 1usize; output += 1usize; }
            start = end;
        }
        val swap = source; source = target; target = swap; width *= 2usize;
    }
    index = 0usize;
    while index < size { values[index] = source[index]; index += 1usize; }
}
