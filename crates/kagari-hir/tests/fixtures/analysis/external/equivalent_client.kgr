use support::Read;

fn inspect(counter: api::Counter) -> i32 {
    counter.value = 9;
    val child: support::Child = counter.child;
    child.number = 3;
    val made: api::Counter = api::Counter::new();
    val echoed: bool = made.echo(true);
    val read: i32 = counter.read();
    val defaulted: i32 = counter.defaulted();
    val kept: api::Counter = api::bounded(counter);
    support::identity(read)
}
