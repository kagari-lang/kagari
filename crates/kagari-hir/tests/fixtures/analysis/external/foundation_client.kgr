use core::char::CharTryFromError;

fn arithmetic(a: i32, b: i32) -> i32 {
    a + b * 2
}

fn iteration(values: Iterator<Item = i32>) -> i32 {
    val mapped = values.map(|value| value + 1);
    var result = 0;
    for value in mapped {
        result += value;
    }
    result + values.sum() + values.product()
}

fn conversion(value: i32) -> i64 {
    value.into()
}

fn checked<S, D: TryFrom<S, Error = E>, E>(value: S) -> Result<D, E> {
    value.try_into()
}

fn character(value: u32) -> Result<char, CharTryFromError> {
    checked(value)
}
