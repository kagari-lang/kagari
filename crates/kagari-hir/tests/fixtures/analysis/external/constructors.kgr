pub use alloc::string::String;

pub use core::ops::Range;

pub native type Target;

impl Target {
    pub native fn shared(self) -> i32;
    pub native fn mutable(self) -> i32;
    pub native fn plain(self) -> i32;
}

pub native fn text(value: String) -> String;

pub native fn range(value: Range<i32>) -> Range<i32>;
