trait Factory {
    fn make() -> Self;
}

struct Player {}

impl Factory for Player {
    fn make() -> Self {
        Player {}
    }
}

struct Pair<T> {
    val value: T,
    val flag: bool
}

impl<T: Factory> Factory for Pair<T> {
    fn make() -> Self {
        Pair { value: T::make(), flag: false }
    }
}

fn take(value: Pair<Player>) {}
