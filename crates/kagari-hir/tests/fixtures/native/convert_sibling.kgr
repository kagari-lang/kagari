use core::result::Result;

use game::api::Convert;

impl Convert<bool> for i32 {
    type Error = i64;

    fn convert(value: bool) -> Result<Self, i64> {
        if value {
            Result::Ok(1)
        } else {
            Result::Err(0i64)
        }
    }
}

fn convert_flag(value: bool) -> Result<i32, i64> {
    i32::convert(value)
}
