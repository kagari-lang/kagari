pub trait Marker {}

pub struct Good {}

impl Marker for Good {}

pub struct Box<T> {
    pub val value: T,
}

pub struct Bounded<T: Marker> {
    pub val value: T,
}

pub native type Native<T>;

pub trait Read {
    type Item;
    fn read(self) -> i32;
    fn bounded<U: Marker>(self, value: U) -> U;
}

impl<T> Read for Box<T> {
    type Item = Good;
    fn read(self) -> i32 {
        1
    }
    fn bounded<U: Marker>(self, value: U) -> U {
        value
    }
}

impl<T> Read for Native<T> {
    type Item = Good;
    native fn read(self) -> i32;
    native fn bounded<U: Marker>(self, value: U) -> U;
}

pub trait Family<K: Marker> {
    type Output<T: Marker>;
    fn read(self) -> i32;
}

pub trait Other {
    fn op(self) -> i32;
}

pub trait NativeRead<T: Marker> {
    fn read(self) -> i32;
    native fn defaulted(self) -> i32;
    native fn produce(self) -> Other;
}

pub trait DerivedRead<T: Marker>: NativeRead<T> + Other {
    native fn defaulted(self) -> i32;
    native fn produce(self) -> Other;
}

pub trait Producer<K: Marker> {
    type Value<T: Marker>: Read<Item = (K, T)>;
    type Unbounded<T: Marker>;
    type Wrong<T: Marker>: Read<Item = bool>;
}

pub native fn projected<T: Producer<Good>>();

pub native fn check<T: Marker + Family<Good>>();

pub native fn produce<T: Marker>() -> Read<Item = Good>;

pub native fn plain(value: i32) -> i32;

pub native fn scalar<T>(value: i32) -> i32;

impl<T> Native<T> {
    pub native fn scalar(value: i32) -> i32;
}
