use std::collections::List;

fn pack<A, B>(first: A, second: B) -> List<[B]> {
    Vec::from([[second]])
}

trait Builder {
    fn build<A, B>(self, first: A, second: B) -> List<[B]> {
        pack(first, second)
    }
}

struct Factory {}

impl Builder for Factory {}

fn main() -> Builder {
    Factory {}
}
