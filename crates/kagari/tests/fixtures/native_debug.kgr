use std::debug;
use std::string::String;
use std::option::{Option, Some};
use game::diagnostics;

fn assertion() { debug::assert(true, "message"); }
fn stop() -> ! { debug::panic("stop"); }
fn coerced() -> u64 { debug::panic("coerced") }
fn logging() { debug::print("é😀"); }
fn relay() -> String { diagnostics::echo("echo") }
fn app_stop() -> ! { diagnostics::fatal() }
fn sequence() -> u64 {
    debug::print("first");
    debug::assert(false, "failed");
    debug::print("unreachable");
    42u64
}
fn unreachable_log() -> u64 {
    debug::print("before");
    debug::panic("stop");
    debug::print("after");
    42u64
}
fn nested() -> u64 { coerced() }
fn answer() -> Option<u64> { Some(42u64) }
fn eager() {
    debug::assert({ debug::print("condition"); false }, { debug::print("message"); "eager" });
}
