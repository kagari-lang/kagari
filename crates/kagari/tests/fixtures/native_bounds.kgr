use game::bounds::{echo, Container, Marker};
use std::array::Vec;
struct Token { val values: Vec<i32> }
impl Container<usize> for Token {}
impl Marker for Token {}
fn main() -> i32 {
    val value = echo(Token { values: Vec::from([21, 21]) }, 0usize);
    value.values[0usize] + value.values[1usize]
}
