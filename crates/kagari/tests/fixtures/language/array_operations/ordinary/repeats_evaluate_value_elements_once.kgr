struct Cell {
    var value: i32
}

fn item(log: Vec<i32>) -> i32 {
    log.push(1);
    7
}

fn count(log: Vec<i32>) -> u64 {
    log.push(2);
    3
}

fn main() -> i32 {
    val log = Vec::new();
    val values = [item(log); count(log)];
    if !(log.len() == 2u64 && log[0] == 1 && log[1] == 2) {
        return 0;
    }
    values[0] = 42;
    if values[2] != 7 {
        return 0;
    }
    val empty = [item(log); 0];
    if !(empty.is_empty() && log.len() == 3u64) {
        return 0;
    }
    val inferred: [u8] = [1; 4];
    if inferred[3] != 1u8 {
        return 0;
    }
    42
}
