use std::hash::Hash;

use std::collections::list_content_equal;

fn same<T: PartialEq>(a: T, b: T) -> bool {
    a == b
}

fn hashed<T: Hash>(value: T) -> i64 {
    val boxed: Hash = value;
    boxed.hash()
}

struct Item {
    val value: i32
}

impl PartialEq for Item {
    fn eq(self, other: Self) -> bool {
        true
    }
}

impl Eq for Item {}

impl Hash for Item {
    fn hash(self) -> i64 {
        7i64
    }
}

trait Compare {
    fn compare<T: PartialEq>(self, a: T, b: T) -> bool {
        (a, 7, a) == (b, 7, b) && !((a, 7) != (b, 7)) && same((a, (7, a)), (b, (7, b))) &&
            same(Vec::from([(a, 7)]), Vec::from([(b, 7)])) &&
            list_content_equal(Vec::from([(a, 7)]), Vec::from([(b, 7)]))
    }
    fn hashes<T: Eq + Hash>(self, a: T, b: T) -> bool {
        (a, 7).hash() == (b, 7).hash() && hashed((a, (7, a))) == hashed((b, (7, b))) &&
            hashed(Vec::from([(a, 7)])) == hashed(Vec::from([(b, 7)]))
    }
}

struct Source {}

impl Compare for Source {}

fn main() -> i32 {
    val source: Compare = Source {};
    val left = Item { value: 1 };
    val right = Item { value: 2 };
    if source.compare(left, right) && !source.compare(1, 2) && source.compare("same", "same") &&
        source.hashes(left, right) &&
        source.hashes(3, 3) &&
        source.hashes("same", "same") {
        42
    } else {
        0
    }
}
