use std::fmt::{ Debug, Display };

struct Item {
    val value: i32
}

impl Debug for Item {
    fn debug(self) -> String {
        "custom debug"
    }
}

impl Display for Item {
    fn display(self) -> String {
        self.value.display()
    }
}

fn format<T: Debug>(a: T) -> String {
    a.debug()
}

fn show<T: Display>(a: T) -> String {
    a.display()
}

fn main() -> i32 {
    val item = Item { value: 42 };
    if format(item) == "custom debug" && show(item) == "42" {
        42
    } else {
        0
    }
}
