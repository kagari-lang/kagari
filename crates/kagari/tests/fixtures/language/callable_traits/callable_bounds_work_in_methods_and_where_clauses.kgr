use core::ops::Fn as Callable;

struct Run {}

impl Run {
    fn apply<T, R, F: Callable (T) -> R>(self, x: T, f: F) -> R {
        f(x)
    }
}

trait Invoke {
    fn invoke<T, R, F: Fn (T) -> R>(self, x: T, f: F) -> R {
        f(x)
    }
}

struct Runner {}

impl Invoke for Runner {}

fn apply<F>(f: F) -> i32 where F: Callable (i32,) -> i32 {
    f(21)
}

fn main() -> i32 {
    {
        val passed = Run {}.apply(21, |x| x * 2) == 42;
        if !passed {
            return 0;
        }
    };
    {
        val passed = Runner {}.invoke(21, |x| x * 2) == 42;
        if !passed {
            return 0;
        }
    };
    apply(|x| x * 2)
}
