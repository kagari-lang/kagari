fn main() -> bool {
    val text = "\0e\u{301}";
    val chars = text.chars();
    val indices = text.char_indices();
    val bytes = text.bytes();
    val empty_chars = "".chars();
    val empty_indices = "".char_indices();
    val empty_bytes = "".bytes();
    chars.next() == Some('\0') && chars.next() == Some('e') && chars.next() == Some('\u{301}') &&
        chars.next() == None &&
        indices.next() == Some((0u64, '\0')) &&
        indices.next() == Some((1u64, 'e')) &&
        indices.next() == Some((2u64, '\u{301}')) &&
        indices.next() == None &&
        bytes.next() == Some(0u8) &&
        bytes.next() == Some(101u8) &&
        bytes.next() == Some(204u8) &&
        bytes.next() == Some(129u8) &&
        bytes.next() == None &&
        text.len() == 4u64 &&
        empty_chars.next() == None &&
        empty_chars.next() == None &&
        empty_indices.next() == None &&
        empty_indices.next() == None &&
        empty_bytes.next() == None &&
        empty_bytes.next() == None
}
