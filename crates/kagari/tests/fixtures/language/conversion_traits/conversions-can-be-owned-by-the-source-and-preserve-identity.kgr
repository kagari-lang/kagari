struct Count {
    val value: i32
}

impl From<Count> for i32 {
    fn from(value: Count) -> i32 {
        value.value
    }
}

fn identity(value: Count) -> Result<i32, Count> {
    val x: Result<i32, Count> = Err(value);
    Ok(x?)
}

fn convert(value: Count) -> Result<i32, i32> {
    val x: Result<i32, Count> = Err(value);
    Ok(x?)
}

fn main() -> i32 {
    val a = Count { value: 42 };
    match identity(a) {
        Err(b) => if a === b {
            match convert(b) {
                Err(n) => n,
                Ok(_) => 0
            }
        } else {
            0
        },
        Ok(_) => 0
    }
}
