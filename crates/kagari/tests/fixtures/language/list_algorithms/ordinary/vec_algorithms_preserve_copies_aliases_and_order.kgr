fn main() -> bool {
    val a = Vec::from([3, 1, 2, 1]);
    val b = a.sorted();
    if a[0] != 3 || b[0] != 1 || b[3] != 3 {
        return false;
    }
    val alias = a;
    a.sort();
    if alias[0] != 1 || alias[3] != 3 {
        return false;
    }
    a.dedup();
    if a.len() != 3u64 {
        return false;
    }
    a.reverse();
    a.retain(|x| x != 2);
    val c = Vec::from([1, 2, 1, 3, 2]).distinct();
    a.len() == 2u64 && a[0] == 3 && a[1] == 1 && c.len() == 3u64 && c[1] == 2
}
