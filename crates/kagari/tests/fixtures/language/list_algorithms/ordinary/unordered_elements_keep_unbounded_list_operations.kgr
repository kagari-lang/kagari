use std::collections::{ List };

struct Item {
    val key: i32
}

fn main() -> bool {
    val values = Vec::from([Item { key: 2 }, Item { key: 1 }]);
    val list: List<Item> = values;
    val sorted = list.sorted_by_key(|item| item.key);
    sorted[0].key == 1 && list.reversed()[0].key == 1 && values[0].key == 2
}
