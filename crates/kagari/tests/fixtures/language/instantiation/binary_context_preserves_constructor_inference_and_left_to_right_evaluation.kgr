enum Token<T> {
    Empty
}

impl<T> PartialEq for Token<T> {
    fn eq(self, other: Self) -> bool {
        true
    }
}

struct Count {
    var value: i32
}

fn left(count: Count) -> Token<i32> {
    count.value = count.value * 10 + 1;
    Token::Empty
}

fn right<T>(count: Count) -> Token<T> {
    count.value = count.value * 10 + 2;
    Token::Empty
}

fn main() -> i32 {
    val count = Count { value: 0 };
    if left(count) == right(count) && Token<i32>::Empty == Token::Empty {
        count.value + 30
    } else {
        0
    }
}
