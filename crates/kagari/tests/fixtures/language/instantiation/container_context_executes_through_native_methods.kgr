use std::collections::{ HashMap };

struct Marker<T> {
    val value: i32
}

fn main() -> i32 {
    val values: Vec<Marker<i32>> = Vec::from([]);
    values.push(Marker { value: 10 });
    values.push(Marker { value: 10 });
    val map: HashMap<i32, Marker<i32>> = HashMap::new();
    map.insert(1, Marker { value: 22 });
    values[0].value + values[1].value +
        (
        match map.get(1) {
            Some(v) => v.value,
            None => 0
        }
    )
}
