
        struct Marker<T> { val value: i32 }
        fn forward<T>() -> Marker<T> { Marker<T> { value: 20 } }
        fn main() -> i32 {
            val first = Marker<i32> { value: 20 };
            val second = Marker<bool> { value: 22 };
            val third: Marker<i32> = forward();
            first.value + second.value + third.value - 20
        }
    