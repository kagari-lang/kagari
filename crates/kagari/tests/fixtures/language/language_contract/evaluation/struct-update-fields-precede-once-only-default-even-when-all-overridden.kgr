struct P {
    val left: i32,
    val right: i32
}

impl Default for P {
    fn default() -> Self {
        print("default");
        P { left: 10, right: 20 }
    }
}

fn left() -> i32 {
    print("left");
    1
}

fn right() -> i32 {
    print("right");
    2
}

fn main() -> i32 {
    val base = P { ..Default::default() };
    val changed = P { right: right(), left: left(), ..P::default() };
    base.left + base.right + changed.left * 10 + changed.right
}
