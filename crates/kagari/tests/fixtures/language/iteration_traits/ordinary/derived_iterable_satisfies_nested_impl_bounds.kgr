struct Counter {
    var value: i32
}

impl Iterator for Counter {
    type Item = i32;
    fn next(self) -> Option<i32> {
        if self.value > 0 {
            val n = self.value;
            self.value = 0;
            Some(n)
        } else {
            None
        }
    }
}

trait Sum {
    fn sum(self) -> i32;
}

struct Wrap<T> {
    val inner: T
}

impl<T: Iterable<Item = i32>> Sum for Wrap<T> {
    fn sum(self) -> i32 {
        var total = 0;
        for x in self.inner {
            total += x;
        }
        total
    }
}

fn main() -> i32 {
    Wrap { inner: Counter { value: 42 } }.sum()
}
