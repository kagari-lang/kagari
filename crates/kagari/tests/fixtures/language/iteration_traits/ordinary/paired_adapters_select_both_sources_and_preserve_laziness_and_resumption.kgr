use std::collections::List;

struct Source {
    val log: Vec<i32>,
    val id: i32
}

struct Cursor {
    val log: Vec<i32>,
    val id: i32,
    var step: i32
}

fn make(log: Vec<i32>, id: i32) -> Source {
    log.push(id);
    Source { log, id }
}

impl Iterable for Source {
    type Item = i32;
    type Iter = Cursor;
    fn iter(self) -> Cursor {
        self.log.push(self.id + 10);
        Cursor { log: self.log, id: self.id, step: 0 }
    }
}

impl Iterator for Cursor {
    type Item = i32;
    fn next(self) -> Option<i32> {
        self.step += 1;
        self.log.push(self.id + 20);
        if self.step == 1 || self.step == 3 {
            Some(self.step)
        } else {
            None
        }
    }
}

fn pairs<L: Iterable<Item = i32>, R: Iterable>(left: L, right: R) -> u64 {
    left.zip(right).enumerate().count()
}

fn main() -> i32 {
    val log = Vec::new();
    val zipped = make(log, 1).zip(make(log, 2));
    if log.len() != 4u64 || log[0] != 1 || log[1] != 2 || log[2] != 11 || log[3] != 12 {
        return 0;
    }
    val alias = zipped;
    match alias.next() {
        Some(pair) => {
            if pair[0] != 1 || pair[1] != 1 {
                return 0;
            }
        },
        None => {
            return 0;
        }
    };
    if log[4] != 21 || log[5] != 22 {
        return 0;
    }
    if zipped.next() != None || log.len() != 7u64 {
        return 0;
    }
    if alias.next() != None || log.len() != 9u64 {
        return 0;
    }
    val pulse = Cursor { log: Vec::new(), id: 0, step: 0 };
    val mapped = pulse.filter_map(
        |x| if x == 3 {
            Some(Vec::from([42]))
        } else {
            None
        }
    );
    if mapped.next() != None {
        return 0;
    }
    match mapped.next() {
        Some(value) => {
            if value[0] != 42 {
                return 0;
            }
        },
        None => {
            return 0;
        }
    };
    val first = Cursor { log: Vec::new(), id: 0, step: 0 };
    val last = Cursor { log: Vec::new(), id: 0, step: 0 };
    val chained = first.chain(last);
    if chained.next() != Some(1) || chained.next() != Some(1) || chained.next() != None ||
        chained.next() != Some(3) ||
        first.step != 2 {
        return 0;
    }
    val skipped = Cursor { log: Vec::new(), id: 0, step: 0 }.skip(2u64);
    if skipped.next() != None || skipped.next() != None {
        return 0;
    }
    val counted: Iterable<Item = i32, Iter = Cursor> = Source { log: Vec::new(), id: 0 };
    val erased: Iterator<Item = String> = ["a", "b"].iter();
    if pairs(counted, erased) != 1u64 {
        return 0;
    }
    val list: List<i32> = Vec::from([10, 20]);
    val output: Vec<(u64, (i32, String))> = list.zip(["a", "b"]).enumerate().collect();
    if output[0][0] != 0u64 || output[1][0] != 1u64 || output[1][1][0] != 20 ||
        output[1][1][1] != "b" {
        return 0;
    }
    42
}
