fn main() -> i32 {
    val left = Vec::from([1, 2, 3]);
    val right = Vec::from([10, 20, 30]);
    val calls = Vec::from([0]);
    val pipeline: Iterator<Item = (i32, i32)> = left.map(|x| x).zip(right.filter(|x| true));
    if !pipeline.any(
        |pair| {
            calls[0] += 1;
            pair[0] == 2
        }
    ) ||
        calls[0] != 2 {
        return 0;
    }
    match pipeline.find(|pair| true) {
        Some(pair) => {
            if pair[0] != 3 || pair[1] != 30 {
                return 0;
            }
        },
        None => {
            return 0;
        }
    };
    left.push(4);
    right.push(40);
    val values = Vec::from([1, 2, 3, 4]);
    val cursor = values.skip(1u64);
    val alias = cursor;
    if cursor.all(
        |x| {
            calls[0] += 1;
            x < 3
        }
    ) ||
        calls[0] != 4 {
        return 0;
    }
    if alias.next() != Some(4) {
        return 0;
    }
    for item in alias {
        break;
    }
    values.push(5);
    val empty: [i32] = [];
    if empty.any(|x| true) || !empty.all(|x| false) || empty.find(|x| true) != None ||
        empty.count() != 0u64 {
        return 0;
    }
    val output = Vec::new();
    val unit = values.enumerate().for_each(
        |pair| {
            output.push(pair[1]);
        }
    );
    if unit != () || output.len() != 5u64 || output[4] != 5 {
        return 0;
    }
    values.push(6);
    42
}
