fn option_queries() -> bool {
    val some = Some(Payload { value: 42 });
    val none: Option<Payload> = None;
    val effects = [0];
    val chosen = some.unwrap_or({ effects[0usize] = effects[0usize] + 1; Payload { value: 0 } });
    val fallback = none.unwrap_or({ effects[0usize] = effects[0usize] + 1; chosen });
    some.is_some() && !some.is_none() && none.is_none() && !none.is_some()
        && fallback.value == 42 && effects[0usize] == 2
}
fn result_queries() -> bool {
    val ok: Result<Payload, Payload> = Ok(Payload { value: 42 });
    val error: Result<Payload, Payload> = Err(Payload { value: 0 });
    val effects = [0];
    val chosen = ok.unwrap_or({ effects[0usize] = effects[0usize] + 1; Payload { value: 0 } });
    val fallback = error.unwrap_or({ effects[0usize] = effects[0usize] + 1; chosen });
    ok.is_ok() && !ok.is_err() && error.is_err() && !error.is_ok()
        && fallback.value == 42 && effects[0usize] == 2
}
fn error_queries() -> Result<i32, ParseError> {
    val error = i32::from_str("invalid");
    val ignored = error.is_err();
    val fallback = error.unwrap_or(42);
    error
}
fn option_alias() -> (Payload, Payload) {
    val payload = Payload { value: 42 };
    val value = Some(payload);
    (payload, value.unwrap_or(Payload { value: 0 }))
}
fn result_alias() -> (Payload, Payload) {
    val payload = Payload { value: 42 };
    val value: Result<Payload, i32> = Ok(payload);
    (payload, value.unwrap_or(Payload { value: 0 }))
}
