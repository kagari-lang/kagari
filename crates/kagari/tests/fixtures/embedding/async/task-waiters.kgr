use test::async_sdk::request;

pub fn producer() -> fn() -> Future<i32> {
    async || request(10).await
}

pub fn immediate() -> fn() -> Future<i32> {
    async || 99
}

pub fn observe(task: Task<i32>, extra: i32) -> fn() -> Future<i32> {
    async || {
        val result: i32 = task.await;
        result + extra
    }
}

pub async fn direct(task: Task<i32>) -> i32 {
    task.await
}

pub fn tasks() -> Vec<Task<i32>> {
    Vec::from([])
}

pub fn add(tasks: Vec<Task<i32>>, task: Task<i32>) {
    tasks.push(task);
}

pub fn looping(tasks: Vec<Task<i32>>) -> fn() -> Future<i32> {
    async || {
        var total = 0;
        for task in tasks {
            total += task.await;
        }
        total
    }
}

pub fn indexed(tasks: Vec<Task<i32>>, index: u64) -> fn() -> Future<i32> {
    async || tasks[index].await
}

pub fn business() -> fn() -> Future<Result<i32, i32>> {
    async || Err(4)
}

pub fn propagate(task: Task<Result<i32, i32>>) -> fn() -> Future<Result<i32, i32>> {
    async || Ok(task.await? + 1)
}

pub fn code(value: Result<i32, i32>) -> i32 {
    match value {
        Ok(x) => x,
        Err(e) => -e
    }
}

async fn empty<T>() -> Vec<T> {
    Vec::from([])
}

pub async fn infer_future() -> Vec<i32> {
    empty().await
}

pub fn nested() -> fn() -> Future<Future<i32>> {
    async || request(10)
}

pub fn nested_observer(task: Task<Future<i32>>) -> fn() -> Future<Future<i32>> {
    async || task.await
}
