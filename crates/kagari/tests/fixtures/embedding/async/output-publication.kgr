use test::converted_reply::read;

pub fn items() -> [i32] {
    [5]
}

pub fn write(items: [i32]) {
    items[0] = 9;
}

pub fn first(items: [i32]) -> i32 {
    items[0]
}

pub fn factory(items: [i32]) -> fn() -> Future<i32> {
    async || {
        val item = items[0];
        val (reply,) = read().await;
        items[0] = reply + item;
        items[0]
    }
}
