use std::collections::{ List, list_content_equal };

use alloc::vec::VecCursor;

use std::ops::Index;

struct Bag {
    val value: f32
}

impl Index<u64> for Bag {
    type Output = f32;
    fn index(self, index: u64) -> f32 {
        self.value
    }
}

impl Iterable for Bag {
    type Item = f32;
    type Iter = VecCursor<f32>;
    fn iter(self) -> VecCursor<f32> {
        Vec::from([self.value]).iter()
    }
}

impl List<f32> for Bag {
    fn len(self) -> u64 {
        1u64
    }
    fn is_empty(self) -> bool {
        false
    }
    fn get(self, index: u64) -> Option<f32> {
        Some(self.value)
    }
}

trait Probe {
    fn same(self, a: List<f32>, b: List<f32>) -> bool;
}

struct Checker {}

impl Probe for Checker {
    fn same(self, a: List<f32>, b: List<f32>) -> bool {
        list_content_equal(a, b)
    }
}

pub fn make() -> List<f32> {
    Bag { value: 42.0f32 }
}

pub fn probe() -> Probe {
    Checker {}
}
