use demo::rpc;

use demo::database;

struct Requests {
    val ids: [i32],
    var position: u64
}

fn requests() -> Requests {
    Requests { ids: [1, 2], position: 0u64 }
}

impl Iterator for Requests {
    type Item = i32;
    fn next(self) -> Option<i32> {
        if self.position >= self.ids.len() {
            None
        } else {
            val id = self.ids[self.position];
            self.position += 1u64;
            Some(id)
        }
    }
}

pub struct Job {
    pub var total: i32
}

pub fn job() -> Job {
    Job { total: 0 }
}
// Admission returns before the factory constructs its cold async block. The scope owns the Task
// even though this handler does not retain its handle.
pub fn handle(scope: TaskScope, job: Job) -> bool {
    match scope.spawn(
        || async {
            var total = 0;
            for id in requests() {
                val profile = rpc::request(id).await;
                total += database::request(profile).await;
            }
            job.total = total;
            total
        }
    ) {
        Ok(_) => true,
        Err(_) => false,
    }
}

pub fn ping() -> i32 {
    42
}
