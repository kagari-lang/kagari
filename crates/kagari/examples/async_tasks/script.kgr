use demo::rpc;
use demo::database;

// Admission returns before the factory constructs its cold async block. The scope owns the Task
// even though this handler does not retain its handle.
pub fn handle(scope: TaskScope) -> bool {
    match scope.spawn(|| async {
        var total = 0;
        for id in [1, 2] {
            val profile = rpc::request(id).await;
            total += database::request(profile).await;
        }
        total
    }) {
        Ok(_) => true,
        Err(_) => false,
    }
}

pub fn ping() -> i32 { 42 }
