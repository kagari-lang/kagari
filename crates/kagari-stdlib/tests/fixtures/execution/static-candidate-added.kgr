static var count: i32 = 0;

static val cold: i32 = 7;

pub fn tick() -> i32 {
    count += 1;
    count
}

pub fn indirect_write() -> i32 {
    val action: fn() -> i32 = || {
        count += 1;
        count
    };
    action()
}

pub fn indirect_read() -> i32 {
    val action: fn() -> i32 = || cold;
    action()
}

static val added: i32 = 9;

pub fn indirect_added() -> i32 {
    val action: fn() -> i32 = || added;
    action()
}
