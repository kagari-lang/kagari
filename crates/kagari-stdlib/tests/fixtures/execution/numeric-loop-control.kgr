fn scan(n: i32) -> i32 {
    var i = 0;
    var sum = 0;
    while i < n {
        i += 1;
        if i == 2 {
            continue;
        }
        if i == 5 {
            break;
        }
        sum += i;
    }
    i * 100 + sum
}

pub fn guards() -> bool {
    scan(-1) == 0 && scan(0) == 0 && scan(1) == 101 && scan(4) == 408 && scan(8) == 508
}

fn effects(n: i32) -> i32 {
    var checks = 0;
    var steps = 0;
    while {
        checks += 1;
        steps < n
    } {
        steps += 1;
    }
    checks * 10 + steps
}

pub fn effectful() -> bool {
    effects(0) == 10 && effects(3) == 43
}

pub fn nested() -> bool {
    var i = 0;
    var total = 0;
    while i < 2 {
        var j = 0;
        while j < 3 {
            total += 1;
            j += 1;
        }
        i += 1;
    }
    total == 6
}
