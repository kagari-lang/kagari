fn main() -> i32 {
    val values = Vec::from([10, 20, 30]);
    val mapped = values.map(|item| item + 1);
    var first = 0;
    for item in mapped {
        first = item;
        break;
    }
    val second = match mapped.next() {
        Some(item) => item,
        None => -1
    };
    for item in mapped {
        break;
    }
    values.push(40);
    first + second + values[3]
}
