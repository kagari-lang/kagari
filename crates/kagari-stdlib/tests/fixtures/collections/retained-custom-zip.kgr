fn bias() -> i32 {
    0
}

struct Source {
    val values: [i32],
    var position: u64
}

impl Iterator for Source {
    type Item = i32;
    fn next(self) -> Option<i32> {
        if self.position >= self.values.len() {
            return None;
        }
        val item = self.values[self.position];
        self.position += 1u64;
        Some(item + bias())
    }
}

pub fn make() -> Iterator<Item = (i32, i32)> {
    val offset = [1];
    Source { values: [10, 20], position: 0u64 }.map(|item| item + offset[0]).zip(
        Source { values: [30, 40], position: 0u64 }.map(|item| item + offset[0])
    )
}
