use test::probe::{ keep, tick };

struct Item {
    val key: i32,
    var visits: i32
}

fn main() {
    val values = Vec::from(
        [
            Item { key: 3, visits: 0 },
            Item { key: 1, visits: 0 },
            Item { key: 2, visits: 0 },
            Item { key: 0, visits: 0 }
        ]
    );
    keep(values);
    values.sort_by(
        |a, b| {
            a.visits += 1;
            val count = tick();
            if count == 3u64 {
                val fail = 1 / 0;
            };
            a.key.cmp(b.key)
        }
    );
}
