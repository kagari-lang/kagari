use core::iter::MapIterator;

struct Holder {
    var cursor: Option<MapIterator<i32, i32>>
}

fn main() {
    val holder = Holder { cursor: None };
    val mapped = Vec::from([1, 2]).map(
        |item| {
            match holder.cursor {
                Some(cursor) => {
                    cursor.next();
                },
                None => {}
            };
            item
        }
    );
    holder.cursor = Some(mapped);
    mapped.next();
}
