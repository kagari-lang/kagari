use example::generic::{ identity, probe };

struct Item {
    val value: i32
}

fn main() -> i32 {
    val original = [20, 22];
    val same = identity(original);
    same[0] = 21;
    val item = Item { value: 21 };
    if original[0] != 21 || probe(42) != 42 {
        return -1;
    }
    identity(item).value + identity(21)
}
