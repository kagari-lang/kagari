use std::collections::{ HashMap, HashSet };

fn main() -> bool {
    val map: HashMap<i32, i32> = HashMap::new();
    map.insert(1, 2);
    map.insert(1, 3);
    val set: HashSet<i32> = HashSet::new();
    set.insert(1);
    set.insert(1);
    map.get(1) == Some(3) && set.contains(1) && set.len() == 1u64
}
