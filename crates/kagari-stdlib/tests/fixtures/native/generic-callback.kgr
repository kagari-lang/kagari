use std::cmp::Ordering;

trait Keep {
    fn keep<T: Ord>(self, a: T, b: T) -> fn() -> bool {
        a.cmp(b);
        || a.cmp(b) == Ordering::Less
    }
}

impl Keep for i32 {}

pub fn make() -> fn() -> bool {
    val keeper: Keep = 0;
    keeper.keep(1, 2)
}

pub fn invoke(callback: fn() -> bool) -> bool {
    callback()
}
