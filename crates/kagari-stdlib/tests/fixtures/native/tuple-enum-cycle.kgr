use std::collections::{ HashMap, HashSet };

struct Node {
    val edges: HashMap<i32, Node>
}

fn main() ->(Option<(Vec<Node>,)>,) {
    val edges: HashMap<i32, Node> = HashMap::new();
    val node = Node { edges: edges };
    edges.insert(1, node);
    (Some(([node],)),)
}

pub fn garbage() -> HashSet<i32> {
    val set: HashSet<i32> = HashSet::new();
    set.insert(1);
    set
}

pub fn inspect(value: (Option<(Vec<Node>,)>,)) -> i32 {
    val (item,) = value;
    match item {
        Some((nodes,)) => if nodes[0].edges.get(1).is_some() {
            42
        } else {
            -1
        },
        None => -2
    }
}
