use test::boundary;

use host;

fn main() -> i32 {
    val kept = [40];
    boundary::choose(
        true,
        || {
            host::log("outer");
            kept[0] + 2
        }
    )
}

fn inner() -> i32 {
    boundary::choose(
        true,
        || {
            host::log("inner");
            7
        }
    )
}

fn fail() -> i32 {
    boundary::choose(
        true,
        || {
            val n = 2147483647;
            n + 1
        }
    )
}
