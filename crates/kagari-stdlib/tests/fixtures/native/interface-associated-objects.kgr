pub trait Reader {
    type Item;
    fn read(self) -> Self::Item;
}

trait Hidden {
    fn read(self) -> i32;
}

pub struct Holder<T> {
    pub val value: T
}

impl<T> Reader for Holder<T> {
    type Item = T;
    fn read(self) -> T {
        self.value
    }
}

impl Hidden for Holder<i32> {
    fn read(self) -> i32 {
        self.value
    }
}

pub fn make() -> Reader<Item = Holder<i32>> {
    Holder { value: Holder { value: 42 } }
}

pub fn hidden() -> Hidden {
    Holder { value: 1 }
}
