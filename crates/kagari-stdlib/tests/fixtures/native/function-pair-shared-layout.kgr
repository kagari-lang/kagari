pub struct Item {
    pub val value: i32
}

pub struct Pair<A, B> {
    pub val left: A,
    pub val right: B
}

impl<T> Pair<T, T> {
    pub fn same(self) -> i32 {
        42
    }
}

trait Factory {
    fn pair<A, B>(self, a: A, b: B) -> Pair<A, B>;
}

impl Factory for i32 {
    fn pair<A, B>(self, a: A, b: B) -> Pair<A, B> {
        Pair { left: a, right: b }
    }
}

pub fn make() -> Pair<Item, Item> {
    val factory: Factory = 0;
    factory.pair(Item { value: 1 }, Item { value: 2 })
}

pub fn evidence() -> i32 {
    make().same()
}
