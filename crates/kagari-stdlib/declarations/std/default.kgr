//! Explicit implementation-defined construction through the ordinary Default trait.
//! No automatic struct, field or enum initialization is implied.
//!
//! # Examples
//!
//! ```kgr
//! struct Player { val health: i32 }
//! impl Default for Player {
//!     fn default() -> Self { Player { health: 100 } }
//! }
//! fn main() -> bool {
//!     Player::default().health == 100 &&
//!         <Player as core::default::Default>::default().health == 100 &&
//!         i32::default() == 0 && String::default() == ""
//! }
//! ```

pub use core::default::Default as Default;
