//! Cold asynchronous operations. Creation captures inputs without starting work;
//! first await drives the operation once. Aliases share that single-drive state.
//!
//! # Examples
//!
//! ```kgr
//! async fn main() -> bool {
//!     val calls: Vec<i32> = Vec::new();
//!     val future = async { calls.push(1); 42 };
//!     val cold = calls.is_empty();
//!     val value = future.await;
//!     cold && value == 42 && calls.len() == 1u64
//! }
//! ```

pub use core::future::Future as Future;
