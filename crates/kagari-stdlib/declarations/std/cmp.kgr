//! Equality and ordering contracts. Comparisons must obey the laws required by
//! collection algorithms.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     7 == 7 && !(7 == 8)
//! }
//! ```

pub use core::cmp::Eq as Eq;
pub use core::cmp::Ord as Ord;
pub use core::cmp::Ordering as Ordering;
pub use core::cmp::PartialEq as PartialEq;
pub use core::cmp::PartialOrd as PartialOrd;
