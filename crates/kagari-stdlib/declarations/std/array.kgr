//! Builtin shared arrays have construction-time fixed length and checked element
//! access.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values = [10, 20];
//!     val alias = values;
//!     alias[1u64] = 42;
//!     values.len() == 2u64 && values[1u64] == 42
//! }
//! ```
