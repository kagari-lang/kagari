/// A readonly key/value interface. Lookup returns `None` for a missing key. Readonly views share storage with other aliases.
///
/// # Examples
///
/// ```kgr
/// fn find(values: std::collections::Map<i32, String>) -> Option<String> { values.get(1) }
/// ```
pub trait Map<T1, T2>: core::iter::Iterable<Item = (T1, T2)> {
    /// Return the number of entries.
    ///
    /// See `Map` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn find(values: std::collections::Map<i32, String>) -> Option<String> { values.get(1) }
    /// ```
    fn len(self) -> u64;
    /// Return whether the collection has no entries.
    ///
    /// See `Map` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn find(values: std::collections::Map<i32, String>) -> Option<String> { values.get(1) }
    /// ```
    fn is_empty(self) -> bool;
    /// Test membership without changing collection storage.
    ///
    /// See `Map` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn find(values: std::collections::Map<i32, String>) -> Option<String> { values.get(1) }
    /// ```
    fn contains_key(self, arg1: T1) -> bool;
    /// Return the requested value, or None if the index or key is absent.
    ///
    /// See `Map` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn find(values: std::collections::Map<i32, String>) -> Option<String> { values.get(1) }
    /// ```
    fn get(self, arg1: T1) -> core::option::Option<T2>;
}

/// A mutable key/value interface. Insert replaces the value of an equal key. Hash and equality callbacks must not structurally mutate a collection under lookup.
///
/// # Examples
///
/// ```kgr
/// fn put(values: std::collections::MutableMap<i32, String>) { values.insert(1, "one"); }
/// ```
pub trait MutableMap<T1, T2>: Map<T1, T2> {
    /// Insert a key/value entry, replacing the value of an equal key.
    ///
    /// See `MutableMap` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn put(values: std::collections::MutableMap<i32, String>) { values.insert(1, "one"); }
    /// ```
    fn insert(self, arg1: T1, arg2: T2);
    /// Remove and return the entry, or None if it is absent.
    ///
    /// See `MutableMap` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn put(values: std::collections::MutableMap<i32, String>) { values.insert(1, "one"); }
    /// ```
    fn remove(self, arg1: T1) -> core::option::Option<T2>;
    /// Remove all entries after validating structural mutation guards.
    ///
    /// See `MutableMap` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn put(values: std::collections::MutableMap<i32, String>) { values.insert(1, "one"); }
    /// ```
    fn clear(self);
}

/// A readonly membership interface. Equal values represent the same member. Readonly views share storage with other aliases.
///
/// # Examples
///
/// ```kgr
/// fn has(values: std::collections::Set<i32>) -> bool { values.contains(1) }
/// ```
pub trait Set<T>: core::iter::Iterable<Item = T> {
    /// Return the number of entries.
    ///
    /// See `Set` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn has(values: std::collections::Set<i32>) -> bool { values.contains(1) }
    /// ```
    fn len(self) -> u64;
    /// Return whether the collection has no entries.
    ///
    /// See `Set` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn has(values: std::collections::Set<i32>) -> bool { values.contains(1) }
    /// ```
    fn is_empty(self) -> bool;
    /// Test membership without changing collection storage.
    ///
    /// See `Set` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn has(values: std::collections::Set<i32>) -> bool { values.contains(1) }
    /// ```
    fn contains(self, arg1: T) -> bool;
}

/// A mutable membership interface. Insertion retains one representative of each equal value. Structural edits honor active borrow and lookup guards.
///
/// # Examples
///
/// ```kgr
/// fn add(values: std::collections::MutableSet<i32>) { values.insert(1); }
/// ```
pub trait MutableSet<T>: Set<T> {
    /// Insert a member, preserving the uniqueness of equal members.
    ///
    /// See `MutableSet` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn add(values: std::collections::MutableSet<i32>) { values.insert(1); }
    /// ```
    fn insert(self, arg1: T);
    /// Remove a member and report whether it was present.
    ///
    /// See `MutableSet` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn add(values: std::collections::MutableSet<i32>) { values.insert(1); }
    /// ```
    fn remove(self, arg1: T) -> bool;
    /// Remove all entries after validating structural mutation guards.
    ///
    /// See `MutableSet` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn add(values: std::collections::MutableSet<i32>) { values.insert(1); }
    /// ```
    fn clear(self);
}

