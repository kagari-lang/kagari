//! Sequence, map and set interfaces, concrete hash collections and lazy mapping.
//! Callbacks run synchronously with explicit borrow, root and mutation guards.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values = Vec::from([10, 20]);
//!     values.len() == 2u64 && values.get(0u64) == Some(10) && values.get(2u64) == None
//! }
//! ```

/// A shared hash map with invariant key and value types. Equal keys must hash
/// equally. Insert replaces an existing value; get returns None for an absent key.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values: std::collections::HashMap<i32, String> = std::collections::HashMap::new();
///     values.insert(1, "first").insert(1, "replacement");
///     values.len() == 1u64 && values.get(1) == Some("replacement") && values.get(2) == None
/// }
/// ```
pub type HashMap<T1, T2> where T1: core::cmp::Eq + core::cmp::PartialEq + core::hash::Hash;

/// A shared hash set. Equal members occupy one entry, and must hash equally. Lookup
/// and structural mutation use checked synchronous guards.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values = std::collections::HashSet::from([1, 1, 2]);
///     values.len() == 2u64 && values.contains(1) && !values.contains(3)
/// }
/// ```
pub type HashSet<T> where T: core::cmp::Eq + core::cmp::PartialEq + core::hash::Hash;

/// A readonly sequence interface. Element types are invariant. A readonly view
/// retains shared identity, so another alias can mutate the underlying sequence.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values: std::collections::List<i32> = Vec::from([10, 20]);
///     values.get(0u64) == Some(10) && values.get(2u64) == None
/// }
/// ```
pub trait List<T>: core::ops::Index<u64, Output = T> + core::iter::Iterable<Item = T> {
    /// Return the number of entries.
    ///
    /// Counts elements as u64, not bytes. Reading through this view does not freeze
    /// the storage; mutations through other aliases can change a later result.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::List<i32> = Vec::from([10, 20]);
    ///     values.len() == 2u64
    /// }
    /// ```
    fn len(self) -> u64;

    /// Return whether the collection has no entries.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: Vec<i32> = Vec::new();
    ///     val empty: std::collections::List<i32> = storage;
    ///     val one: std::collections::List<i32> = Vec::from([1]);
    ///     empty.is_empty() && !one.is_empty()
    /// }
    /// ```
    fn is_empty(self) -> bool;

    /// Return the requested value, or None if the index or key is absent.
    ///
    /// The argument is a zero-based element index. Returns Some(value) below len and
    /// None otherwise, including on empty input. In contrast, indexing with [] traps
    /// for an invalid index. Referenced element values retain their shared identity.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::List<i32> = Vec::from([10, 20]);
    ///     values.get(1u64) == Some(20) && values.get(2u64) == None
    /// }
    /// ```
    fn get(self, arg1: u64) -> core::option::Option<T>;

    /// Returns a new List in ascending `Ord` order.
    ///
    /// Equal elements keep their relative order. The original slots are unchanged;
    /// elements themselves are copied as values, so referenced objects remain shared.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([3, 1, 2]);
    ///     val result = input.sorted();
    ///     result.get(0u64) == Some(1) && result.get(2u64) == Some(3) && input.get(0u64) == Some(3)
    /// }
    /// ```
    fn sorted(self) -> List<T> where T: core::cmp::Ord {
        __default_4_List_sorted::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }

    /// Returns a new List ordered by `callback(left, right)`.
    ///
    /// The callback returns Less, Equal or Greater and must define a consistent order.
    /// Equal elements keep their relative order. Original slots are unchanged, but
    /// completed callback effects survive a later trap.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 3, 2]);
    ///     val result = input.sorted_by(|left, right| right.cmp(left));
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    fn sorted_by(self, callback: fn(T, T) -> core::cmp::Ordering) -> List<T> {
        __default_4_List_sorted_by::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self, callback)
    }

    /// Returns a new List ordered by the keys produced by `callback`.
    ///
    /// Keys are evaluated during comparisons, without caching. A callback can run
    /// more than once for an element; it must yield a consistent ordering. Equal keys
    /// keep their original element order. Original slots are unchanged.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 3, 2]);
    ///     val result = input.sorted_by_key(|value| -value);
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    fn sorted_by_key<M>(self, callback: fn(T) -> M) -> List<T> where M: core::cmp::Ord {
        __default_4_List_sorted_by_key::<Self, T, M, <Self as core::iter::Iterable<Item = T>>::Iter>(self, callback)
    }

    /// Returns a new List in reverse input order.
    ///
    /// Original slots are unchanged. Empty and single-element lists retain their
    /// contents. Referenced elements are shared rather than deeply cloned.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 2, 3]);
    ///     val result = input.reversed();
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    fn reversed(self) -> List<T> {
        __default_4_List_reversed::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }

    /// Returns the first occurrence of each equal element in input order.
    ///
    /// Equality uses `Eq`; no Hash bound is required. Unlike `dedup`, nonadjacent
    /// duplicates are removed too. Original slots are unchanged; callback effects
    /// from equality checks are not rolled back on failure.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([2, 1, 2, 1, 3]);
    ///     val result = input.distinct();
    ///     result.len() == 3u64 && result.get(0u64) == Some(2) && result.get(1u64) == Some(1) && input.len() == 5u64
    /// }
    /// ```
    fn distinct(self) -> List<T> where T: core::cmp::Eq {
        __default_4_List_distinct::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }
}

/// A mutable sequence interface. Structural edits validate active borrows and
/// invalidate existing cursors. Completed writes and callback effects survive later
/// failures.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val storage = Vec::from([1, 2]);
///     val view: std::collections::MutableList<i32> = storage;
///     view.push(3);
///     storage.get(2u64) == Some(3) && view.len() == 3u64
/// }
/// ```
pub trait MutableList<T>: List<T> {
    /// Append one item. A guarded structural edit traps before committing the edit.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2]);
    ///     val writable: std::collections::MutableList<i32> = values;
    ///     writable.push(3);
    ///     values.len() == 3u64 && values.get(2u64) == Some(3)
    /// }
    /// ```
    fn push(self, arg1: T);

    /// Remove and return the last item, or None for an empty sequence.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.pop() == Some(20) && values.pop() == Some(10) && values.pop() == None
    /// }
    /// ```
    fn pop(self) -> core::option::Option<T>;

    /// Insert at the given position and shift later elements. An index beyond the
    /// length traps.
    ///
    /// Index len appends; smaller indices insert before the existing element.
    /// Returns Unit. Vec aliases observe the edit and existing cursors reject later
    /// reads after a structural change.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 30]);
    ///     values.insert(1u64, 20);
    ///     values.len() == 3u64 && values.get(1u64) == Some(20) && values.get(2u64) == Some(30)
    /// }
    /// ```
    fn insert(self, arg1: u64, arg2: T);

    /// Remove and return the entry, or None if it is absent.
    ///
    /// The argument is a zero-based element index. Later elements shift left when
    /// an item is removed. An out-of-range index returns None and leaves slots
    /// unchanged.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20, 30]);
    ///     val removed = values.remove(1u64);
    ///     removed == Some(20) && values.get(1u64) == Some(30) && values.remove(9u64) == None
    /// }
    /// ```
    fn remove(self, arg1: u64) -> core::option::Option<T>;

    /// Remove all entries after validating structural mutation guards.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.clear();
    ///     values.is_empty() && values.get(0u64) == None
    /// }
    /// ```
    fn clear(self);

    /// Replace the item at an existing index. An out-of-bounds index traps.
    ///
    /// The zero-based index must be below len. Returns Unit without changing the
    /// length. Existing aliases observe the replacement in the same sequence.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.set(1u64, 99);
    ///     values.len() == 2u64 && values.get(0u64) == Some(10) && values.get(1u64) == Some(99)
    /// }
    /// ```
    fn set(self, arg1: u64, arg2: T);

    /// Sorts this list in ascending `Ord` order, returning Unit.
    ///
    /// Equal elements keep their relative order. Aliases observe the same storage.
    /// A failure can leave a partial reordering; completed effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([3, 1, 2]);
    ///     val alias = values;
    ///     values.sort();
    ///     alias.get(0u64) == Some(1) && alias.get(2u64) == Some(3)
    /// }
    /// ```
    fn sort(self) where T: core::cmp::Ord {
        __default_11_MutableList_sort::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }

    /// Sorts this list in place using `callback(left, right)`, returning Unit.
    ///
    /// The callback returns Less, Equal or Greater and must define a consistent order.
    /// Equal elements retain their relative order. A trap stops later callbacks and
    /// can leave a partial reordering. Vec rejects structural edits during comparison.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 3, 2]);
    ///     values.sort_by(|left, right| right.cmp(left));
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    fn sort_by(self, callback: fn(T, T) -> core::cmp::Ordering) {
        __default_11_MutableList_sort_by::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self, callback)
    }

    /// Sorts this list in place by `callback` keys, returning Unit.
    ///
    /// Keys are evaluated during comparisons, without caching; callbacks can run
    /// repeatedly for one element. Equal keys preserve element order. A callback trap
    /// can leave a partial reordering. Vec rejects structural edits during comparison.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 3, 2]);
    ///     values.sort_by_key(|value| -value);
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    fn sort_by_key<M>(self, callback: fn(T) -> M) where M: core::cmp::Ord {
        __default_11_MutableList_sort_by_key::<Self, T, M, <Self as core::iter::Iterable<Item = T>>::Iter>(self, callback)
    }

    /// Reverses this list in place, returning Unit.
    ///
    /// Aliases observe the same storage. Empty and single-element inputs are unchanged.
    /// If a custom receiver fails during a write, earlier writes remain committed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3]);
    ///     values.reverse();
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    fn reverse(self) {
        __default_11_MutableList_reverse::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }

    /// Keeps elements for which `callback` returns true, returning Unit.
    ///
    /// Visits elements in input order and preserves the order of retained elements.
    /// A trap stops later callbacks and retains completed removals and callback
    /// effects.
    /// Vec rejects structural edits from the predicate while retaining.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3, 4]);
    ///     values.retain(|value| value % 2 == 0);
    ///     values.len() == 2u64 && values.get(0u64) == Some(2) && values.get(1u64) == Some(4)
    /// }
    /// ```
    fn retain(self, callback: fn(T) -> bool) {
        __default_11_MutableList_retain::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self, callback)
    }

    /// Removes consecutive equal elements, keeping the first in each run.
    ///
    /// Returns Unit and compares through `Eq`, without requiring Hash. Nonadjacent
    /// duplicates remain; use `distinct` to remove them in a new List. A failure
    /// preserves earlier removals and equality-callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 1, 2, 1]);
    ///     values.dedup();
    ///     values.len() == 3u64 && values.get(0u64) == Some(1) && values.get(1u64) == Some(2) && values.get(2u64) == Some(1)
    /// }
    /// ```
    fn dedup(self) where T: core::cmp::Eq {
        __default_11_MutableList_dedup::<Self, T, <Self as core::iter::Iterable<Item = T>>::Iter>(self)
    }
}

/// A readonly key/value interface. Lookup returns `None` for a missing key.
/// Readonly views share storage with other aliases.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val storage: std::collections::HashMap<i32, String> = std::collections::HashMap::new();
///     storage.insert(1, "one");
///     val view: std::collections::Map<i32, String> = storage;
///     view.get(1) == Some("one") && view.get(2) == None
/// }
/// ```
pub trait Map<T1, T2>: core::iter::Iterable<Item = (T1, T2)> {
    /// Return the number of entries.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val data: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     data.insert(1, 10).insert(1, 20);
    ///     val view: std::collections::Map<i32, i32> = data;
    ///     view.len() == 1u64
    /// }
    /// ```
    fn len(self) -> u64;

    /// Return whether the collection has no entries.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val data: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     val view: std::collections::Map<i32, i32> = data;
    ///     val before = view.is_empty();
    ///     data.insert(7, 10);
    ///     before && !view.is_empty()
    /// }
    /// ```
    fn is_empty(self) -> bool;

    /// Test membership without changing collection storage.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val data: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     data.insert(7, 42);
    ///     val view: std::collections::Map<i32, i32> = data;
    ///     view.contains_key(7) && !view.contains_key(42)
    /// }
    /// ```
    fn contains_key(self, arg1: T1) -> bool;

    /// Return the requested value, or None if the index or key is absent.
    ///
    /// Returns the value associated with an equal key. None means the key is absent;
    /// it does not remove an entry. HashMap invokes the key's Hash and Eq operations
    /// synchronously and rejects structural mutation during that lookup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val data: std::collections::HashMap<i32, String> = std::collections::HashMap::new();
    ///     data.insert(1, "one");
    ///     val view: std::collections::Map<i32, String> = data;
    ///     view.get(1) == Some("one") && view.get(2) == None
    /// }
    /// ```
    fn get(self, arg1: T1) -> core::option::Option<T2>;
}

/// A mutable key/value interface. Insert replaces the value of an equal key. Hash
/// and equality callbacks must not structurally mutate a collection under lookup.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val storage: std::collections::HashMap<i32, String> = std::collections::HashMap::new();
///     val view: std::collections::MutableMap<i32, String> = storage;
///     view.insert(1, "first");
///     view.insert(1, "replacement");
///     view.len() == 1u64 && view.get(1) == Some("replacement")
/// }
/// ```
pub trait MutableMap<T1, T2>: Map<T1, T2> {
    /// Insert a key/value entry, replacing the value of an equal key.
    ///
    /// This interface method returns Unit; HashMap's inherent insert instead returns
    /// the same map for chaining. Inserting an equal key replaces its value without
    /// increasing len. HashMap iteration order is unspecified.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: std::collections::HashMap<i32, String> = std::collections::HashMap::new();
    ///     val values: std::collections::MutableMap<i32, String> = storage;
    ///     values.insert(1, "first");
    ///     values.insert(1, "replacement");
    ///     values.len() == 1u64 && values.get(1) == Some("replacement")
    /// }
    /// ```
    fn insert(self, arg1: T1, arg2: T2);

    /// Remove and return the entry, or None if it is absent.
    ///
    /// Returns the removed value in Some, or None when no equal key exists. Other
    /// entries remain. HashMap aliases observe the removal; entry order is unspecified.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     val values: std::collections::MutableMap<i32, i32> = storage;
    ///     values.insert(7, 42);
    ///     values.remove(7) == Some(42) && values.remove(7) == None && values.is_empty()
    /// }
    /// ```
    fn remove(self, arg1: T1) -> core::option::Option<T2>;

    /// Remove all entries after validating structural mutation guards.
    ///
    /// This interface method returns Unit; the concrete hash collection's inherent
    /// clear returns the same storage. Aliases observe the empty collection and live
    /// cursors reject reads after a committed structural change.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     val values: std::collections::MutableMap<i32, i32> = storage;
    ///     values.insert(7, 42);
    ///     values.clear();
    ///     values.is_empty() && values.get(7) == None
    /// }
    /// ```
    fn clear(self);
}

/// A readonly membership interface. Equal values represent the same member.
/// Readonly views share storage with other aliases.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values: std::collections::Set<i32> = std::collections::HashSet::from([1, 1, 2]);
///     values.len() == 2u64 && values.contains(1) && !values.contains(3)
/// }
/// ```
pub trait Set<T>: core::iter::Iterable<Item = T> {
    /// Return the number of entries.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::Set<i32> = std::collections::HashSet::from([1, 1, 2]);
    ///     values.len() == 2u64
    /// }
    /// ```
    fn len(self) -> u64;

    /// Return whether the collection has no entries.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: std::collections::HashSet<i32> = std::collections::HashSet::new();
    ///     val values: std::collections::Set<i32> = storage;
    ///     values.is_empty()
    /// }
    /// ```
    fn is_empty(self) -> bool;

    /// Test membership without changing collection storage.
    ///
    /// The view retains shared storage, so another alias can change later results.
    /// Hash collection key equality and hashing must remain consistent while stored.
    /// Iteration order is unspecified for HashMap and HashSet.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::Set<i32> = std::collections::HashSet::from([1, 2]);
    ///     values.contains(1) && !values.contains(3)
    /// }
    /// ```
    fn contains(self, arg1: T) -> bool;
}

/// A mutable membership interface. Insertion retains one representative of each
/// equal value. Structural edits honor active borrow and lookup guards.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val storage: std::collections::HashSet<i32> = std::collections::HashSet::new();
///     val view: std::collections::MutableSet<i32> = storage;
///     view.insert(7);
///     view.insert(7);
///     view.len() == 1u64 && view.contains(7)
/// }
/// ```
pub trait MutableSet<T>: Set<T> {
    /// Insert a member, preserving the uniqueness of equal members.
    ///
    /// This interface method returns Unit; HashSet's inherent insert returns the
    /// same set for chaining. Repeated insertion of an equal member does not increase
    /// len. HashSet iteration order is unspecified.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: std::collections::HashSet<i32> = std::collections::HashSet::new();
    ///     val values: std::collections::MutableSet<i32> = storage;
    ///     values.insert(7);
    ///     values.insert(7);
    ///     values.len() == 1u64 && values.contains(7)
    /// }
    /// ```
    fn insert(self, arg1: T);

    /// Remove a member and report whether it was present.
    ///
    /// Returns true only when an equal member was present and removed. Removing an
    /// absent member returns false and leaves membership unchanged.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableSet<i32> = std::collections::HashSet::from([7]);
    ///     values.remove(7) && !values.remove(7) && values.is_empty()
    /// }
    /// ```
    fn remove(self, arg1: T) -> bool;

    /// Remove all entries after validating structural mutation guards.
    ///
    /// This interface method returns Unit; the concrete hash collection's inherent
    /// clear returns the same storage. Aliases observe the empty collection and live
    /// cursors reject reads after a committed structural change.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableSet<i32> = std::collections::HashSet::from([1, 2]);
    ///     values.clear();
    ///     values.is_empty() && !values.contains(1)
    /// }
    /// ```
    fn clear(self);
