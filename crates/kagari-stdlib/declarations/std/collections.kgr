/// Compares list contents across compatible implementations using element
/// protocols.
///
/// This compares contents, not receiver storage identity. Lists compare in order;
/// sets and maps compare their members or key/value entries independently of
/// iteration order. Completed callback effects remain visible on failure.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val left = Vec::from([1, 2]);
///     val same = Vec::from([1, 2]);
///     val reversed = Vec::from([2, 1]);
///     std::collections::list_content_equal(left, same) && !std::collections::list_content_equal(left, reversed)
/// }
/// ```
pub fn list_content_equal<T>(left: List<T>, right: List<T>) -> bool where T: core::cmp::PartialEq;

/// Compares set contents across compatible implementations using element protocols.
///
/// This compares contents, not receiver storage identity. Lists compare in order;
/// sets and maps compare their members or key/value entries independently of
/// iteration order. Completed callback effects remain visible on failure.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val left = std::collections::HashSet::from([1, 2]);
///     val right = std::collections::HashSet::from([2, 1, 1]);
///     std::collections::set_content_equal(left, right)
/// }
/// ```
pub fn set_content_equal<T>(left: Set<T>, right: Set<T>) -> bool where T: core::cmp::Eq;

/// Compares map contents across compatible implementations using element protocols.
///
/// This compares contents, not receiver storage identity. Lists compare in order;
/// sets and maps compare their members or key/value entries independently of
/// iteration order. Completed callback effects remain visible on failure.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val left: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
///     val right: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
///     left.insert(1, 10).insert(2, 20);
///     right.insert(2, 20).insert(1, 10);
///     std::collections::map_content_equal(left, right)
/// }
/// ```
pub fn map_content_equal<T1, T2>(left: Map<T1, T2>, right: Map<T1, T2>) -> bool where T1: core::cmp::Eq, T2: core::cmp::PartialEq;

