    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     values.is_empty() && values.get(1) == None
    /// }
    /// ```
    pub fn new() -> HashMap<T1, T2>;
}

