impl<T1, T2> HashMap<T1, T2> where T1: core::cmp::Eq + core::cmp::PartialEq + core::hash::Hash {
    /// Removes all entries and returns this same collection. Existing aliases observe
    /// the empty storage. Structural mutation checks run before the edit; live cursors
    /// become invalid after a committed structural change.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     values.insert(1, 10);
    ///     val returned = values.clear();
    ///     returned.insert(2, 20);
    ///     values.len() == 1u64 && values.get(1) == None && values.get(2) == Some(20)
    /// }
    /// ```
    pub fn clear(self) -> HashMap<T1, T2>;

    /// Inserts or replaces the value of an equal key and returns this same map.
    /// Existing aliases observe the change. Key equality and hashing use the declared
    /// protocols; iteration order is unspecified.
