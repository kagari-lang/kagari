    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(values: std::collections::HashMap<i32, i32>) { val result = values.clear(); }
    /// ```
    pub fn clear(self) -> HashMap<T1, T2>;
    /// Insert a key/value entry, replacing the value of an equal key, and return the same map.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(values: std::collections::HashMap<i32, i32>) { val result = values.insert(0, 1); }
    /// ```
    pub fn insert(self, arg1: T1, arg2: T2) -> HashMap<T1, T2>;
    /// Create fresh empty hash collection storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn create() -> std::collections::HashMap<i32, i32> { std::collections::HashMap::new() }
    /// ```
    pub fn new() -> HashMap<T1, T2>;
}

