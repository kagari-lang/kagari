    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
    ///     val returned = values.insert(1, 10).insert(1, 20);
    ///     returned.insert(2, 30);
    ///     values.len() == 2u64 && values.get(1) == Some(20) && values.get(2) == Some(30)
    /// }
    /// ```
    pub fn insert(self, arg1: T1, arg2: T2) -> HashMap<T1, T2>;

    /// Creates fresh empty mutable hash storage. Independently created collections do
    /// not share entries.
