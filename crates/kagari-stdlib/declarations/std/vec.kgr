//! Shared mutable sequences with checked indexing, iteration and collection
//! algorithms. Readonly views do not freeze aliases.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values = Vec::from([10, 20]);
//!     values.len() == 2u64 && values.get(0u64) == Some(10) && values.get(2u64) == None
//! }
//! ```

pub use alloc::vec::Vec as Vec;
