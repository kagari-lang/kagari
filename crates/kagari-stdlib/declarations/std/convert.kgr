//! Explicit infallible and checked conversions, including reverse adapters and
//! error conversion.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     i64::from(42i32) == 42i64 && i64::from(-7i32) == -7i64
//! }
//! ```

pub use core::convert::From as From;
pub use core::convert::Infallible as Infallible;
pub use core::convert::Into as Into;
pub use core::convert::TryFrom as TryFrom;
pub use core::convert::TryInto as TryInto;
