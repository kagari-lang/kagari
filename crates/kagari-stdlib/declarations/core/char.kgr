//! Unicode scalar values, distinct from integers. char has scalar-value equality, ordering and hashing, UTF-8 Display, escaped single-quoted Debug and a NUL default. Explicit conversions provide char to u32 or String and checked u32 to char; Into and TryInto use the corresponding forward implementations. No numeric parsing, arithmetic, aggregation or character-range iteration is provided.
//!
//! # Examples
//!
//! ```kgr
//! fn scalar(value: u32) -> Result<char, core::char::CharTryFromError> { char::try_from(value) }
//! ```

/// A Unicode scalar conversion error. InvalidScalar rejects surrogate values U+D800 through U+DFFF and values above U+10FFFF.
///
/// # Examples
///
/// ```kgr
/// fn scalar(value: u32) -> Result<char, core::char::CharTryFromError> { char::try_from(value) }
/// ```
pub enum CharTryFromError {
    /// The `InvalidScalar` case of `CharTryFromError`. A Unicode scalar conversion error. InvalidScalar rejects surrogate values U+D800 through U+DFFF and values above U+10FFFF.
    InvalidScalar,
}

impl core::default::Default for char {
    /// Return the NUL Unicode scalar U+0000.
    ///
    /// See `core::default::Default` for the construction contract.
    pub fn default() -> char;
}

impl core::convert::From<char> for u32 {
    /// Return the Unicode scalar value as u32.
    pub fn from(value: char) -> u32;
}

impl core::convert::From<char> for alloc::string::String {
    /// Encode the character as an immutable UTF-8 String.
    pub fn from(value: char) -> alloc::string::String;
}

impl core::convert::TryFrom<u32> for char {
    type Error = CharTryFromError;
    /// Convert a Unicode scalar value to char. Surrogates U+D800 through U+DFFF and values above U+10FFFF return CharTryFromError::InvalidScalar.
    pub fn try_from(value: u32) -> core::result::Result<char, CharTryFromError>;
}
