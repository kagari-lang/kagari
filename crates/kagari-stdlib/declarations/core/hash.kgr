//! Hash contracts used by key-based collections. Equal keys must hash equally, and
//! key lookup blocks recursive structural mutation.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
//!     values.insert(7, 42);
//!     values.get(7) == Some(42) && values.get(8) == None
//! }
//! ```

/// Computes a stable hash for the duration of a collection operation. Equal keys
/// must hash equally. Hash and equality callbacks run synchronously; recursive
/// structural mutation during lookup traps.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values: std::collections::HashMap<i32, i32> = std::collections::HashMap::new();
///     values.insert(7, 42);
///     values.get(7) == Some(42) && values.get(8) == None
/// }
/// ```
#[lang = "hash"]
pub trait Hash {
    /// Computes a stable hash for the duration of a collection operation. Equal keys
    /// must hash equally. Hash and equality callbacks run synchronously; recursive
    /// structural mutation during lookup traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val original = "café";
    ///     val copy = original.replace("fé", "fé");
    ///     original == copy && original.hash() == copy.hash()
    /// }
    /// ```
    fn hash(self) -> i64;
}
