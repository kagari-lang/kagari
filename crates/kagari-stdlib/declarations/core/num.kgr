    type Error = TryFromIntError;

    /// Converts `i32` to `i8` when the value fits.
    ///
    /// Returns `TryFromIntError::OutOfRange` when the value is outside the target's
    /// representable range. No wrapping or truncation is performed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::num::TryFromIntError;
    /// fn main() -> bool {
    ///     val fits = match i8::try_from(42i32) {
