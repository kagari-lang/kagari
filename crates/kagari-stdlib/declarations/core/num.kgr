    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     2i32.checked_mul(3i32) == Some(6i32) &&
    ///         2147483647i32.checked_mul(2i32) == None
    /// }
