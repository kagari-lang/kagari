impl f32 {
    /// Return the absolute value at the receiver's width. Negative zero becomes
    /// positive zero and either infinity becomes positive infinity. NaN returns NaN
    /// without a payload guarantee.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-3.5f32).abs() == 3.5f32 &&
    ///         (-0.0f32).abs().to_bits() == 0u32
    /// }
    /// ```
    pub fn abs(self) -> f32;

    /// Return the least integral float greater than or equal to the receiver, rounding
    /// toward positive infinity. Signed zero and infinities are retained; NaN returns
    /// NaN. The result remains a float, not an integer conversion.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.25f32.ceil() == 2.0f32 &&
    ///         (-1.75f32).ceil() == -1.0f32
    /// }
    /// ```
    pub fn ceil(self) -> f32;

    /// Restrict the receiver to the inclusive bounds using Rust's float clamp. A NaN
    /// bound or min > max returns ScriptTrap, never a host panic; bounds are validated
    /// even when the receiver is NaN. Infinite bounds are legal. With valid bounds a
    /// NaN receiver returns NaN, and an in-range receiver is retained, including
    /// negative zero. Equal opposite-signed zero bounds are valid. This is not a
    /// max/min composition.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     10.0f32.clamp(0.0f32, 5.0f32) == 5.0f32 &&
    ///         3.0f32.clamp(0.0f32, 5.0f32) == 3.0f32 &&
    ///         f32::from_bits(2143289345u32).clamp(0.0f32, 5.0f32).is_nan()
    /// }
    /// ```
    pub fn clamp(self, min: f32, max: f32) -> f32;

    /// Return the greatest integral float less than or equal to the receiver, rounding
    /// toward negative infinity. Signed zero and infinities are retained; NaN returns
    /// NaN. The result remains a float, not an integer conversion.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.75f32.floor() == 1.0f32 &&
    ///         (-1.25f32).floor() == -2.0f32
    /// }
    /// ```
    pub fn floor(self) -> f32;

    /// Return the fractional part using the matching Rust primitive: self -
    /// self.trunc(). Negative nonintegral inputs have negative fractions. Infinite
    /// inputs and NaN return NaN; zero signs follow that subtraction rather than a
    /// separate sign-preservation rule.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.25f32.fract() == 0.25f32 &&
    ///         (-1.25f32).fract() == -0.25f32
    /// }
    /// ```
    pub fn fract(self) -> f32;

    /// Reinterpret u32 bits as an IEEE 754 f32, without a numeric cast. Every bit
    /// pattern is accepted, including signed zeros, subnormals, infinities and
    /// quiet/signaling NaNs. An immediate f32::from_bits(bits).to_bits() round trip
    /// preserves every sign and payload bit; subsequent arithmetic, casts, formatting
    /// and math need not preserve NaN payloads. No signaling-NaN exception mode is
    /// introduced.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     f32::from_bits(2147483648u32).to_bits() == 2147483648u32 &&
    ///         f32::from_bits(2143289345u32).is_nan() &&
    ///         f32::from_bits(2143289345u32).to_bits() == 2143289345u32
    /// }
    /// ```
    pub fn from_bits(bits: u32) -> f32;

    /// Return true for finite values, including subnormals and either signed zero.
    /// Positive infinity, negative infinity and every NaN return false.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.25f32.is_finite() &&
    ///         !f32::from_bits(2139095040u32).is_finite() &&
    ///         !f32::from_bits(2143289345u32).is_finite()
    /// }
    /// ```
    pub fn is_finite(self) -> bool;

    /// Return true exactly for positive or negative infinity. NaNs, finite values,
    /// subnormals and either signed zero return false.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     f32::from_bits(2139095040u32).is_infinite() &&
    ///         (-f32::from_bits(2139095040u32)).is_infinite() &&
    ///         !f32::from_bits(2143289345u32).is_infinite()
    /// }
    /// ```
    pub fn is_infinite(self) -> bool;

    /// Return true exactly when the receiver is NaN, including quiet and signaling NaN
    /// bit patterns. Infinities, finite values, subnormals and either signed zero
    /// return false. No NaN payload comparison is performed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     f32::from_bits(2143289345u32).is_nan() &&
    ///         !f32::from_bits(2139095040u32).is_nan() &&
    ///         !0.0f32.is_nan()
    /// }
    /// ```
    pub fn is_nan(self) -> bool;

    /// Return the larger operand using Rust's NaN-ignoring float contract, not total
    /// ordering. If exactly one operand is NaN, return the other; if both are NaN,
    /// return NaN. Equal positive and negative zero operands may return either sign.
    /// Infinities compare normally.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-2.0f32).max(3.0f32) == 3.0f32 &&
    ///         2.0f32.max(f32::from_bits(2143289345u32)) == 2.0f32
    /// }
    /// ```
    pub fn max(self, other: f32) -> f32;

    /// Return the smaller operand using Rust's NaN-ignoring float contract, not total
    /// ordering. If exactly one operand is NaN, return the other; if both are NaN,
    /// return NaN. Equal positive and negative zero operands may return either sign.
    /// Infinities compare normally.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-2.0f32).min(3.0f32) == -2.0f32 &&
    ///         f32::from_bits(2143289345u32).min(2.0f32) == 2.0f32
    /// }
    /// ```
    pub fn min(self, other: f32) -> f32;

    /// Return the nearest integral float, rounding halfway cases away from zero. Signed
    /// zero and infinities are retained; NaN returns NaN. The result remains a float,
    /// not an integer conversion.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.5f32.round() == 2.0f32 &&
    ///         (-1.5f32).round() == -2.0f32
    /// }
    /// ```
    pub fn round(self) -> f32;

    /// Return the correctly rounded square root at the receiver's width. Negative
    /// nonzero inputs, including negative infinity, return NaN. Positive infinity stays
    /// positive infinity, negative zero remains negative zero, and NaN returns NaN.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     9.0f32.sqrt() == 3.0f32 &&
    ///         (-1.0f32).sqrt().is_nan() &&
    ///         (-0.0f32).sqrt().to_bits() == 2147483648u32
    /// }
    /// ```
    pub fn sqrt(self) -> f32;

    /// Reinterpret the receiver's IEEE 754 bit pattern as u32, without a numeric cast.
    /// Every bit is retained, including zero signs, subnormals, infinities and
    /// quiet/signaling NaN signs and payloads. An immediate
    /// f32::from_bits(bits).to_bits() round trip preserves bits exactly; subsequent
    /// arithmetic, casts, formatting and math need not preserve NaN payloads. No
    /// signaling-NaN exception mode is introduced.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.0f32.to_bits() == 1065353216u32 &&
    ///         (-0.0f32).to_bits() == 2147483648u32
    /// }
    /// ```
    pub fn to_bits(self) -> u32;

    /// Return the integral part as a float, rounding toward zero. Signed zero and
    /// infinities are retained; NaN returns NaN. The result remains a float, not an
    /// integer conversion.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1.75f32.trunc() == 1.0f32 &&
    ///         (-1.75f32).trunc() == -1.0f32
    /// }
    /// ```
    pub fn trunc(self) -> f32;
}

