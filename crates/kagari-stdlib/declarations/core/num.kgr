impl core::str::FromStr for f32 {
    type Err = ParseError;

    /// Parses a string as `f32`.
    ///
    /// Accepts decimal and exponent notation, NaN and infinity. Invalid syntax returns
    /// `InvalidSyntax`; a finite text outside the finite range can produce infinity.
    /// Rounding follows the target float width.
    /// Empty input returns `ParseError::Empty`. Parsing consumes the complete string
    /// and returns a checked `Result`; it does not change the input.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::num::ParseError;
    /// fn main() -> bool {
    ///     val parsed = match f32::from_str("1.25") {
    ///         Ok(value) => value == 1.25f32,
    ///         Err(_) => false,
    ///     };
    ///     val empty = match f32::from_str("") {
    ///         Err(ParseError::Empty) => true,
    ///         _ => false,
    ///     };
    ///     val invalid = match f32::from_str("1.2.3") {
    ///         Err(ParseError::InvalidSyntax) => true,
    ///         _ => false,
    ///     };
    ///     parsed && empty && invalid
    /// }
    /// ```
    pub fn from_str(text: alloc::string::String) -> core::result::Result<f32, ParseError>;
}

