impl core::convert::TryFrom<bool> for bool {
    type Error = core::convert::Infallible;

    /// Converts `bool` to `bool` without losing information.
    ///
    /// Every source value is representable. The declared error type is `Infallible`;
    /// the result always contains `Ok`. Boolean conversion uses zero for false and one
    /// for true when the target is an integer.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     match bool::try_from(true) {
    ///         Ok(value) => value == true,
    ///         Err(_) => false,
    ///     }
    /// }
    /// ```
    pub fn try_from(value: bool) -> core::result::Result<bool, core::convert::Infallible>;
}

