    pub fn checked_mul(self, rhs: i32) -> core::option::Option<i32>;

    /// Return Some(remainder) with the receiver's sign when nonzero. Return None for a
    /// zero divisor or signed MIN % -1, even though its mathematical remainder is zero,
    /// instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
