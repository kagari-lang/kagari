impl core::str::FromStr for bool {
    type Err = ParseError;

    /// Parses a string as `bool`.
    ///
    /// Accepts exactly `true` and `false`, in lowercase.
    /// Empty input returns `ParseError::Empty`. Parsing consumes the complete string
    /// and returns a checked `Result`; it does not change the input.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::num::ParseError;
    /// fn main() -> bool {
    ///     val parsed = match bool::from_str("true") {
    ///         Ok(value) => value == true,
    ///         Err(_) => false,
    ///     };
    ///     val empty = match bool::from_str("") {
    ///         Err(ParseError::Empty) => true,
    ///         _ => false,
    ///     };
    ///     val invalid = match bool::from_str("TRUE") {
    ///         Err(ParseError::InvalidSyntax) => true,
    ///         _ => false,
    ///     };
    ///     parsed && empty && invalid
    /// }
    /// ```
    pub fn from_str(text: alloc::string::String) -> core::result::Result<bool, ParseError>;
}

impl core::str::FromStr for i8 {
    type Err = ParseError;

    /// Parses a string as `i8`.
    ///
    /// Parses base-ten digits with an optional sign. Whitespace and radix prefixes
    /// are not trimmed or recognized. Invalid digits return `InvalidDigit`; a value
    /// outside the target range returns `OutOfRange`.
    /// Empty input returns `ParseError::Empty`. Parsing consumes the complete string
    /// and returns a checked `Result`; it does not change the input.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::num::ParseError;
    /// fn main() -> bool {
    ///     val parsed = match i8::from_str("42") {
    ///         Ok(value) => value == 42i8,
    ///         Err(_) => false,
    ///     };
    ///     val empty = match i8::from_str("") {
    ///         Err(ParseError::Empty) => true,
    ///         _ => false,
    ///     };
    ///     val invalid = match i8::from_str("12x") {
    ///         Err(ParseError::InvalidDigit) => true,
    ///         _ => false,
    ///     };
    ///     val overflow = match i8::from_str("128") {
    ///         Err(ParseError::OutOfRange) => true,
    ///         _ => false,
    ///     };
    ///     parsed && empty && invalid && overflow
    /// }
    /// ```
    pub fn from_str(text: alloc::string::String) -> core::result::Result<i8, ParseError>;
}

impl core::iter::Sum<i8> for i8 {
    /// Constructs a sum from an iterable source.
    ///
    /// `Iterable::sum` delegates to this implementation. Built-in numeric
    /// implementations
    /// add items in source order and return zero for an empty input. Integer addition
    /// is checked and traps on overflow; floating-point addition follows the declared
    /// floating-point type's arithmetic. Custom implementations define their own rules.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     i32::sum(Vec::from([2, 3, 4])) == 9
    /// }
    /// ```
    pub fn sum<T>(source: T) -> i8 where T: core::iter::Iterable<Item = i8>;
}

impl core::iter::Product<i8> for i8 {
    /// Constructs a product from an iterable source.
    ///
    /// `Iterable::product` delegates to this implementation. Built-in numeric
    /// implementations multiply items in source order and return one for an empty
    /// input.
    /// Integer multiplication is checked and traps on overflow; floating-point
    /// multiplication follows the declared type's arithmetic. Custom implementations
    /// define their own rules.
    ///
    /// # Examples
