//! Numeric parsing, aggregation, explicit fixed-width integer policies and width-matched float utilities and math. Ordinary arithmetic remains checked and traps on overflow; integer methods explicitly select wrapping, checked Option, overflowing tuple or saturating results. Rotations use u32 counts modulo the receiver's width. Float utilities include classification, rounding, correctly rounded square root and exact bit reinterpretation; invalid clamp bounds trap. Extended trigonometric, exponential, logarithmic and power methods return ordinary numeric exceptional results, use radians for angles and have unspecified precision with no universal ULP bound or cross-platform or repeated-result bit-identity guarantee. Parsing and conversion failures use the declared Result error.
//!
//! # Examples
//!
//! ```kgr
//! fn parse(text: String) -> Result<i32, core::num::ParseError> { i32::from_str(text) }
//! ```

/// A numeric parsing error. Invalid input and out-of-range values are reported through Result.
///
/// # Examples
///
/// ```kgr
/// fn number(text: String) -> Result<i32, core::num::ParseError> { i32::from_str(text) }
/// ```
pub enum ParseError {
    /// The `Empty` case of `ParseError`. A numeric parsing error. Invalid input and out-of-range values are reported through Result.
    Empty,

    /// The `InvalidDigit` case of `ParseError`. A numeric parsing error. Invalid input and out-of-range values are reported through Result.
    InvalidDigit,

    /// The `OutOfRange` case of `ParseError`. A numeric parsing error. Invalid input and out-of-range values are reported through Result.
    OutOfRange,

    /// The `InvalidRadix` case of `ParseError`. A numeric parsing error. Invalid input and out-of-range values are reported through Result.
    InvalidRadix,

    /// The `InvalidSyntax` case of `ParseError`. A numeric parsing error. Invalid input and out-of-range values are reported through Result.
    InvalidSyntax,
}

/// A checked numeric conversion error. Its variants distinguish the declared failure conditions.
///
/// # Examples
///
/// ```kgr
/// fn narrow(value: i64) -> Result<i32, core::num::TryFromIntError> { i32::try_from(value) }
/// ```
pub enum TryFromIntError {
    /// The `OutOfRange` case of `TryFromIntError`. A checked numeric conversion error. Its variants distinguish the declared failure conditions.
    OutOfRange,
}

impl i8 {
    /// Return Some(sum) when the sum fits the receiver's range, or None on arithmetic overflow instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.checked_add(rhs); }
    /// ```
    pub fn checked_add(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(quotient), truncating toward zero. Return None for a zero divisor or signed MIN / -1 overflow instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.checked_div(rhs); }
    /// ```
    pub fn checked_div(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(product) when the product fits the receiver's range, or None on arithmetic overflow instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.checked_mul(rhs); }
    /// ```
    pub fn checked_mul(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(remainder) with the receiver's sign when nonzero. Return None for a zero divisor or signed MIN % -1, even though its mathematical remainder is zero, instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.checked_rem(rhs); }
    /// ```
    pub fn checked_rem(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(difference) when the difference fits the receiver's range, or None on arithmetic overflow or unsigned underflow instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.checked_sub(rhs); }
    /// ```
    pub fn checked_sub(self, rhs: i8) -> core::option::Option<i8>;

    /// Return (wrapped_sum, overflowed), wrapping modulo 2^width at the receiver's signedness. The flag reports arithmetic overflow in the receiver's range; signed overflow is not an unsigned carry flag. Overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.overflowing_add(rhs); }
    /// ```
    pub fn overflowing_add(self, rhs: i8) -> (i8, bool);

    /// Return (wrapped_product, overflowed), wrapping modulo 2^width at the receiver's signedness. The flag reports arithmetic overflow in the receiver's range, not an unsigned carry flag for signed receivers. Overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.overflowing_mul(rhs); }
    /// ```
    pub fn overflowing_mul(self, rhs: i8) -> (i8, bool);

    /// Return (wrapped_difference, overflowed), wrapping modulo 2^width at the receiver's signedness. The flag reports arithmetic overflow in the receiver's range, including unsigned underflow; signed overflow is not an unsigned borrow flag. Overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.overflowing_sub(rhs); }
    /// ```
    pub fn overflowing_sub(self, rhs: i8) -> (i8, bool);

    /// Rotate the receiver's fixed-width bit pattern left, moving high bits into low positions. The count is u32 and is reduced modulo the receiver's bit width; zero and multiples of the width leave the value unchanged. Signed results reinterpret the rotated bits at the same signedness. Unlike ordinary shifts, counts at or above the width do not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8) { val result = value.rotate_left(1u32); }
    /// ```
    pub fn rotate_left(self, count: u32) -> i8;

    /// Rotate the receiver's fixed-width bit pattern right, moving low bits into high positions. The count is u32 and is reduced modulo the receiver's bit width; zero and multiples of the width leave the value unchanged. Signed results reinterpret the rotated bits at the same signedness. Unlike ordinary shifts, counts at or above the width do not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8) { val result = value.rotate_right(1u32); }
    /// ```
    pub fn rotate_right(self, count: u32) -> i8;

    /// Return the sum saturated to the receiver's minimum or maximum when its mathematical value is out of range. Arithmetic overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.saturating_add(rhs); }
    /// ```
    pub fn saturating_add(self, rhs: i8) -> i8;

    /// Return the product saturated to the receiver's minimum or maximum when its mathematical value is out of range. Arithmetic overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.saturating_mul(rhs); }
    /// ```
    pub fn saturating_mul(self, rhs: i8) -> i8;

    /// Return the difference saturated to the receiver's minimum or maximum when its mathematical value is out of range. Unsigned subtraction saturates at zero. Arithmetic overflow does not trap.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.saturating_sub(rhs); }
    /// ```
    pub fn saturating_sub(self, rhs: i8) -> i8;

    /// Return the sum modulo 2^width, interpreted at the receiver's signedness. Arithmetic overflow wraps instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.wrapping_add(rhs); }
    /// ```
    pub fn wrapping_add(self, rhs: i8) -> i8;

    /// Return the product modulo 2^width, interpreted at the receiver's signedness. Arithmetic overflow wraps instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.wrapping_mul(rhs); }
    /// ```
    pub fn wrapping_mul(self, rhs: i8) -> i8;

    /// Return the difference modulo 2^width, interpreted at the receiver's signedness. Arithmetic overflow or unsigned underflow wraps instead of trapping.
    ///
    /// Operands must match the declared types exactly; widths and signedness are not implicitly converted. The receiver and argument are evaluated once, left to right. This method does not change the checked-trap behavior of ordinary arithmetic operators. Runtime and allocation errors still propagate.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example(value: i8, rhs: i8) { val result = value.wrapping_sub(rhs); }
    /// ```
    pub fn wrapping_sub(self, rhs: i8) -> i8;
}

