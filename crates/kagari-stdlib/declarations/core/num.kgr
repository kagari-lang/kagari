impl core::convert::TryFrom<i8> for u8 {
    type Error = TryFromIntError;

    /// Converts `i8` to `u8` when the value fits.
    ///
    /// Returns `TryFromIntError::OutOfRange` when the value is outside the target's
    /// representable range. No wrapping or truncation is performed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::num::TryFromIntError;
    /// fn main() -> bool {
    ///     val fits = match u8::try_from(42i8) {
    ///         Ok(value) => value == 42u8,
    ///         Err(_) => false,
    ///     };
    ///     val rejected = match u8::try_from(-1i8) {
    ///         Err(TryFromIntError::OutOfRange) => true,
    ///         _ => false,
    ///     };
    ///     fits && rejected
    /// }
    /// ```
    pub fn try_from(value: i8) -> core::result::Result<u8, TryFromIntError>;
}

