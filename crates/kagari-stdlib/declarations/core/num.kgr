    /// Return Some(remainder) with the receiver's sign when nonzero. Return None for a
    /// zero divisor or signed MIN % -1, even though its mathematical remainder is zero,
    /// instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7u64.checked_rem(2u64) == Some(1u64) &&
    ///         7u64.checked_rem(0u64) == None
    /// }
    /// ```
    pub fn checked_rem(self, rhs: u64) -> core::option::Option<u64>;

    /// Return Some(difference) when the difference fits the receiver's range, or None
    /// on arithmetic overflow or unsigned underflow instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7u64.checked_sub(2u64) == Some(5u64) &&
    ///         (0u64).checked_sub(1u64) == None
    /// }
    /// ```
    pub fn checked_sub(self, rhs: u64) -> core::option::Option<u64>;

    /// Return (wrapped_sum, overflowed), wrapping modulo 2^width at the receiver's
    /// signedness. The flag reports arithmetic overflow in the receiver's range; signed
    /// overflow is not an unsigned carry flag. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.overflowing_add(1u64) == (0u64, true) &&
    ///         2u64.overflowing_add(3u64) == (5u64, false)
    /// }
    /// ```
    pub fn overflowing_add(self, rhs: u64) -> (u64, bool);

    /// Return (wrapped_product, overflowed), wrapping modulo 2^width at the receiver's
    /// signedness. The flag reports arithmetic overflow in the receiver's range, not an
    /// unsigned carry flag for signed receivers. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.overflowing_mul(2u64) == (18446744073709551614u64, true)
    /// }
    /// ```
    pub fn overflowing_mul(self, rhs: u64) -> (u64, bool);

    /// Return (wrapped_difference, overflowed), wrapping modulo 2^width at the
    /// receiver's signedness. The flag reports arithmetic overflow in the receiver's
    /// range, including unsigned underflow; signed overflow is not an unsigned borrow
    /// flag. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0u64).overflowing_sub(1u64) == (18446744073709551615u64, true)
    /// }
    /// ```
    pub fn overflowing_sub(self, rhs: u64) -> (u64, bool);

    /// Rotate the receiver's fixed-width bit pattern left, moving high bits into low
    /// positions. The count is u32 and is reduced modulo the receiver's bit width; zero
    /// and multiples of the width leave the value unchanged. Signed results reinterpret
    /// the rotated bits at the same signedness. Unlike ordinary shifts, counts at or
    /// above the width do not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1u64.rotate_left(65u32) == 2u64 &&
