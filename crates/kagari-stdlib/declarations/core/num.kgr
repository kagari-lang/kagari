    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.saturating_add(1u64) == 18446744073709551615u64
    /// }
    /// ```
    pub fn saturating_add(self, rhs: u64) -> u64;

    /// Return the product saturated to the receiver's minimum or maximum when its
    /// mathematical value is out of range. Arithmetic overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.saturating_mul(2u64) == 18446744073709551615u64
    /// }
    /// ```
    pub fn saturating_mul(self, rhs: u64) -> u64;

    /// Return the difference saturated to the receiver's minimum or maximum when its
    /// mathematical value is out of range. Unsigned subtraction saturates at zero.
    /// Arithmetic overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0u64).saturating_sub(1u64) == 0u64
    /// }
    /// ```
    pub fn saturating_sub(self, rhs: u64) -> u64;

    /// Return the sum modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.wrapping_add(1u64) == 0u64
    /// }
    /// ```
    pub fn wrapping_add(self, rhs: u64) -> u64;

    /// Add a signed offset of the corresponding width to an unsigned receiver and
    /// return the unsigned result modulo 2^width. Overflow and underflow wrap instead
    /// of trapping. Available only on u8/i8, u16/i16, u32/i32 and u64/i64
    /// receiver/offset pairs.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     0u64.wrapping_add_signed(-1i64) == 18446744073709551615u64
    /// }
    /// ```
    pub fn wrapping_add_signed(self, rhs: i64) -> u64;

    /// Return the product modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     18446744073709551615u64.wrapping_mul(2u64) == 18446744073709551614u64
    /// }
    /// ```
    pub fn wrapping_mul(self, rhs: u64) -> u64;

    /// Return the difference modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow or unsigned underflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0u64).wrapping_sub(1u64) == 18446744073709551615u64
    /// }
    /// ```
    pub fn wrapping_sub(self, rhs: u64) -> u64;
