//! Numeric parsing, aggregation, explicit fixed-width integer policies and
//! width-matched float utilities and math. Ordinary arithmetic remains checked and
//! traps on overflow; integer methods explicitly select wrapping, checked Option,
//! overflowing tuple or saturating results. Rotations use u32 counts modulo the
//! receiver's width. Float utilities include classification, rounding, correctly
//! rounded square root and exact bit reinterpretation; invalid clamp bounds trap.
//! Extended trigonometric, exponential, logarithmic and power methods return
//! ordinary numeric exceptional results, use radians for angles and have
//! unspecified precision with no universal ULP bound or cross-platform or
//! repeated-result bit-identity guarantee. Parsing and conversion failures use the
//! declared Result error.
//!
//! # Examples
//!
//! ```kgr
//! use core::num::ParseError;
//!
//! fn main() -> bool {
//!     (
//!         match i32::from_str("42") {
//!             Ok(value) => value == 42,
//!             Err(_) => false,
//!         }
//!     ) &&
//!         (
//!         match i32::from_str("") {
//!             Err(ParseError::Empty) => true,
//!             _ => false,
//!         }
//!     ) &&
//!         (
//!         match i32::from_str("12x") {
//!             Err(ParseError::InvalidDigit) => true,
//!             _ => false,
//!         }
//!     )
//! }
//! ```

/// A numeric parsing error. Invalid input and out-of-range values are reported
/// through Result.
///
/// # Examples
///
/// ```kgr
/// use core::num::ParseError;
///
/// fn main() -> bool {
///     (
///         match i32::from_str("42") {
///             Ok(value) => value == 42,
///             Err(_) => false,
///         }
///     ) &&
///         (
///         match i32::from_str("") {
///             Err(ParseError::Empty) => true,
///             _ => false,
///         }
///     ) &&
///         (
///         match i32::from_str("12x") {
///             Err(ParseError::InvalidDigit) => true,
///             _ => false,
///         }
///     )
/// }
/// ```
pub enum ParseError {
    /// The input string contained no characters.
    Empty,

    /// An integer input contained a character not accepted as a decimal digit or sign
    /// at that position.
    InvalidDigit,

    /// The integer text denotes a value outside the destination type's range.
    OutOfRange,

    /// Reserved for an invalid radix request. The current decimal `FromStr`
    /// implementations do not emit this case.
    InvalidRadix,

    /// The input does not match the floating-point or boolean parser's syntax.
    InvalidSyntax,
}

/// A checked numeric conversion error. Its variants distinguish the declared
/// failure conditions.
///
/// # Examples
///
/// ```kgr
/// use core::num::TryFromIntError;
/// fn main() -> bool {
///     (match i32::try_from(42i64) { Ok(value) => value == 42i32, Err(_) => false, }) &&
///         (match i32::try_from(2147483648i64) { Err(TryFromIntError::OutOfRange) => true, _ => false, })
/// }
/// ```
pub enum TryFromIntError {
    /// The source value is not representable by the requested checked conversion.
    OutOfRange,
}

impl i8 {
    /// Return Some(sum) when the sum fits the receiver's range, or None on arithmetic
    /// overflow instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     2i8.checked_add(3i8) == Some(5i8) &&
    ///         127i8.checked_add(1i8) == None
    /// }
    /// ```
    pub fn checked_add(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(quotient), truncating toward zero. Return None for a zero divisor or
    /// signed MIN / -1 overflow instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7i8.checked_div(2i8) == Some(3i8) &&
    ///         7i8.checked_div(0i8) == None &&
    ///         (-128i8).checked_div(-1i8) == None
    /// }
    /// ```
    pub fn checked_div(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(product) when the product fits the receiver's range, or None on
    /// arithmetic overflow instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     2i8.checked_mul(3i8) == Some(6i8) &&
    ///         127i8.checked_mul(2i8) == None
    /// }
    /// ```
    pub fn checked_mul(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(remainder) with the receiver's sign when nonzero. Return None for a
    /// zero divisor or signed MIN % -1, even though its mathematical remainder is zero,
    /// instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7i8.checked_rem(2i8) == Some(1i8) &&
    ///         7i8.checked_rem(0i8) == None &&
    ///         (-128i8).checked_rem(-1i8) == None
    /// }
    /// ```
    pub fn checked_rem(self, rhs: i8) -> core::option::Option<i8>;

    /// Return Some(difference) when the difference fits the receiver's range, or None
    /// on arithmetic overflow or unsigned underflow instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7i8.checked_sub(2i8) == Some(5i8) &&
    ///         (-128i8).checked_sub(1i8) == None
    /// }
    /// ```
    pub fn checked_sub(self, rhs: i8) -> core::option::Option<i8>;

    /// Return (wrapped_sum, overflowed), wrapping modulo 2^width at the receiver's
    /// signedness. The flag reports arithmetic overflow in the receiver's range; signed
    /// overflow is not an unsigned carry flag. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.overflowing_add(1i8) == (-128i8, true) &&
    ///         2i8.overflowing_add(3i8) == (5i8, false)
    /// }
    /// ```
    pub fn overflowing_add(self, rhs: i8) -> (i8, bool);

    /// Return (wrapped_product, overflowed), wrapping modulo 2^width at the receiver's
    /// signedness. The flag reports arithmetic overflow in the receiver's range, not an
    /// unsigned carry flag for signed receivers. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.overflowing_mul(2i8) == (-2i8, true)
    /// }
    /// ```
    pub fn overflowing_mul(self, rhs: i8) -> (i8, bool);

    /// Return (wrapped_difference, overflowed), wrapping modulo 2^width at the
    /// receiver's signedness. The flag reports arithmetic overflow in the receiver's
    /// range, including unsigned underflow; signed overflow is not an unsigned borrow
    /// flag. Overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-128i8).overflowing_sub(1i8) == (127i8, true)
    /// }
    /// ```
    pub fn overflowing_sub(self, rhs: i8) -> (i8, bool);

    /// Rotate the receiver's fixed-width bit pattern left, moving high bits into low
    /// positions. The count is u32 and is reduced modulo the receiver's bit width; zero
    /// and multiples of the width leave the value unchanged. Signed results reinterpret
    /// the rotated bits at the same signedness. Unlike ordinary shifts, counts at or
    /// above the width do not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1i8.rotate_left(9u32) == 2i8 &&
    ///         1i8.rotate_left(8u32) == 1i8
    /// }
    /// ```
    pub fn rotate_left(self, count: u32) -> i8;

    /// Rotate the receiver's fixed-width bit pattern right, moving low bits into high
    /// positions. The count is u32 and is reduced modulo the receiver's bit width; zero
    /// and multiples of the width leave the value unchanged. Signed results reinterpret
    /// the rotated bits at the same signedness. Unlike ordinary shifts, counts at or
    /// above the width do not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     1i8.rotate_right(1u32) == -128i8 &&
    ///         1i8.rotate_right(8u32) == 1i8
    /// }
    /// ```
    pub fn rotate_right(self, count: u32) -> i8;

    /// Return the sum saturated to the receiver's minimum or maximum when its
    /// mathematical value is out of range. Arithmetic overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.saturating_add(1i8) == 127i8
    /// }
    /// ```
    pub fn saturating_add(self, rhs: i8) -> i8;

    /// Return the product saturated to the receiver's minimum or maximum when its
    /// mathematical value is out of range. Arithmetic overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.saturating_mul(2i8) == 127i8
    /// }
    /// ```
    pub fn saturating_mul(self, rhs: i8) -> i8;

    /// Return the difference saturated to the receiver's minimum or maximum when its
    /// mathematical value is out of range. Unsigned subtraction saturates at zero.
    /// Arithmetic overflow does not trap.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-128i8).saturating_sub(1i8) == -128i8
    /// }
    /// ```
    pub fn saturating_sub(self, rhs: i8) -> i8;

    /// Return the sum modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.wrapping_add(1i8) == -128i8
    /// }
    /// ```
    pub fn wrapping_add(self, rhs: i8) -> i8;

    /// Return the product modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     127i8.wrapping_mul(2i8) == -2i8
    /// }
    /// ```
    pub fn wrapping_mul(self, rhs: i8) -> i8;

    /// Return the difference modulo 2^width, interpreted at the receiver's signedness.
    /// Arithmetic overflow or unsigned underflow wraps instead of trapping.
    ///
    /// The receiver and operand use the exact declared integer types; no width or
    /// signedness conversion is implicit. Ordinary arithmetic operators keep their
    /// checked overflow behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (-128i8).wrapping_sub(1i8) == 127i8
    /// }
    /// ```
    pub fn wrapping_sub(self, rhs: i8) -> i8;
}

