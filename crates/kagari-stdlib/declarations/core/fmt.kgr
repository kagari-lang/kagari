//! Diagnostic and display formatting through declared interfaces.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     42.debug() == "42" && true.debug() == "true" && 'é'.debug() == "'é'"
//! }
//! ```

/// Produces a diagnostic string representation through `debug`. Formatting does not
/// permit reflective access outside declared members.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     42.debug() == "42" && true.debug() == "true" && 'é'.debug() == "'é'"
/// }
/// ```
#[lang = "debug"]
pub trait Debug {
    /// Produces a diagnostic string representation through `debug`. Formatting does not
    /// permit reflective access outside declared members.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     42.debug() == "42" && true.debug() == "true" && 'é'.debug() == "'é'"
    /// }
    /// ```
    fn debug(self) -> alloc::string::String;
}

/// Produces a user-facing string representation through `display`. Implementations
/// choose their formatting policy.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     42.display() == "42" && 'é'.display() == "é"
/// }
/// ```
#[lang = "display"]
pub trait Display {
    /// Produces a user-facing string representation through `display`. Implementations
    /// choose their formatting policy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     42.display() == "42" && 'é'.display() == "é"
    /// }
    /// ```
    fn display(self) -> alloc::string::String;
}
