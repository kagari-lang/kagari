//! Operator contracts, range values and boundary policies. Operators dispatch
//! through checked implementations and preserve evaluation order.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     2 + 3 == 5 && -2 + 3 == 1
//! }
//! ```

/// A range endpoint: Included(value), Excluded(value) or Unbounded.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn main() -> bool {
///     (1..=4).start_bound() == Bound::Included(1) &&
///         (1..=4).end_bound() == Bound::Included(4)
/// }
/// ```
pub enum Bound<T> {
    /// The endpoint value belongs to the range.
    Included(T),

    /// The endpoint value does not belong to the range.
    Excluded(T),

    /// There is no endpoint on this side of the range; no value is stored.
    Unbounded,
}

pub use self::Bound::{Included, Excluded, Unbounded};

/// Continue contains a successful value; Break contains an early-exit value. Try
/// uses ControlFlow<B, Infallible> as its distinct residual, preserving the break
/// value without conversion.
///
/// # Examples
///
/// ```kgr
/// use core::ops::ControlFlow;
/// fn main() -> bool {
///     val value: ControlFlow<String, i32> = ControlFlow::Continue(42);
///     match value {
///         ControlFlow::Continue(item) => item == 42,
///         ControlFlow::Break(_) => false,
///     }
/// }
/// ```
pub enum ControlFlow<T1, T2> {
    /// Contains the early-exit value of type `B`.
    Break(T1),

    /// Contains the normal continuation value of type `T`.
    Continue(T2),
}

/// A half-open range `start..end`, including start and excluding end. Integer
/// iteration is empty when start is at least end. The value stores endpoints;
/// iteration creates a fresh cursor.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val cursor = (2..4).iter();
///     cursor.next() == Some(2) && cursor.next() == Some(3) && cursor.next() == None &&
///         (4..2).iter().next() == None
/// }
/// ```
pub type Range<T>;

/// A closed range `start..=end`, including both endpoints. Integer iteration yields
/// the last representable endpoint once and then stops without overflowing.
/// Reversed ranges are empty.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val cursor = (254u8..=255u8).iter();
///     cursor.next() == Some(254u8) && cursor.next() == Some(255u8) && cursor.next() == None
/// }
/// ```
pub type RangeInclusive<T>;

/// A range `start..` with an included start and no end bound. Each iteration
/// creates a fresh ascending integer cursor.
///
/// # Traps
///
/// Open-ended iteration traps when advancing would exceed the integer type; it does
/// not wrap or become a finite inclusive range. Use `take` or a bounded range when
/// the consumer needs a finite sequence.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn main() -> bool {
///     val range = 2..;
///     val cursor = range.take(3u64);
///     range.end_bound() == Bound::Unbounded && cursor.next() == Some(2) &&
///         cursor.next() == Some(3) && cursor.next() == Some(4) && cursor.next() == None
/// }
/// ```
pub type RangeFrom<T>;

/// A range `..end` with no start bound and an excluded end. It implements
/// RangeBounds, but has no integer iteration because no start value is specified.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn main() -> bool {
///     val range = ..4;
///     range.start_bound() == Bound::Unbounded && range.end_bound() == Bound::Excluded(4)
/// }
/// ```
pub type RangeTo<T>;

/// A range `..=end` with no start bound and an included end. It implements
/// RangeBounds, but has no integer iteration because no start value is specified.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn main() -> bool {
///     val range = ..=4;
///     range.start_bound() == Bound::Unbounded && range.end_bound() == Bound::Included(4)
/// }
/// ```
pub type RangeToInclusive<T>;

/// The fully unbounded range `..`. It has no endpoint element type of its own.
/// RangeBounds can be selected for a caller's element type; this value is not an
/// integer iterator.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn inspect(value: core::ops::RangeBounds<i32>) -> bool {
///     value.start_bound() == Bound::Unbounded && value.end_bound() == Bound::Unbounded
/// }
/// fn main() -> bool {
///     inspect(..)
/// }
/// ```
pub type RangeFull;

/// Addition with an explicitly declared output type. Built-in integer arithmetic
/// traps on overflow; a user implementation defines its own behavior.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     2 + 3 == 5 && -2 + 3 == 1
/// }
/// ```
#[lang = "add"]
pub trait Add<T> {
    /// The result type of the declared operation.
    type Output;

    /// Addition with an explicitly declared output type. Built-in integer arithmetic
    /// traps on overflow; a user implementation defines its own behavior.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     2 + 3 == 5 && -2 + 3 == 1
    /// }
    /// ```
    fn add(self, arg1: T) -> <Self as Add<T>>::Output;
}

/// Subtraction with an explicitly declared output type. Built-in integer
/// subtraction traps on overflow.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     5 - 3 == 2 && 3 - 5 == -2
/// }
/// ```
#[lang = "sub"]
pub trait Sub<T> {
    /// The result type of the declared operation.
    type Output;

    /// Subtraction with an explicitly declared output type. Built-in integer
    /// subtraction traps on overflow.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     5 - 3 == 2 && 3 - 5 == -2
    /// }
    /// ```
    fn sub(self, arg1: T) -> <Self as Sub<T>>::Output;
}

/// Multiplication with an explicitly declared output type. Built-in integer
/// multiplication traps on overflow.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     3 * 4 == 12 && -3 * 4 == -12
/// }
/// ```
#[lang = "mul"]
pub trait Mul<T> {
    /// The result type of the declared operation.
    type Output;

    /// Multiplication with an explicitly declared output type. Built-in integer
    /// multiplication traps on overflow.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     3 * 4 == 12 && -3 * 4 == -12
    /// }
    /// ```
    fn mul(self, arg1: T) -> <Self as Mul<T>>::Output;
}

/// Division. Built-in integer division traps for zero divisors and signed overflow;
/// floating-point division follows its specified numeric semantics.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     7 / 2 == 3 && -7 / 2 == -3
/// }
/// ```
#[lang = "div"]
pub trait Div<T> {
    /// The result type of the declared operation.
    type Output;

    /// Division. Built-in integer division traps for zero divisors and signed overflow;
    /// floating-point division follows its specified numeric semantics.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7 / 2 == 3 && -7 / 2 == -3
    /// }
    /// ```
    fn div(self, arg1: T) -> <Self as Div<T>>::Output;
}

/// The remainder of division. Built-in integer remainder traps for zero divisors
/// and signed overflow.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     7 % 3 == 1 && -7 % 3 == -1
/// }
/// ```
#[lang = "rem"]
pub trait Rem<T> {
    /// The result type of the declared operation.
    type Output;

    /// The remainder of division. Built-in integer remainder traps for zero divisors
    /// and signed overflow.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7 % 3 == 1 && -7 % 3 == -1
    /// }
    /// ```
    fn rem(self, arg1: T) -> <Self as Rem<T>>::Output;
}

/// Bitwise conjunction, with an explicitly declared output type.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     0b1010 & 0b1100 == 0b1000
/// }
/// ```
#[lang = "bit_and"]
pub trait BitAnd<T> {
    /// The result type of the declared operation.
    type Output;

    /// Bitwise conjunction, with an explicitly declared output type.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0b1010 & 0b1100) == 0b1000
    /// }
    /// ```
    fn bitand(self, arg1: T) -> <Self as BitAnd<T>>::Output;
}

/// Bitwise disjunction, with an explicitly declared output type.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     0b1010 | 0b0001 == 0b1011
/// }
/// ```
#[lang = "bit_or"]
pub trait BitOr<T> {
    /// The result type of the declared operation.
    type Output;

    /// Bitwise disjunction, with an explicitly declared output type.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0b1010 | 0b0001) == 0b1011
    /// }
    /// ```
    fn bitor(self, arg1: T) -> <Self as BitOr<T>>::Output;
}

/// Bitwise exclusive disjunction, with an explicitly declared output type.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     0b1010 ^ 0b0011 == 0b1001
/// }
/// ```
#[lang = "bit_xor"]
pub trait BitXor<T> {
    /// The result type of the declared operation.
    type Output;

    /// Bitwise exclusive disjunction, with an explicitly declared output type.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (0b1010 ^ 0b0011) == 0b1001
    /// }
    /// ```
    fn bitxor(self, arg1: T) -> <Self as BitXor<T>>::Output;
}

/// Left shift. Built-in integer shifts validate the shift count and checked result.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     3 << 2u32 == 12
/// }
/// ```
#[lang = "shl"]
pub trait Shl<T> {
    /// The result type of the declared operation.
    type Output;

    /// Left shift. Built-in integer shifts validate the shift count and checked result.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (3 << 2) == 12
    /// }
    /// ```
    fn shl(self, arg1: T) -> <Self as Shl<T>>::Output;
}

/// Right shift. Built-in integer shifts validate the shift count.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     12 >> 2u32 == 3
/// }
/// ```
#[lang = "shr"]
pub trait Shr<T> {
    /// The result type of the declared operation.
    type Output;

    /// Right shift. Built-in integer shifts validate the shift count.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     (12 >> 2) == 3
    /// }
    /// ```
    fn shr(self, arg1: T) -> <Self as Shr<T>>::Output;
}

/// Arithmetic negation. Negating the minimum signed integer traps on overflow.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val value = 7;
///     -value == -7
/// }
/// ```
#[lang = "neg"]
pub trait Neg {
    /// The result type of the declared operation.
    type Output;

    /// Arithmetic negation. Negating the minimum signed integer traps on overflow.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val value = 7;
    ///     -value == -7
    /// }
    /// ```
    fn neg(self) -> <Self as Neg>::Output;
}

/// Logical or bitwise inversion, depending on the receiver type. The output is
/// declared by the implementation.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     !false && !!true
/// }
/// ```
#[lang = "not"]
pub trait Not {
    /// The result type of the declared operation.
    type Output;

    /// Logical or bitwise inversion, depending on the receiver type. The output is
    /// declared by the implementation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     !false && !!true
    /// }
    /// ```
    fn not(self) -> <Self as Not>::Output;
}

/// Indexed read access. Built-in sequence indexing traps when the index is out of
/// bounds; `get` provides an optional result instead.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values = Vec::from([4, 5]);
///     values[0u64] == 4 && values[1u64] == 5
/// }
/// ```
#[lang = "index"]
pub trait Index<T> {
    /// The result type of the declared operation.
    type Output;

    /// Indexed read access. Built-in sequence indexing traps when the index is out of
    /// bounds; `get` provides an optional result instead.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([10, 20]);
    ///     values[0u64] == 10 && values[1u64] == 20
    /// }
    /// ```
    fn index(self, arg1: T) -> <Self as Index<T>>::Output;
}

/// A checked callable signature. Calls evaluate arguments left to right exactly
/// once. Stored callable values retain their selected generation across reload.
///
/// # Examples
///
/// ```kgr
/// fn apply<F: Fn(i32) -> i32>(f: F, value: i32) -> i32 {
///     f(value)
/// }
/// fn main() -> bool {
///     apply(|value| value * 2, 21) == 42
/// }
/// ```
#[lang = "fn"]
pub trait Fn<T> {
    /// The result type of the declared operation.
    type Output;

    /// A checked callable signature. Calls evaluate arguments left to right exactly
    /// once. Stored callable values retain their selected generation across reload.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn apply<F: Fn(i32) -> i32>(f: F, value: i32) -> i32 {
    ///     f(value)
    /// }
    /// fn main() -> bool {
    ///     apply(|value| value * 2, 21) == 42
    /// }
    /// ```
    fn call(self, arg1: T) -> <Self as Fn<T>>::Output;
}

/// Exposes the start and end bounds of a range as Included, Excluded or Unbounded.
/// Constructing bounds does not iterate the range.
///
/// # Examples
///
/// ```kgr
/// use core::ops::Bound;
/// fn main() -> bool {
///     (1..4).start_bound() == Bound::Included(1) &&
///         (1..4).end_bound() == Bound::Excluded(4)
/// }
/// ```
pub trait RangeBounds<T> {
    /// Return the lower bound with its inclusion policy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::Bound;
    /// fn main() -> bool {
    ///     (1..4).start_bound() == Bound::Included(1) && (..4).start_bound() == Bound::Unbounded
    /// }
    /// ```
    fn start_bound(self) -> Bound<T>;

    /// Return the upper bound with its inclusion policy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::Bound;
    /// fn main() -> bool {
    ///     (1..4).end_bound() == Bound::Excluded(4) && (1..=4).end_bound() == Bound::Included(4)
    /// }
    /// ```
    fn end_bound(self) -> Bound<T>;
}

/// Defines the successful Output and distinct Residual of a carrier. Question-mark
/// evaluates the value and branch once: Continue produces Output, while Break
/// passes Residual to the enclosing return type's FromResidual implementation.
/// Traps are not converted to residuals.
///
/// # Examples
///
/// ```kgr
/// fn doubled(value: Option<i32>) -> Option<i32> {
///     Some(value? * 2)
/// }
/// fn main() -> bool {
///     doubled(Some(21)) == Some(42) && doubled(None) == None
/// }
/// ```
#[lang = "try"]
pub trait Try: FromResidual<<Self as Try>::Residual> {
    /// The result type of the declared operation.
    type Output;

    /// The distinct early-return type passed to FromResidual; successful Output values are not residuals.
    type Residual;

    /// Construct a successful carrier from Output.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     Option<i32>::from_output(42) == Some(42)
    /// }
    /// ```
    fn from_output(output: <Self as Try>::Output) -> Self;

    /// Consume the carrier once and return Continue(Output) or Break(Residual).
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::ControlFlow;
    /// fn main() -> bool {
    ///     val value: Option<i32> = Some(42);
    ///     match value.branch() {
    ///         ControlFlow::Continue(item) => item == 42,
    ///         ControlFlow::Break(_) => false,
    ///     }
    /// }
    /// ```
    fn branch(self) -> ControlFlow<<Self as Try>::Residual, <Self as Try>::Output>;
}

/// Constructs the enclosing return value on early propagation. Residual types
/// distinguish Option, Result and ControlFlow. Result converts only the error
/// through one infallible From implementation, preserving its original failure
/// trace.
///
/// # Examples
///
/// ```kgr
/// fn widen(value: Result<i32, String>) -> Result<i64, String> {
///     Ok(i64::from(value?))
/// }
/// fn main() -> bool {
///     widen(Ok(42)) == Ok(42i64) && widen(Err("missing")) == Err("missing")
/// }
/// ```
#[lang = "from_residual"]
pub trait FromResidual<T> {
    /// Construct the enclosing early-return value from a compatible Residual.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val residual: Option<core::convert::Infallible> = None;
    ///     val result: Option<i32> = Option<i32>::from_residual(residual);
    ///     result == None
    /// }
    /// ```
    fn from_residual(residual: T) -> Self;
}

impl<T> RangeBounds<T> for Range<T> {
    /// Return the lower bound with its inclusion policy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::Bound;
    /// fn main() -> bool {
    ///     (1..4).start_bound() == Bound::Included(1) && (..4).start_bound() == Bound::Unbounded
    /// }
    /// ```
    pub fn start_bound(self) -> Bound<T>;

    /// Return the upper bound with its inclusion policy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::Bound;
    /// fn main() -> bool {
    ///     (1..4).end_bound() == Bound::Excluded(4) && (1..=4).end_bound() == Bound::Included(4)
    /// }
    /// ```
    pub fn end_bound(self) -> Bound<T>;
}

impl core::iter::Iterable for Range<i8> {
    type Item = i8;

    type Iter = core::iter::CollectionCursor<i8>;

    /// Returns a cursor over this value's items.
    ///
    /// The cursor's `Item` type equals this iterable's `Item`. Collection
    /// implementations
    /// normally return a fresh cursor at the beginning. Calling `iter` on an iterator
    /// returns that iterator with its current progress; it does not rewind or clone it.
    /// Custom implementations choose how to obtain their cursor.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3]);
    ///     val cursor = values.iter();
    ///     cursor.next();
    ///     cursor.count() == 2u64 && values.count() == 3u64
    /// }
    /// ```
    pub fn iter(self) -> core::iter::CollectionCursor<i8>;
}

