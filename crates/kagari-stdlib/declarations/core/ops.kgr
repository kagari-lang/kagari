impl<T1, T2> Try for ControlFlow<T1, T2> {
    type Output = T2;

    type Residual = ControlFlow<T1, core::convert::Infallible>;

    /// Construct a successful carrier from Output.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     Option<i32>::from_output(42) == Some(42)
    /// }
    /// ```
    pub fn from_output(output: T2) -> ControlFlow<T1, T2>;

    /// Consume the carrier once and return Continue(Output) or Break(Residual).
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::ControlFlow;
    /// fn main() -> bool {
    ///     val value: Option<i32> = Some(42);
    ///     match value.branch() {
    ///         ControlFlow::Continue(item) => item == 42,
    ///         ControlFlow::Break(_) => false,
    ///     }
    /// }
    /// ```
    pub fn branch(self) -> ControlFlow<ControlFlow<T1, core::convert::Infallible>, T2>;
}

impl<T1, T2> FromResidual<ControlFlow<T1, core::convert::Infallible>> for ControlFlow<T1, T2> {
    /// Construct the enclosing early-return value from a compatible Residual.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val residual: Option<core::convert::Infallible> = None;
    ///     val result: Option<i32> = Option<i32>::from_residual(residual);
    ///     result == None
    /// }
    /// ```
    pub fn from_residual(residual: ControlFlow<T1, core::convert::Infallible>) -> ControlFlow<T1, T2>;
}
