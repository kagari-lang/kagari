    type Item = T2;
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<T2>;
}

impl<T> Iterator for SkipIterator<T> {
    type Item = T;
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<T>;
}

impl<T> Iterator for EnumerateIterator<T> {
    type Item = (u64, T);
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<(u64, T)>;
}

impl<T1, T2> Iterator for ZipIterator<T1, T2> {
    type Item = (T1, T2);
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<(T1, T2)>;
