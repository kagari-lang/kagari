//! Shared iteration and iterable construction. Iterator values retain progress and reject stale source reads after structural mutation.
//!
//! # Examples
//!
//! ```kgr
//! fn total<I: Iterable<Item = i32>>(values: I) -> i32 { values.filter(|item| item > 0).sum() }
//! ```

/// A shared built-in cursor. Copies share progress. next returns None when exhausted; structural source edits invalidate subsequent reads.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.iter().next() }
/// ```
pub type CollectionCursor<T>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type MapIterator<T1, T2>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type FilterIterator<T>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type TakeIterator<T>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type FilterMapIterator<T1, T2>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type SkipIterator<T>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type EnumerateIterator<T>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type ZipIterator<T1, T2>;

/// A lazy shared cursor. Retains its sources, any callbacks and selected next targets; aliases share progress and original generations. Recursive next on the same cursor traps.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.map(|x| x + 1).filter(|x| x > 0).take(1u64).next() }
/// ```
pub type ChainIterator<T>;

/// A shared cursor. `next` advances once and returns `Some(item)`, or `None` to stop the current consumption. A custom cursor can resume after None. Copies share progress; previously completed effects survive a failure.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.iter().next() }
/// ```
#[lang = "iterator"]
pub trait Iterator {
    /// The item yielded by this iterator or iterable.
    type Item;
    /// A shared cursor. `next` advances once and returns `Some(item)`, or `None` to stop the current consumption. A custom cursor can resume after None. Copies share progress; previously completed effects survive a failure.
    ///
    /// See `Iterator` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn first(values: Vec<i32>) -> Option<i32> { values.iter().next() }
    /// ```
    fn next(self) -> core::option::Option<<Self as Iterator>::Item>;
}

/// Produces an iterator with the same Item and supplies the finite lazy transformation and terminal defaults. Iterator identity adaptation shares this API and cursor progress. Creating an adapter does not consume an item or run a callback. Structural source edits commit and invalidate subsequent cursor reads.
///
/// # Examples
///
/// ```kgr
/// fn total<I: Iterable<Item = i32>>(values: I) -> i32 { values.filter(|item| item > 0).sum() }
/// ```
#[lang = "iterable"]
pub trait Iterable {
    /// The item yielded by this iterator or iterable.
    type Item;
    /// The iterator produced by iter; its Item equals this iterable's Item.
    type Iter: Iterator<Item = <Self as Iterable>::Item>;
    /// Produces an iterator with the same Item and supplies the finite lazy transformation and terminal defaults. Iterator identity adaptation shares this API and cursor progress. Creating an adapter does not consume an item or run a callback. Structural source edits commit and invalidate subsequent cursor reads.
    ///
    /// See `Iterable` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn total<I: Iterable<Item = i32>>(values: I) -> i32 { values.filter(|item| item > 0).sum() }
    /// ```
    fn iter(self) -> <Self as Iterable>::Iter;
    /// Lazily transform each element with the callback. Obtain the source cursor once; copies share progress.
    fn map<T>(self, callback: fn(<Self as Iterable>::Item) -> T) -> MapIterator<<Self as Iterable>::Item, T> {
        __default_8_Iterable_map::<Self, <Self as Iterable>::Item, T, <Self as Iterable>::Iter>(self, callback)
    }
    /// Lazily return elements accepted by the predicate, preserving source order and callback effects.
    fn filter(self, callback: fn(<Self as Iterable>::Item) -> bool) -> FilterIterator<<Self as Iterable>::Item> {
        __default_8_Iterable_filter::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, callback)
    }
    /// Lazily return at most limit elements. A zero limit never advances the source.
    fn take(self, limit: u64) -> TakeIterator<<Self as Iterable>::Item> {
        __default_8_Iterable_take::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, limit)
    }
    /// Lazily return the callback's Some values in source order, without fusing the source.
    fn filter_map<T>(self, callback: fn(<Self as Iterable>::Item) -> core::option::Option<T>) -> FilterMapIterator<<Self as Iterable>::Item, T> {
        __default_8_Iterable_filter_map::<Self, <Self as Iterable>::Item, T, <Self as Iterable>::Iter>(self, callback)
    }
    /// Discard only the initial count items; aliases share the remaining skip state.
    fn skip(self, count: u64) -> SkipIterator<<Self as Iterable>::Item> {
        __default_8_Iterable_skip::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, count)
    }
    /// Lazily pair each item with its checked u64 position, starting at zero.
    fn enumerate(self) -> EnumerateIterator<<Self as Iterable>::Item> {
        __default_8_Iterable_enumerate::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self)
    }
    /// Lazily pull left then right and return pairs. A left item stays consumed if right returns None.
    fn zip<T>(self, other: T) -> ZipIterator<<Self as Iterable>::Item, <T as Iterable>::Item> where T: Iterable {
        __default_8_Iterable_zip::<Self, <Self as Iterable>::Item, T, <T as Iterable>::Item, <Self as Iterable>::Iter, <T as Iterable>::Iter>(self, other)
    }
    /// Lazily traverse the first cursor, then switch permanently to the second on its first None.
    fn chain<T>(self, other: T) -> ChainIterator<<Self as Iterable>::Item> where T: Iterable<Item = <Self as Iterable>::Item> {
        __default_8_Iterable_chain::<Self, <Self as Iterable>::Item, T, <Self as Iterable>::Iter, <T as Iterable<Item = <Self as Iterable>::Item>>::Iter>(self, other)
    }
    /// Consume through the requested destination's from_iter implementation; preserve its checked construction and arithmetic semantics.
    fn collect<T>(self) -> T where T: FromIterator<<Self as Iterable>::Item> {
        __default_8_Iterable_collect::<Self, <Self as Iterable>::Item, T>(self)
    }
    /// Consume through the requested destination's sum implementation; preserve its checked construction and arithmetic semantics.
    fn sum<T>(self) -> T where T: Sum<<Self as Iterable>::Item> {
        __default_8_Iterable_sum::<Self, <Self as Iterable>::Item, T>(self)
    }
    /// Consume through the requested destination's product implementation; preserve its checked construction and arithmetic semantics.
    fn product<T>(self) -> T where T: Product<<Self as Iterable>::Item> {
        __default_8_Iterable_product::<Self, <Self as Iterable>::Item, T>(self)
    }
    /// Consume in source order, passing the accumulator and each item to the callback. Empty input returns initial; completed source/callback effects survive failure.
    fn fold<T>(self, initial: T, callback: fn(T, <Self as Iterable>::Item) -> T) -> T {
        __default_8_Iterable_fold::<Self, <Self as Iterable>::Item, T, <Self as Iterable>::Iter>(self, initial, callback)
    }
    /// Consume until the first None and return the checked u64 count.
    fn count(self) -> u64 {
        __default_8_Iterable_count::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self)
    }
    /// Return the first matching item, stopping immediately; empty input returns None.
    fn find(self, callback: fn(<Self as Iterable>::Item) -> bool) -> core::option::Option<<Self as Iterable>::Item> {
        __default_8_Iterable_find::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, callback)
    }
    /// Stop at the first true predicate; empty input returns false.
    fn any(self, callback: fn(<Self as Iterable>::Item) -> bool) -> bool {
        __default_8_Iterable_any::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, callback)
    }
