        __default_8_Iterable_for_each::<Self, <Self as Iterable>::Item, <Self as Iterable>::Iter>(self, callback)
    }
}

/// Constructs a value by consuming an iterable in order. Each item is read once. A failure retains already completed source and callback effects.
///
/// # Examples
///
/// ```kgr
/// fn collect(values: Vec<i32>) -> Vec<i32> { Vec<i32>::from_iter(values) }
/// ```
pub trait FromIterator<T> {
    /// Constructs a value by consuming an iterable in order. Each item is read once. A failure retains already completed source and callback effects.
    ///
    /// See `FromIterator` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn collect(values: Vec<i32>) -> Vec<i32> { Vec<i32>::from_iter(values) }
    /// ```
    fn from_iter<M>(source: M) -> Self where M: Iterable<Item = T>;
}

/// Aggregates an iterable using addition. Built-in numeric sums use the additive identity for an empty input and checked arithmetic where required.
///
/// # Examples
///
/// ```kgr
/// fn total(values: Vec<i32>) -> i32 { i32::sum(values) }
/// ```
pub trait Sum<T> {
    /// Aggregates an iterable using addition. Built-in numeric sums use the additive identity for an empty input and checked arithmetic where required.
    ///
    /// See `Sum` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn total(values: Vec<i32>) -> i32 { i32::sum(values) }
    /// ```
    fn sum<M>(source: M) -> Self where M: Iterable<Item = T>;
}

/// Aggregates an iterable using multiplication. Built-in numeric products use the multiplicative identity for an empty input and checked arithmetic where required.
///
/// # Examples
///
/// ```kgr
/// fn multiply(values: Vec<i32>) -> i32 { i32::product(values) }
/// ```
pub trait Product<T> {
    /// Aggregates an iterable using multiplication. Built-in numeric products use the multiplicative identity for an empty input and checked arithmetic where required.
    ///
    /// See `Product` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn multiply(values: Vec<i32>) -> i32 { i32::product(values) }
    /// ```
    fn product<M>(source: M) -> Self where M: Iterable<Item = T>;
}

impl<T> Iterator for CollectionCursor<T> {
    type Item = T;
    /// A shared cursor. `next` advances once and returns `Some(item)`, or `None` to stop the current consumption. A custom cursor can resume after None. Copies share progress; previously completed effects survive a failure.
    ///
    /// See `Iterator` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn first(values: Vec<i32>) -> Option<i32> { values.iter().next() }
    /// ```
    pub fn next(self) -> core::option::Option<T>;
}

impl<T1, T2> Iterator for MapIterator<T1, T2> {
    type Item = T2;
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<T2>;
}

impl<T> Iterator for FilterIterator<T> {
    type Item = T;
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<T>;
}

impl<T> Iterator for TakeIterator<T> {
    type Item = T;
    /// Advance the retained source lazily. Recursive advancement of this cursor traps; completed source and callback effects survive failure.
    pub fn next(self) -> core::option::Option<T>;
}

