    ///
    /// Recursive `next` on the same adapter traps. Source, callback and checked-counter
    /// traps propagate without rolling back completed effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn example() -> Option<i32> {
    ///     Vec::from([1, 2]).take(0u64).next() // None.
