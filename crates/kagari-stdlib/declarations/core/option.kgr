//! Optional values: Some contains a value; None represents absence. Question-mark
//! propagation preserves the enclosing Option result.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values = Vec::from([4, 5]);
//!     values.get(0u64) == Some(4) && values.get(2u64) == None
//! }
//! ```

/// An optional value: Some carries one value and None carries none. Question-mark
/// propagation returns None early.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values = Vec::from([4, 5]);
///     values.get(0u64) == Some(4) && values.get(2u64) == None
/// }
/// ```
pub enum Option<T> {
    /// Contains the present value of type `T`.
    Some(T),

    /// Represents absence and carries no value. `?` returns this case early from an
    /// Option-returning function.
    None,
}

pub use self::Option::{Some, None};

impl<T> core::ops::Try for Option<T> {
    type Output = T;

    type Residual = Option<core::convert::Infallible>;

    /// Construct a successful carrier from Output.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     Option<i32>::from_output(42) == Some(42)
    /// }
    /// ```
    pub fn from_output(output: T) -> Option<T>;

    /// Consume the carrier once and return Continue(Output) or Break(Residual).
    ///
    /// # Examples
    ///
    /// ```kgr
    /// use core::ops::ControlFlow;
    /// fn main() -> bool {
    ///     val value: Option<i32> = Some(42);
    ///     match value.branch() {
    ///         ControlFlow::Continue(item) => item == 42,
    ///         ControlFlow::Break(_) => false,
    ///     }
    /// }
    /// ```
    pub fn branch(self) -> core::ops::ControlFlow<Option<core::convert::Infallible>, T>;
}

impl<T> core::ops::FromResidual<Option<core::convert::Infallible>> for Option<T> {
    /// Construct the enclosing early-return value from a compatible Residual.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val residual: Option<core::convert::Infallible> = None;
    ///     val result: Option<i32> = Option<i32>::from_residual(residual);
    ///     result == None
    /// }
    /// ```
    pub fn from_residual(residual: Option<core::convert::Infallible>) -> Option<T>;
}

impl<T> core::default::Default for Option<T> {
    /// Returns None. The element type does not need to implement Default.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// struct Element {}
    /// fn main() -> bool {
    ///     val value = Option<Element>::default();
    ///     match value { None => true, Some(_) => false }
    /// }
    /// ```
    pub fn default() -> Option<T>;
}
