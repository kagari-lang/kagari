//! Optional values: Some contains a value; None represents absence. Question-mark propagation preserves the enclosing Option result.
//!
//! # Examples
//!
//! ```kgr
//! fn first(values: Vec<i32>) -> Option<i32> { values.get(0) }
//! ```

/// An optional value: Some carries one value and None carries none. Question-mark propagation returns None early.
///
/// # Examples
///
/// ```kgr
/// fn first(values: Vec<i32>) -> Option<i32> { values.get(0) }
/// ```
pub enum Option<T> {
    /// The `Some` case of `Option`. An optional value: Some carries one value and None carries none. Question-mark propagation returns None early.
    Some(T),
    /// The `None` case of `Option`. An optional value: Some carries one value and None carries none. Question-mark propagation returns None early.
    None,
}

pub use self::Option::{Some, None};

impl<T> core::ops::Try for Option<T> {
    type Output = T;
    type Residual = Option<core::convert::Infallible>;
    /// Construct a successful carrier from Output.
    ///
    /// See `Try` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn unwrap(value: Option<i32>) -> Option<i32> { Some(value?) }
    /// ```
    pub fn from_output(output: T) -> Option<T>;
    /// Consume the carrier once and return Continue(Output) or Break(Residual).
    ///
    /// See `Try` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn unwrap(value: Option<i32>) -> Option<i32> { Some(value?) }
    /// ```
    pub fn branch(self) -> core::ops::ControlFlow<Option<core::convert::Infallible>, T>;
}

impl<T> core::ops::FromResidual<Option<core::convert::Infallible>> for Option<T> {
    /// Construct the enclosing early-return value from a compatible Residual.
    ///
    /// See `FromResidual` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn forward(value: Result<i32, String>) -> Result<i64, String> { Ok(i64::from(value?)) }
    /// ```
    pub fn from_residual(residual: Option<core::convert::Infallible>) -> Option<T>;
}

impl<T> core::default::Default for Option<T> {
    /// Return Option<T>::None using the checked Option enum identity. T need not implement Default.
    ///
    /// See `core::default::Default` for the construction contract.
    pub fn default() -> Option<T>;
}
