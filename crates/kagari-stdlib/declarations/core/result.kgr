//! Success and failure values. Question-mark propagation returns an error early and uses a declared From conversion where needed.
//!
//! # Examples
//!
//! ```kgr
//! fn parse(text: String) -> Result<i32, core::num::ParseError> { i32::from_str(text) }
//! ```

/// A checked outcome: Ok carries the successful value and Err carries the error. Question-mark propagation returns a converted error early.
///
/// # Examples
///
/// ```kgr
/// fn read(text: String) -> Result<i32, core::num::ParseError> { i32::from_str(text) }
/// ```
pub enum Result<T1, T2> {
    /// The `Ok` case of `Result`. A checked outcome: Ok carries the successful value and Err carries the error. Question-mark propagation returns a converted error early.
    Ok(T1),

    /// The `Err` case of `Result`. A checked outcome: Ok carries the successful value and Err carries the error. Question-mark propagation returns a converted error early.
    Err(T2),
}

pub use self::Result::{Ok, Err};

impl<T1, T2> core::ops::Try for Result<T1, T2> {
    type Output = T1;

    type Residual = Result<core::convert::Infallible, T2>;

    /// Construct a successful carrier from Output.
    ///
    /// See `Try` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn unwrap(value: Option<i32>) -> Option<i32> { Some(value?) }
    /// ```
    pub fn from_output(output: T1) -> Result<T1, T2>;

    /// Consume the carrier once and return Continue(Output) or Break(Residual).
    ///
    /// See `Try` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn unwrap(value: Option<i32>) -> Option<i32> { Some(value?) }
    /// ```
    pub fn branch(self) -> core::ops::ControlFlow<Result<core::convert::Infallible, T2>, T1>;
}

impl<T1, T2, T3> core::ops::FromResidual<Result<core::convert::Infallible, T3>> for Result<T1, T2> where T2: core::convert::From<T3> {
    /// Construct the enclosing early-return value from a compatible Residual.
    ///
    /// See `FromResidual` for the behavioral contract and examples.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn forward(value: Result<i32, String>) -> Result<i64, String> { Ok(i64::from(value?)) }
    /// ```
    pub fn from_residual(residual: Result<core::convert::Infallible, T3>) -> Result<T1, T2>;
}
