//! Shared mutable sequences with checked indexing, iteration and collection
//! algorithms. Readonly views do not freeze aliases.
//!
//! # Examples
//!
//! ```kgr
//! fn main() -> bool {
//!     val values = Vec::from([10, 20]);
//!     values.len() == 2u64 && values.get(0u64) == Some(10) && values.get(2u64) == None
//! }
//! ```

/// A shared mutable sequence. Copies retain the same storage identity. Indexing
/// traps out of bounds; get returns None. Structural mutation honors active borrows
/// and invalidates existing cursors.
///
/// # Examples
///
/// ```kgr
/// fn main() -> bool {
///     val values = Vec::from([1, 2]);
///     val alias = values;
///     values.push(3);
///     alias.len() == 3u64 && alias.get(2u64) == Some(3)
/// }
/// ```
pub type Vec<T>;

impl<T> Vec<T> {
    /// Remove all entries after validating structural mutation guards and return the
    /// same Vec.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2]);
    ///     val returned = values.clear();
    ///     returned.push(9);
    ///     values.len() == 1u64 && values.get(0u64) == Some(9)
    /// }
    /// ```
    pub fn clear(self) -> Vec<T>;

    /// Copy an array into fresh mutable sequence storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val source = [1, 2];
    ///     val values = Vec::from(source);
    ///     values.push(3);
    ///     source.len() == 2u64 && values.len() == 3u64 && values.get(1u64) == Some(2)
    /// }
    /// ```
    pub fn from(array: [T]) -> Vec<T>;

    /// Insert at the given position and return the same Vec. An index beyond the length
    /// traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([10, 30]);
    ///     val returned = values.insert(1u64, 20);
    ///     values.get(1u64) == Some(20) && returned.get(2u64) == Some(30)
    /// }
    /// ```
    pub fn insert(self, arg1: u64, arg2: T) -> Vec<T>;

    /// Create fresh empty mutable sequence storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val left: Vec<i32> = Vec::new();
    ///     val right: Vec<i32> = Vec::new();
    ///     left.push(7);
    ///     left.get(0u64) == Some(7) && right.is_empty()
    /// }
    /// ```
    pub fn new() -> Vec<T>;

    /// Append one item and return the same Vec. A guarded structural edit traps before
    /// committing the edit.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: Vec<i32> = Vec::new();
    ///     val returned = values.push(7);
    ///     returned.push(8);
    ///     values.len() == 2u64 && values.get(1u64) == Some(8)
    /// }
    /// ```
    pub fn push(self, arg1: T) -> Vec<T>;

    /// Replace the item at an existing index and return the same Vec. An out-of-bounds
    /// index traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([10, 20]);
    ///     val returned = values.set(1u64, 99);
    ///     returned.get(1u64) == Some(99) && values.len() == 2u64 && values.get(0u64) == Some(10)
    /// }
    /// ```
    pub fn set(self, arg1: u64, arg2: T) -> Vec<T>;
}

impl<T> std::collections::List<T> for Vec<T> {
    /// Return the number of entries.
    ///
    /// Counts elements as u64, not bytes. Reading through this view does not freeze
    /// the storage; mutations through other aliases can change a later result.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::List<i32> = Vec::from([10, 20]);
    ///     values.len() == 2u64
    /// }
    /// ```
    pub fn len(self) -> u64;

    /// Return whether the collection has no entries.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val storage: Vec<i32> = Vec::new();
    ///     val empty: std::collections::List<i32> = storage;
    ///     val one: std::collections::List<i32> = Vec::from([1]);
    ///     empty.is_empty() && !one.is_empty()
    /// }
    /// ```
    pub fn is_empty(self) -> bool;

    /// Return the requested value, or None if the index or key is absent.
    ///
    /// The argument is a zero-based element index. Returns Some(value) below len and
    /// None otherwise, including on empty input. In contrast, indexing with [] traps
    /// for an invalid index. Referenced element values retain their shared identity.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::List<i32> = Vec::from([10, 20]);
    ///     values.get(1u64) == Some(20) && values.get(2u64) == None
    /// }
    /// ```
    pub fn get(self, arg1: u64) -> core::option::Option<T>;

    /// Returns a new List in ascending `Ord` order.
    ///
    /// Equal elements keep their relative order. The original slots are unchanged;
    /// elements themselves are copied as values, so referenced objects remain shared.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([3, 1, 2]);
    ///     val result = input.sorted();
    ///     result.get(0u64) == Some(1) && result.get(2u64) == Some(3) && input.get(0u64) == Some(3)
    /// }
    /// ```
    pub fn sorted(self) -> std::collections::List<T> where T: core::cmp::Ord;

    /// Returns a new List ordered by `callback(left, right)`.
    ///
    /// The callback returns Less, Equal or Greater and must define a consistent order.
    /// Equal elements keep their relative order. Original slots are unchanged, but
    /// completed callback effects survive a later trap.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 3, 2]);
    ///     val result = input.sorted_by(|left, right| right.cmp(left));
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    pub fn sorted_by(self, callback: fn(T, T) -> core::cmp::Ordering) -> std::collections::List<T>;

    /// Returns a new List ordered by the keys produced by `callback`.
    ///
    /// Keys are evaluated during comparisons, without caching. A callback can run
    /// more than once for an element; it must yield a consistent ordering. Equal keys
    /// keep their original element order. Original slots are unchanged.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 3, 2]);
    ///     val result = input.sorted_by_key(|value| -value);
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    pub fn sorted_by_key<M>(self, callback: fn(T) -> M) -> std::collections::List<T> where M: core::cmp::Ord;

    /// Returns a new List in reverse input order.
    ///
    /// Original slots are unchanged. Empty and single-element lists retain their
    /// contents. Referenced elements are shared rather than deeply cloned.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([1, 2, 3]);
    ///     val result = input.reversed();
    ///     result.get(0u64) == Some(3) && result.get(2u64) == Some(1) && input.get(0u64) == Some(1)
    /// }
    /// ```
    pub fn reversed(self) -> std::collections::List<T>;

    /// Returns the first occurrence of each equal element in input order.
    ///
    /// Equality uses `Eq`; no Hash bound is required. Unlike `dedup`, nonadjacent
    /// duplicates are removed too. Original slots are unchanged; callback effects
    /// from equality checks are not rolled back on failure.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val input = Vec::from([2, 1, 2, 1, 3]);
    ///     val result = input.distinct();
    ///     result.len() == 3u64 && result.get(0u64) == Some(2) && result.get(1u64) == Some(1) && input.len() == 5u64
    /// }
    /// ```
    pub fn distinct(self) -> std::collections::List<T> where T: core::cmp::Eq;
}

impl<T> std::collections::MutableList<T> for Vec<T> {
    /// Append one item. A guarded structural edit traps before committing the edit.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2]);
    ///     val writable: std::collections::MutableList<i32> = values;
    ///     writable.push(3);
    ///     values.len() == 3u64 && values.get(2u64) == Some(3)
    /// }
    /// ```
    pub fn push(self, arg1: T);

    /// Remove and return the last item, or None for an empty sequence.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.pop() == Some(20) && values.pop() == Some(10) && values.pop() == None
    /// }
    /// ```
    pub fn pop(self) -> core::option::Option<T>;

    /// Insert at the given position and shift later elements. An index beyond the
    /// length traps.
    ///
    /// Index len appends; smaller indices insert before the existing element.
    /// Returns Unit. Vec aliases observe the edit and existing cursors reject later
    /// reads after a structural change.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 30]);
    ///     values.insert(1u64, 20);
    ///     values.len() == 3u64 && values.get(1u64) == Some(20) && values.get(2u64) == Some(30)
    /// }
    /// ```
    pub fn insert(self, arg1: u64, arg2: T);

    /// Remove and return the entry, or None if it is absent.
    ///
    /// The argument is a zero-based element index. Later elements shift left when
    /// an item is removed. An out-of-range index returns None and leaves slots
    /// unchanged.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20, 30]);
    ///     val removed = values.remove(1u64);
    ///     removed == Some(20) && values.get(1u64) == Some(30) && values.remove(9u64) == None
    /// }
    /// ```
    pub fn remove(self, arg1: u64) -> core::option::Option<T>;

    /// Remove all entries after validating structural mutation guards.
    ///
    /// Mutates the shared sequence storage. Vec aliases observe completed edits.
    /// A committed structural change invalidates existing cursors; active guarded
    /// operations such as sorting reject conflicting structural edits.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.clear();
    ///     values.is_empty() && values.get(0u64) == None
    /// }
    /// ```
    pub fn clear(self);

    /// Replace the item at an existing index. An out-of-bounds index traps.
    ///
    /// The zero-based index must be below len. Returns Unit without changing the
    /// length. Existing aliases observe the replacement in the same sequence.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values: std::collections::MutableList<i32> = Vec::from([10, 20]);
    ///     values.set(1u64, 99);
    ///     values.len() == 2u64 && values.get(0u64) == Some(10) && values.get(1u64) == Some(99)
    /// }
    /// ```
    pub fn set(self, arg1: u64, arg2: T);

    /// Sorts this list in ascending `Ord` order, returning Unit.
    ///
    /// Equal elements keep their relative order. Aliases observe the same storage.
    /// A failure can leave a partial reordering; completed effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([3, 1, 2]);
    ///     val alias = values;
    ///     values.sort();
    ///     alias.get(0u64) == Some(1) && alias.get(2u64) == Some(3)
    /// }
    /// ```
    pub fn sort(self) where T: core::cmp::Ord;

    /// Sorts this list in place using `callback(left, right)`, returning Unit.
    ///
    /// The callback returns Less, Equal or Greater and must define a consistent order.
    /// Equal elements retain their relative order. A trap stops later callbacks and
    /// can leave a partial reordering. Vec rejects structural edits during comparison.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 3, 2]);
    ///     values.sort_by(|left, right| right.cmp(left));
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    pub fn sort_by(self, callback: fn(T, T) -> core::cmp::Ordering);

    /// Sorts this list in place by `callback` keys, returning Unit.
    ///
    /// Keys are evaluated during comparisons, without caching; callbacks can run
    /// repeatedly for one element. Equal keys preserve element order. A callback trap
    /// can leave a partial reordering. Vec rejects structural edits during comparison.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 3, 2]);
    ///     values.sort_by_key(|value| -value);
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    pub fn sort_by_key<M>(self, callback: fn(T) -> M) where M: core::cmp::Ord;

    /// Reverses this list in place, returning Unit.
    ///
    /// Aliases observe the same storage. Empty and single-element inputs are unchanged.
    /// If a custom receiver fails during a write, earlier writes remain committed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3]);
    ///     values.reverse();
    ///     values.get(0u64) == Some(3) && values.get(2u64) == Some(1)
    /// }
    /// ```
    pub fn reverse(self);

    /// Keeps elements for which `callback` returns true, returning Unit.
    ///
    /// Visits elements in input order and preserves the order of retained elements.
    /// A trap stops later callbacks and retains completed removals and callback
    /// effects.
    /// Vec rejects structural edits from the predicate while retaining.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3, 4]);
    ///     values.retain(|value| value % 2 == 0);
    ///     values.len() == 2u64 && values.get(0u64) == Some(2) && values.get(1u64) == Some(4)
    /// }
    /// ```
    pub fn retain(self, callback: fn(T) -> bool);

    /// Removes consecutive equal elements, keeping the first in each run.
    ///
    /// Returns Unit and compares through `Eq`, without requiring Hash. Nonadjacent
    /// duplicates remain; use `distinct` to remove them in a new List. A failure
    /// preserves earlier removals and equality-callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 1, 2, 1]);
    ///     values.dedup();
    ///     values.len() == 3u64 && values.get(0u64) == Some(1) && values.get(1u64) == Some(2) && values.get(2u64) == Some(1)
    /// }
    /// ```
    pub fn dedup(self) where T: core::cmp::Eq;
}

impl<T> core::ops::Index<u64> for Vec<T> {
    type Output = T;

    /// Indexed read access. Built-in sequence indexing traps when the index is out of
    /// bounds; `get` provides an optional result instead.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([10, 20]);
    ///     values[0u64] == 10 && values[1u64] == 20
    /// }
    /// ```
    pub fn index(self, arg1: u64) -> T;
}

impl<T> core::iter::Iterable for Vec<T> {
    type Item = T;

    type Iter = core::iter::CollectionCursor<T>;

    /// Returns a cursor over this value's items.
    ///
    /// The cursor's `Item` type equals this iterable's `Item`. Collection
    /// implementations
    /// normally return a fresh cursor at the beginning. Calling `iter` on an iterator
    /// returns that iterator with its current progress; it does not rewind or clone it.
    /// Custom implementations choose how to obtain their cursor.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val values = Vec::from([1, 2, 3]);
    ///     val cursor = values.iter();
    ///     cursor.next();
    ///     cursor.count() == 2u64 && values.count() == 3u64
    /// }
    /// ```
    pub fn iter(self) -> core::iter::CollectionCursor<T>;
}

impl<T> core::default::Default for Vec<T> {
    /// Returns a fresh empty Vec. The element type need not implement Default.
    /// Independently created vectors have separate mutable storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// struct Element {}
    /// fn main() -> bool {
    ///     val values = Vec<Element>::default();
    ///     values.is_empty()
    /// }
    /// ```
    pub fn default() -> Vec<T>;
}

impl<T> core::iter::FromIterator<T> for Vec<T> {
    /// Constructs a value from an iterable source.
    ///
    /// Implement `from_iter` for the destination type. `Iterable::collect` delegates to
    /// that implementation, so the destination determines construction and stopping
    /// behavior. The standard `Vec` implementation collects items in source order until
    /// the first `None`. Already completed source effects survive a construction trap.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val result = Vec<i32>::from_iter(Vec::from([1, 2, 3]).map(|item| item * 2));
    ///     result.len() == 3u64 && result.get(1u64) == Some(4)
    /// }
    /// ```
    pub fn from_iter<M>(source: M) -> Vec<T> where M: core::iter::Iterable<Item = T>;
}

impl<T> core::cmp::PartialEq for Vec<T> where T: core::cmp::PartialEq {
    /// Equality comparison. Implementations should be symmetric and transitive where
    /// defined. Equal keys must also have equal hashes when used in a hash collection.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     7.eq(7) && !7.eq(8)
    /// }
    /// ```
    pub fn eq(self, arg1: Vec<T>) -> bool;
}

impl<T> core::cmp::Eq for Vec<T> where T: core::cmp::Eq {
}

impl<T> core::hash::Hash for Vec<T> where T: core::cmp::Eq + core::cmp::PartialEq + core::hash::Hash {
    /// Computes a stable hash for the duration of a collection operation. Equal keys
    /// must hash equally. Hash and equality callbacks run synchronously; recursive
    /// structural mutation during lookup traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// fn main() -> bool {
    ///     val original = "café";
    ///     val copy = original.replace("fé", "fé");
    ///     original == copy && original.hash() == copy.hash()
    /// }
    /// ```
    pub fn hash(self) -> i64;
}
