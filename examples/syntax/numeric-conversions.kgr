// Explicit casts have language-defined truncation and saturation rules.
fn main()->i32 {
    val hi=0x12u8;val lo=0x34u8;
    val address=((hi as u16)<<8)|(lo as u16);
    if address!=0x1234u16 || (address as u8)!=lo {return 0;}
    if ((address>>8) as u8)!=hi || (0xffu8 as i8)!=-1i8 {return 0;}
    if (999.75 as u8)!=255u8 || ((255u8 as f64)/255.0)!=1.0 {return 0;}
    42
}
