// Run: cargo run -p kagari-cli -- run examples/syntax/control-flow.kgr
// Result: main returns 42.
fn main() -> i32 {
    var index = 0;
    var total = 0;
    while index < 5 {
        index += 1;
        if index == 3 {
            continue;
        };
        total += index;
    }

    loop {
        if total == 42 {
            break;
        };
        total += 10;
    }

    var for_total = 0;
    for value in [20, 22] {
        for_total += value;
    }
    { val passed = for_total == 42; if !passed {val zero=0;1/zero;} };
    val break_items = [1];
    for item in break_items {
        break;
    }
    break_items.push(2);
    { val passed = break_items.len() == [0, 0].len(); if !passed {val zero=0;1/zero;} };
    val loop_value = loop {
        break 42;
    };
    { val passed = loop_value == 42; if !passed {val zero=0;1/zero;} };

    { val passed = total == 42; if !passed {val zero=0;1/zero;} };
    total
}
