// Interfaces control access; concrete classes choose storage.
// Read-only views share objects; from creates fresh shallow slots.
fn append(values: MutableList<i32>, value: i32) { values.push(value); }
fn size<C: List<i32>>(values: C) -> usize { values.len() }
fn main() -> i32 {
    std::debug::assert([1, 3, 5].binary_search(4) == Err(2usize), "insertion index");
    val a = ArrayList::from([1, 2]);
    val r: [i32] = a;
    append(a, 3);
    std::debug::assert_eq(size(a), 3usize, "generic interface bound");
    std::debug::assert(r.len() == [0, 0, 0].len(), "live view");
    val snapshot = ArrayList::from(a);
    a.push(4);
    std::debug::assert(snapshot.len() == [0, 0, 0].len(), "snapshot");
    val m = LinkedHashMap::from([("a", 1), ("a", 2)]);
    val mr: Map<String, i32> = m;
    std::debug::assert(mr.get("a") == Some(2), "duplicate");
    m.insert("b", 3);
    std::debug::assert(mr.contains_key("b"), "map view");
    val entries = m.entries();
    m.insert("c", 4);
    std::debug::assert_eq(entries.len(), 2usize, "read-only entry snapshot");
    val editable_entries = ArrayList::from(entries);
    editable_entries.clear();
    std::debug::assert_eq(m.len(), 3usize, "copy does not modify map");
    val s = LinkedHashSet::from([1, 1, 2]);
    std::debug::assert(s.len() == [0, 0].len(), "dedup");
    val ms = LinkedHashSet::from([1]);
    ms.insert(2);
    val readonly: Set<i32> = ms;
    std::debug::assert(s.is_subset(readonly), "set relationship");
    std::debug::assert(s.symmetric_difference(readonly).is_empty(), "same membership");
    val empty: Map<String, i32> = LinkedHashMap::new();
    val empty_array: ArrayList<i32> = ArrayList::new();
    val empty_set: Set<i32> = LinkedHashSet::from([]);
    std::debug::assert(empty.is_empty() && empty_array.is_empty() && empty_set.is_empty(), "empty");
    42
}
