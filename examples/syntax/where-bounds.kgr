// Run: cargo run -p kagari-cli -- run examples/syntax/where-bounds.kgr
// Result: main returns 42.
trait Read {
    fn read(self) -> i32;
}

trait AlsoRead: Read {
    fn plus_one(self) -> i32;
}

struct Number {
    val value: i32,
}

impl Read for Number {
    fn read(self) -> i32 {
        self.value
    }
}

impl AlsoRead for Number {
    fn plus_one(self) -> i32 { self.value + 1 }
}

fn value_of_extra<T: AlsoRead>(item: T) -> i32 { item.plus_one() }

fn value_of<T>(item: T) -> i32 where T: Read {
    item.read()
}

fn main() -> i32 {
    val result = value_of(Number { value: 42 });
    { val passed = result == 42; if !passed {val zero=0;1/zero;} };
    { val passed = value_of_extra(Number { value: 41 }) == 42; if !passed {val zero=0;1/zero;} };
    result
}
