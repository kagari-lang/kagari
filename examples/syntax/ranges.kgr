// Integer ranges retain bounds; iteration is lazy and preserves integer width.
fn main() -> i32 {
    var sum = 0;
    for value in 0..3 {
        sum += value;
    }
    for value in 0..=2 {
        sum += value;
    }
    var saw_max = false;
    for value in 2147483647..=2147483647 {
        saw_max = value == 2147483647;
    }
    var calls = 0;
    val next = || { calls += 1; calls };
    val values = next()..=next();
    var subtotal = 0;
    for value in values { subtotal += value; }
    val array = [1, 2, 3, 4];
    array.copy_within(..2, 2);
    array.copy_within(..=0, 1);
    array.copy_within(3.., 0);
    array.copy_within(.., 0);
    val prefix = (254u8..).iter().take(2usize).collect::<ArrayList<u8>>();
    std::debug::assert(prefix[1] == 255u8, "lazy open range");
    if sum == 6 && saw_max && calls == 2 && subtotal == 3 { 42 } else { 0 }
}
