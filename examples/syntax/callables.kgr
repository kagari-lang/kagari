// The same callable protocol supports local functions, closures and stateful objects.
struct Counter { var value: i32 }
impl Fn<(i32,)> for Counter {
    type Output = i32;
    fn call(self, args: (i32,)) -> i32 {
        self.value += args[0];
        self.value
    }
}
fn apply<T, R, F: Fn(T) -> R>(value: T, f: F) -> R { f(value) }
fn visit<F: Fn()>(f: F) { f(); }
fn main() -> i32 {
    // Forward reference; the returned helper has no captured environment.
    val increment = make_increment();
    fn identity<T>(value: T) -> T { value }
    val selected = identity::<i32>;
    fn make_increment() -> fn(i32) -> i32 {
        fn increment(value: i32) -> i32 { value + 1 }
        increment
    }
    { val passed = apply(selected(41), increment) == 42; if !passed {val zero=0;1/zero;} };
    val counter = Counter { value: 0 };
    { val passed = apply(20, counter) == 20; if !passed {val zero=0;1/zero;} };
    val callback: fn(i32) -> i32 = counter;
    { val passed = callback(1) == 21; if !passed {val zero=0;1/zero;} };
    visit(|| { counter.value += 1; });
    { val passed = apply(21, |x| x * 2) == 42; if !passed {val zero=0;1/zero;} };
    counter(20)
}
