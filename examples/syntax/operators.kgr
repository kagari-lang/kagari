use std::ops::Add;
struct Vector { val x: i32 }
impl Add<Vector> for Vector {
    type Output = Vector;
    fn add(self, rhs: Vector) -> Vector { Vector { x: self.x + rhs.x } }
}
impl Mul<i32> for Vector {
    type Output = Vector;
    fn mul(self, rhs: i32) -> Vector { Vector { x: self.x * rhs } }
}
fn plus<T: Add<T>>(left: T, right: T) -> T::Output { left + right }
fn main() -> i32 { (plus(Vector { x: 10 }, Vector { x: 11 }) * 2).x }
