// Run: cargo run -p kagari-cli -- run examples/syntax/array-operations.kgr
// Result: main returns 42.
struct Cell { var value: i32 }

fn main() -> i32 {
    val values = [0u8; 2048];
    values.fill(7u8);
    std::debug::assert(values[2047] == 7u8, "filled");

    val destination = [0; 3];
    val source: List<i32> = [10, 20, 30];
    destination.copy_from(source);
    std::debug::assert(destination[1] == 20, "copied");

    destination.copy_within(0..2, 1);
    std::debug::assert(destination[1] == 10 && destination[2] == 20, "overlap");

    // Each initializer call constructs an independent object.
    val cells = ArrayList::from_fn(2, |i| Cell { value: 1 });
    cells[0].value = 42;
    std::debug::assert(cells[1].value == 1, "independent elements");

    // Sharing is explicit: return an existing object from the initializer.
    val shared = ArrayList::from_fn(2, |i| cells[0]);
    shared[0].value = 7;
    std::debug::assert(shared[1].value == 7, "explicit sharing");
    val grouped: ArrayList<List<i32>> = [1, 2, 3].chunks(2usize).collect();
    std::debug::assert(grouped[1usize].len() == 1usize, "short final chunk");
    val intervals = [1, 2, 3, 4];
    val removed = intervals.remove_range(1usize..3usize);
    std::debug::assert(removed.len() == 2usize && intervals.len() == 2usize, "immediate removal");
    val sorted = [3, 1, 1, 2];
    sorted.sort();
    sorted.dedup();
    sorted.retain(|n| n > 1);
    std::debug::assert(sorted.len() == 2usize && sorted[0usize] == 2, "prepared mutations");
    42
}
