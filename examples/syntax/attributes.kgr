// Custom attributes are retained as compile-time metadata.
#[meta(name = "answer", tags = [1, true, sample::tag])]
fn main() -> i32 { 42 }

#[tool::syntax("model")]
struct Tagged {
    #[meta(readable = true)]
    val value: i32,
}

#[meta(kind = sample::method)]
impl Tagged {
    #[meta("getter")]
    fn read(self) -> i32 { self.value }
}

#[meta]
trait Inspect {
    #[meta("trait member")]
    fn inspect(self) -> i32;
}
