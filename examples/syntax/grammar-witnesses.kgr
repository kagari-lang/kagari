// Parser witnesses for grammar branches whose module semantics are still separate.
const BASELINE: i64 = 0;
pub(crate) static var requests: i64 = BASELINE;
pub static val callback: fn(i32) -> i32 = |value: i32| value + 1;

mod nested {
    #[allow(dead_code)]
    pub(super) static val cached: [i64] = [1, 2];

    fn answer() -> i32 { 42 }
}

mod external;

use pkg::model::*;
use {pkg::api, pkg::model};

struct Boxed { val value: i32 }
impl Boxed {
    fn static_value(value: i32) -> i32 { value }
}

fn paths() {
    crate::item;
    self::item;
    super::item;
}

fn empty_tuple_pattern(value: ()) -> i32 {
    match value { () => 42 }
}
