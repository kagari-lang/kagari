// Run: cargo run -p kagari-cli -- run examples/syntax/for-collections.kgr
// Result: main returns 42.
fn main() -> i32 {
    val scores: MutableMap<String, i32> = MutableMap::new();
    scores.insert("a", 20);
    scores.insert("b", 22);
    var total = 0;
    for (key, score) in scores {
        total += score;
    }
    val names: MutableSet<String> = MutableSet::new();
    names.insert("a");
    names.insert("b");
    var count = 0;
    for name in names {
        count += 1;
    }
    std::debug::assert_eq(count, 2, "set iteration");
    var chars = 0;
    for ch in "中😀" {
        chars += 1;
    }
    std::debug::assert_eq(chars, 2, "unicode scalar iteration");
    total
}
