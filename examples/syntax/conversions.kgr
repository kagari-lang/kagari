struct Count { val value: i32 }
impl From<i32> for Count {
    fn from(value: i32) -> Self { Count { value } }
}
impl TryFrom<i32> for Count {
    type Error = String;
    fn try_from(value: i32) -> Result<Self, String> {
        if value < 0 { Err("count must be non-negative") } else { Ok(Count { value }) }
    }
}
fn convert<S: Into<D>, D>(value: S) -> D { value.into() }
fn main() -> i32 {
    val count: Count = convert(42);
    val checked: Result<Count, String> = 42.try_into();
    if checked.is_ok() && Count::try_from(-1).is_err() { count.value } else { 0 }
}
