// Cold functions, repeatable closure factories and one-shot blocks.
async fn read(value: i32) -> i32 {
    value
}

async fn total(items: Vec<i32>) -> i32 {
    val request: fn(i32) -> Future<i32> = async |item| read(item).await;
    var result = 0;
    for item in items {
        result += request(item).await;
    }
    result
}

fn work() -> fn() -> Future<i32> {
    async || total(Vec::from([1, 2, 3])).await
}

fn pending(value: i32) -> Future<i32> {
    async { read(value).await }
}

async fn blocks() -> i32 {
    var count = 1;
    val first = async { count += 1; return count; };
    count = 2;
    val nested = async { pending(4) };
    first.await + nested.await.await + async { 5 }.await
}
