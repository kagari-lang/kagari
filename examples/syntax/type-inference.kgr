struct Marker<T> {
    val value: i32
}

fn consume<T>(marker: Marker<T>, seed: T) -> i32 {
    marker.value
}

fn identity<T>(value: T) -> T {
    value
}

fn main() -> i32 {
    // Later uses determine the element type without changing evaluation order.
    val values = [];
    values.push(consume(Marker { value: 20 }, true));
    values.push(22);

    // Local holes and explicit call arguments share the same body constraints.
    val readonly: Vec<_> = values;
    val collected = identity::<Vec<i32>>(readonly);
    // Suffixes select primitive types; unsuffixed literals use context first.
    val byte: u8 = 255;
    val minimum = -128i8;
    val maximum = 18446744073709551615u64;
    val precision: f32 = 1.25;
    { val passed = byte == 0xff_u8; if !passed {val zero=0;1/zero;} };
    { val passed = minimum == -128i8; if !passed {val zero=0;1/zero;} };
    { val passed = maximum > 0u64; if !passed {val zero=0;1/zero;} };
    { val passed = precision == 1.25f32; if !passed {val zero=0;1/zero;} };
    identity::<_>(collected[0]+collected[1])
}
