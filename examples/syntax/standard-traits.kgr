use std::collections::{HashMap, HashSet};
use std::fmt::{Debug, Display};
use std::hash::{Hash};
// Standard protocols use declaration identities, including aliased imports.
use core::fmt::Display as Show;

struct Label { val value: i32 }
impl Debug for Label {
    fn debug(self) -> String { f"Label({self.value})" }
}
impl Show for Label {
    fn display(self) -> String { self.value.display() }
}
fn same<T: Eq>(left: T, right: T) -> bool { left.eq(right) && left == right }
fn show<T: Show>(value: T) -> String { value.display() }
fn hash<T: Eq + Hash>(value: T) -> i64 { value.hash() }

enum Key { Number(i32), Name(String) }

// Value comparison is explicit; === still tests identity.
struct User { val id: i32, var label: String }
impl PartialEq for User {
    fn eq(self, other: Self) -> bool { self.id == other.id }
}
impl Eq for User {}
impl Hash for User {
    fn hash(self) -> i64 { self.id.hash() }
}

// Enum defaults compose member protocols, including User's custom methods.
enum Entry { Empty, Present(User) }

// An explicit enum implementation can equate different variants.
enum Identifier { Local(i32), Remote(i32) }
fn number(value: Identifier) -> i32 {
    match value { Identifier::Local(id) => id, Identifier::Remote(id) => id }
}
impl PartialEq for Identifier {
    fn eq(self, other: Self) -> bool { number(self) == number(other) }
}
impl Eq for Identifier {}
impl Hash for Identifier {
    fn hash(self) -> i64 { number(self).hash() }
}

fn main() -> i32 {
    val first = User { id: 1, label: "before" };
    val second = User { id: 1, label: "other" };
    { val passed = first == second && first !== second; if !passed {val zero=0;1/zero;} };
    val users: HashSet<(Entry, i32)> = HashSet::new();
    users.insert((Entry::Present(first), 7));
    // label is excluded from equality/hash; id must remain stable while stored.
    first.label = "after";
    { val passed = users.contains((Entry::Present(second), 7)); if !passed {val zero=0;1/zero;} };
    val ids: HashSet<Identifier> = HashSet::new();
    ids.insert(Identifier::Local(42));
    { val passed = ids.contains(Identifier::Remote(42)); if !passed {val zero=0;1/zero;} };
    val values: HashMap<(Key, i32), i32> = HashMap::new();
    values.insert((Key::Name("answer"), 1), 20);
    val label = Label { value: 22 };
    val identities: HashMap<Label, i32> = HashMap::new();
    identities.insert(label, 22);
    { val passed = same(label, label); if !passed {val zero=0;1/zero;} };
    { val passed = !same(label, Label { value: 22 }); if !passed {val zero=0;1/zero;} };
    { val passed = hash((42, "x")) == hash((42, "x")); if !passed {val zero=0;1/zero;} };
    { val passed = label.debug() == "Label(22)"; if !passed {val zero=0;1/zero;} };
    { val passed = show(label) == "22"; if !passed {val zero=0;1/zero;} };
    (match values.get((Key::Name("answer"),1)){Some(n)=>n,None=>0}) + (match identities.get(label){Some(n)=>n,None=>0})
}
