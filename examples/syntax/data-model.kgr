// Run: cargo run -p kagari-cli -- run examples/syntax/data-model.kgr
// Result: main returns 42.
struct Point {
    val x: i32,
    var y: i32,
}

impl Point {
    fn sum(self) -> i32 {
        self.x + self.y
    }
}

enum Answer {
    Missing,
    Value(i32),
}

fn make_point(x: i32, y: i32) -> Point {
    Point { x, y }
}

fn main() -> i32 {
    val point = make_point(20, 21);
    point.y += 1;
    { val passed = point.sum() == 42; if !passed {val zero=0;1/zero;} };
    val pair = (point.x, point.y);
    val values = [pair[0], pair[1]];
    val answer = Answer::Value(values[0] + values[1]);
    { val passed = answer == Answer::Value(42); if !passed {val zero=0;1/zero;} };
    var arithmetic = 2;
    arithmetic -= 1;
    arithmetic *= 2;
    arithmetic /= 2;
    { val passed = arithmetic == 1; if !passed {val zero=0;1/zero;} };
    (point.y) = 22;
    val fetch = || point;
    fetch().y = 42;
    { val passed = point.y == 42; if !passed {val zero=0;1/zero;} };
    values[0] + values[1]
}
