// Optional Rust functions provide algorithms; lazy map owns the saved cursor.
use std::collections;
fn main()->i32 {
    val values=[22,20]; collections::sort(values);
    var calls=0;
    val mapped=collections::map(values,|value|{calls+=1;value});
    if calls!=0 {return 0;}
    var total=0;
    for value in mapped {total+=value;}
    if calls!=2 {return 0;}
    total
}
