const EXPECTED_MAX: i32 = 6 * 2;
const MIN_I32: i32 = -2147483648;

enum Sample { Empty, Count(i32), Values([i32]) }
struct Cell<T> { var value: T }
struct Marker<T> { val value: i32 }
struct ComparablePair<T: Comparable> { val value: T }
fn comparable_pair<T: Comparable>(value: T) -> ComparablePair<(T, i32)> {
    ComparablePair { value: (value, 42) }
}
struct PartialMarker<T> { val pair: (Marker<i32>, T) }
struct SeededMarker<T> { val seed: T, val marker: Marker<T> }
fn partial_marker<T>(pair: (Marker<i32>, T)) -> i32 { pair[0].value }
fn make_marker() -> Marker<bool> { Marker { value: 42 } }
fn returned_marker(flag: bool) -> Marker<bool> {
    if flag { return Marker { value: 42 }; } else { Marker { value: 0 } }
}
enum Packet<T> { Data(T) }
enum Token<T> { Empty }
fn token() -> Token<bool> { Token::Empty }
fn marker_value(marker: Marker<bool>, token: Token<bool>) -> i32 { marker.value }
trait ReadMarker { fn read(self, marker: Marker<bool>) -> i32; }
struct MarkerReader { val offset: i32 }
impl ReadMarker for MarkerReader {
    fn read(self, marker: Marker<bool>) -> i32 { self.offset + marker.value }
}
fn read_marker<T: ReadMarker>(reader: T) -> i32 { reader.read(Marker { value: 40 }) }
fn identity<T>(value: T) -> T { value }
fn empty_token<T>() -> Token<T> { Token::Empty }
fn forwarded_marker<T>() -> Marker<T> { identity(Marker { value: 42 }) }
fn empty_scores() -> Map<String, i32> { std::map::new() }
fn empty_numbers() -> [i32] { [] }
fn empty_keys<T: HashKey>() -> Set<T> {
    val keys: Set<T> = std::set::new();
    keys
}
fn read_cell<T>(cell: Cell<T>) -> T { cell.value }

// Declared functions take precedence over unqualified helper names.
fn type_of(value: i32) -> i32 { value + 1 }

// Private generic templates become concrete reachable instances at compilation.
fn negate<T: SignedNumber>(value: T) -> T { -value }
fn add<T: OrderedNumber>(lhs: T, rhs: T) -> T { lhs + rhs }
pub fn add_i32(lhs: i32, rhs: i32) -> i32 { add(lhs, rhs) }

fn main() -> (usize, bool, usize, bool, usize, bool, i32) {
    std::debug::assert_eq(partial_marker((Marker { value: 42 }, true)), 42, "known member context beside inferred generic");
    val partial = PartialMarker { pair: (Marker { value: 42 }, true) };
    std::debug::assert_eq(partial.pair[0].value, 42, "partial field context");
    std::debug::assert_eq(negate(-42), 42, "generic signed-number negation");
    std::debug::assert_eq(Token<i32>::Empty, Token::Empty, "assert equality supplies RHS context");
    std::debug::assert(Token<i32>::Empty == Token::Empty, "binary RHS constructor context");
    val tokens = [Token<i32>::Empty, Token::Empty];
    std::debug::assert_eq(tokens[0], tokens[1], "earlier element supplies constructor context");
    val markers: [Marker<i32>] = [];
    markers.push(Marker { value: 42 });
    std::debug::assert_eq(markers[0].value, 42, "container supplies constructor context");
    val values = [1, 2];
    val counter = Cell { value: 7 };
    val flag = Cell { value: true };
    val seeded = SeededMarker { seed: true, marker: Marker { value: 42 } };
    std::debug::assert_eq(seeded.marker.value, 42, "preceding field supplies constructor context");
    val keys: Set<i32> = empty_keys();
    std::debug::assert(keys.is_empty(), "forwarded HashKey annotation constraint");
    var assigned: Marker<bool> = make_marker();
    assigned = Marker { value: 42 };
    std::debug::assert_eq(assigned.value, 42, "assignment target supplies constructor context");
    val contextual: Marker<i32> = identity(Marker { value: 42 });
    std::debug::assert_eq(comparable_pair(true).value[1], 42, "recursive Comparable bounds");
    val matched = match 42 { value => value, _ => 0 };
    std::debug::assert_eq(matched, 42, "binding pattern consumes remaining match values");
    std::debug::assert_eq(returned_marker(true).value, 42, "returning branch has no Unit result");
    val explicit = Marker<i32> { value: 42 };
    std::debug::assert_eq(explicit.value, 42, "explicit constructor type argument");
    val forwarded: Marker<bool> = forwarded_marker();
    std::debug::assert_eq(forwarded.value, 42, "caller-owned generic context");
    val inferred_token: Token<bool> = empty_token();
    std::debug::assert_eq(contextual.value, 42, "generic result context");
    std::debug::assert(inferred_token == token(), "phantom function result context");
    std::debug::assert_eq(read_marker(MarkerReader { offset: 2 }), 42, "trait parameter supplies constructor context");
    val empty: Token<bool> = Token::Empty();
    val explicit_empty = Token<bool>::Empty;
    std::debug::assert(explicit_empty == empty, "explicit enum type arguments");
    std::debug::assert(empty == token(), "enum context supplies phantom type argument");
    std::debug::assert_eq(marker_value(Marker { value: 42 }, Token::Empty), 42, "call signature supplies constructor context");
    val marker: Marker<bool> = Marker { value: 42 };
    std::debug::assert_eq(marker.value, 42, "annotation supplies phantom type argument");
    std::debug::assert_eq(make_marker().value, 42, "return type supplies phantom type argument");
    counter.value += 1;
    std::debug::assert_eq(read_cell(counter), 8, "concrete generic field slot");
    std::debug::assert(read_cell(flag), "separate bool layout instance");
    std::debug::assert(Packet::Data(7) == Packet::Data(7), "generic enum payload values");
    std::debug::assert(Sample::Empty == Sample::Empty(), "unit enum values compare equally");
    std::debug::assert_eq(Sample::Count(7), Sample::Count(7), "enum payloads compare by value");
    val sample = Sample::Values(values);
    std::debug::assert(sample == Sample::Values(values), "enum mutable members retain their identity");
    std::debug::assert_eq(add_i32(20, 22), 42, "concrete public entry");
    std::debug::assert_eq(add(1.5, 2.5), 4.0, "separate f32 instance");
    std::debug::assert_eq(type_of(41), 42, "resolved user function");
    std::debug::assert_eq("中😀".len_bytes(), "1234567".len_bytes(), "UTF-8 byte length");
    std::debug::assert_eq("中😀".len_chars(), "ab".len_chars(), "Unicode scalar count");
    values.push(3);

    val copied_values = std::iter::to_array(values);
    std::debug::assert(values != copied_values, "copy has its own container identity");
    val first = [1];
    val second = [1];
    std::debug::assert_eq(first.pop(), second.pop(), "Option compares its payload by value");
    std::debug::assert(first.pop().is_none(), "empty pop returns None");
    val text = "中😀";
    std::debug::assert_eq(std::iter::get(text, "a".len_bytes()).unwrap_or("missing"), "😀", "iteration indexes Unicode scalars");
    std::debug::assert(std::iter::get(text, text.len_chars()).is_none(), "out-of-range get returns None");
    // Integer arithmetic and abs trap on overflow, including intermediate results.
    std::debug::assert_eq(std::math::abs(-2147483647), 2147483647, "checked abs boundary");
    std::debug::assert_eq(std::math::max(10, 12), EXPECTED_MAX, "const uses checked arithmetic");
    std::debug::assert_eq(MIN_I32 + 1, -2147483647, "minimum i32 literal");
    values[0] += 9;
    std::debug::assert_eq(values[0], 10, "compound assignment commits once");

    val scores: Map<String, i32> = empty_scores();
    std::debug::assert(empty_numbers().is_empty(), "empty array return context");
    scores.insert("alice", 10);
    scores.insert("bob", 12);

    val names: Set<String> = std::set::new();
    names.insert("alice");
    names.insert("bob");

    std::debug::assert(scores.contains_key("alice"), "score must exist");

    (
        values.len(),
        std::string::contains("kagari", "gar"),
        scores.keys().len(),
        names.contains("bob"),
        names.to_array().len(),
        scores.get("alice").is_some(),
        std::math::max(10, 12)
    )
}
