// Default containers belong to the language; optional algorithms are ordinary natives.
use std::collections;
fn main()->i32 {
    val values=[22,20];
    collections::sort(values);
    val mapped=collections::map(values,|value|value);
    var sum=0;for value in mapped{sum+=value;}
    val map=HashMap::new();map.insert("answer",sum);
    val set=HashSet::new();set.insert(sum);
    if !set.contains(42){return 0;}
    match map.get("answer"){Some(answer)=>answer,None=>0}
}
