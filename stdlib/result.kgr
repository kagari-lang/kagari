//! Success and error values with explicit propagation and preserved diagnostic origins.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

pub use self::Result::{Ok, Err};

/// A successful value `Ok(T)` or a recoverable business error `Err(E)`.
///
/// Use `Result` for failures callers can inspect and handle. It does not turn engine
/// traps, cancellation, or resource exhaustion into business errors. Pattern matching
/// handles both alternatives; `?` extracts `Ok` or returns the error early from a
/// function with a compatible `Result` return type.
/// For an error `E` and enclosing error `F`, propagation requires `F: From<E>`.
/// The conversion runs only on Err and preserves its original diagnostic origin.
///
/// Constructing `Err` records its original script location and stack. Forwarding it,
/// including through `?` or `map_err`, preserves that origin. Constructing a new
/// `Err(e)` from an extracted payload creates a new origin. Diagnostic metadata does
/// not participate in equality or hashing.
///
/// Default equality compares the variant and then its payload. Copying a result
/// preserves references to mutable payloads. Completed side effects are not rolled
/// back when a function returns `Err`.
///
/// # Examples
///
/// ```kgr
/// fn require_positive(value: i32) -> Result<i32, String> {
///     if value > 0 { Ok(value) } else { Err("expected a positive number") }
/// }
/// fn increment(value: i32) -> Result<i32, String> {
///     val number = require_positive(value)?;
///     Ok(number + 1)
/// }
/// fn main() {
///     std::debug::assert(increment(7) == Ok(8), "success");
///     std::debug::assert(increment(0).is_err(), "propagated error");
/// }
/// ```
#[builtin_enum(Result)]
pub enum Result<T, E> {
    /// Contains the successful value.
    Ok(T),
    /// Contains a business error and captures its original script stack.
    Err(E),
}

impl<T, E> Result<T, E> {
    /// Transform the error only when this is Err.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Err("x");
    /// std::debug::assert(v.unwrap_or_else(|e| 7) == 7, "fallback");
    /// ```
    #[intrinsic(ResultUnwrapOrElse)]
    pub fn unwrap_or_else(self, fallback: fn(E) -> T) -> T;

    /// Recover from Err with another Result.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Err("x");
    /// val r: Result<i32, i32> = v.or_else(|e| Ok(7));
    /// std::debug::assert(r == Ok(7), "recovery");
    /// ```
    #[intrinsic(ResultOrElse)]
    pub fn or_else<F>(self, fallback: fn(E) -> Result<T, F>) -> Result<T, F>;

    /// Transform Ok or return the eagerly evaluated fallback.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Ok(7);
    /// std::debug::assert(v.map_or(0, |x| x + 1) == 8, "map");
    /// ```
    #[intrinsic(ResultMapOr)]
    pub fn map_or<U>(self, fallback: U, transform: fn(T) -> U) -> U;

    /// Call exactly the selected error or success transformation.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Ok(7);
    /// std::debug::assert(v.map_or_else(|e| 0, |x| x + 1) == 8, "map");
    /// ```
    #[intrinsic(ResultMapOrElse)]
    pub fn map_or_else<U>(self, fallback: fn(E) -> U, transform: fn(T) -> U) -> U;

    /// Return the success as Some, discarding an error.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Ok(7);
    /// std::debug::assert(v.ok() == Some(7), "success");
    /// ```
    #[intrinsic(ResultOk)]
    pub fn ok(self) -> Option<T>;

    /// Return the error as Some, discarding a success.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Err("x");
    /// std::debug::assert(v.err() == Some("x"), "error");
    /// ```
    #[intrinsic(ResultErr)]
    pub fn err(self) -> Option<E>;

    /// Test Ok; Err returns false without calling the predicate.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Ok(7);
    /// std::debug::assert(v.is_ok_and(|x| x > 5), "predicate");
    /// ```
    #[intrinsic(ResultIsOkAnd)]
    pub fn is_ok_and(self, predicate: fn(T) -> bool) -> bool;

    /// Test Err; Ok returns false without calling the predicate.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<i32, String> = Err("x");
    /// std::debug::assert(v.is_err_and(|e| e == "x"), "predicate");
    /// ```
    #[intrinsic(ResultIsErrAnd)]
    pub fn is_err_and(self, predicate: fn(E) -> bool) -> bool;

    /// Test whether the result is successful.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Ok(7);
    /// std::debug::assert(value.is_ok(), "success");
    /// ```
    #[intrinsic(ResultIsOk)]
    pub fn is_ok(self) -> bool;

    /// Test whether the result is an error.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Err("missing");
    /// std::debug::assert(value.is_err(), "failure");
    /// ```
    #[intrinsic(ResultIsErr)]
    pub fn is_err(self) -> bool;

    /// Return the success value or the eagerly evaluated fallback.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The fallback argument is evaluated even when it is not selected. Use a conditional
    /// callback API when fallback computation must be lazy.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Err("missing");
    /// std::debug::assert(value.unwrap_or(7) == 7, "fallback");
    /// ```
    #[intrinsic(ResultUnwrapOr)]
    pub fn unwrap_or(self, fallback: T) -> T;

    /// Transform Ok with one callback call. Preserve Err and its original stack.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Ok(7);
    /// std::debug::assert(value.map(|x| x + 1).unwrap_or(0) == 8, "mapped");
    /// ```
    #[intrinsic(ResultMap)]
    pub fn map<U>(self, callback: fn(T) -> U) -> Result<U, E>;

    /// Transform Err with one callback call and retain its original source location and stack.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Err("missing");
    /// val mapped = value.map_err(|e| e.concat(" configuration"));
    /// std::debug::assert(match mapped { Ok(_) => false, Err(e) => e == "missing configuration" }, "mapped error");
    /// ```
    #[intrinsic(ResultMapErr)]
    pub fn map_err<F>(self, callback: fn(E) -> F) -> Result<T, F>;

    /// Call the callback only for Ok. Preserve an existing Err and its original stack.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// Existing `Err` diagnostic metadata is preserved when forwarded, including by `map_err`.
    /// The metadata does not participate in equality or hashing. Manually reconstructing
    /// `Err(e)` records a new origin.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Result<i32, String> = Ok(7);
    /// val result: Result<i32, String> = value.and_then(|x| Ok(x + 1));
    /// std::debug::assert(result.unwrap_or(0) == 8, "chained");
    /// ```
    #[intrinsic(ResultAndThen)]
    pub fn and_then<U>(self, callback: fn(T) -> Result<U, E>) -> Result<U, E>;
}

/// Collect successful payloads, stopping at the first failure.
impl<T, E, C: FromIterator<T>> FromIterator<Result<T, E>> for Result<C, E> {
    /// Buffer successful items and construct C only after successful exhaustion.
    ///
    /// The first Err or None stops traversal without reading subsequent items.
    /// An Err retains its original diagnostic stack. On failure C::from_iter is
    /// not called; on success it is called once, including for empty input.
    /// Source side effects are not rolled back, and referenced items remain shared.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val items: ArrayList<Result<i32, String>> = [Ok(20), Ok(22)];
    /// val result: Result<ArrayList<i32>, String> = items.iter().collect();
    /// std::debug::assert_eq(result.map(|x| x[0] + x[1]), Ok(42), "success");
    /// ```
    #[intrinsic(ResultFromIterator)]
    fn from_iter<I: Iterable<Item = Result<T, E>>>(source: I) -> Self;
}

impl<T, E> Result<Result<T, E>, E> {
    /// Remove one layer of Result nesting while preserving the selected error origin.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<Result<i32, String>, String> = Ok(Ok(7));
    /// std::debug::assert(v.flatten() == Ok(7), "flatten");
    /// ```
    #[intrinsic(ResultFlatten)]
    pub fn flatten(self) -> Result<T, E>;
}

impl<T, E> Result<Option<T>, E> {
    /// Exchange Result and Option layers while preserving an existing error origin.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Result<Option<i32>, String> = Ok(Some(7));
    /// std::debug::assert(v.transpose() == Some(Ok(7)), "transpose");
    /// ```
    #[intrinsic(ResultTranspose)]
    pub fn transpose(self) -> Option<Result<T, E>>;
}
