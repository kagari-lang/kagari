//! Immutable UTF-8 strings. Byte offsets and Unicode scalar counts are distinct.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// An immutable UTF-8 string with value equality and hashing.
///
/// `len_bytes` counts UTF-8 bytes, not Unicode scalar values or grapheme clusters.
/// `slice` uses a half-open byte range and returns `None` for invalid bounds or a
/// boundary inside a scalar. Iteration produces one-scalar strings; a user-perceived
/// character can contain several scalars. Operations do not normalize Unicode.
///
/// String operations return values and do not modify their receiver. Object identity
/// is not a portable way to compare strings; use `==` to compare their contents.
///
/// # Examples
///
/// ```kgr
/// val text = "é!";
/// std::debug::assert(text.len_bytes() == [0, 0, 0].len(), "UTF-8 bytes");
/// std::debug::assert(text.slice("".len_bytes(), [0, 0].len()) == Some("é"), "scalar boundary");
/// std::debug::assert(text.concat("?") == "é!?", "new string");
/// std::debug::assert(text == "é!", "original unchanged");
/// ```
#[builtin_type(String)]
pub type String;

impl String {
    /// Replace every non-overlapping occurrence.
    ///
    /// An empty pattern inserts the replacement at every Unicode scalar boundary, including both ends.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("aba".replace("a", "x") == "xbx", "replace");
    /// ```
    #[intrinsic(StringReplace)]
    pub fn replace(self, from: String, to: String) -> String;

    /// Replace at most count non-overlapping occurrences.
    ///
    /// Zero preserves the original contents. Matching proceeds from left to right.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("aba".replacen("a", "x", 1usize) == "xba", "replacen");
    /// ```
    #[intrinsic(StringReplaceN)]
    pub fn replacen(self, from: String, to: String, count: usize) -> String;

    /// Concatenate count repetitions of this string.
    ///
    /// Zero or an empty receiver returns an empty string. Size overflow or allocation failure traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("ab".repeat(2usize) == "abab", "repeat");
    /// ```
    #[intrinsic(StringRepeat)]
    pub fn repeat(self, count: usize) -> String;

    /// Test whether every byte is ASCII.
    ///
    /// The empty string is ASCII.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("abc".is_ascii(), "is_ascii");
    /// ```
    #[intrinsic(StringIsAscii)]
    pub fn is_ascii(self) -> bool;

    /// Compare contents ignoring ASCII letter case.
    ///
    /// Non-ASCII scalars are compared exactly; this is not Unicode case folding.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("AbC".eq_ignore_ascii_case("aBc"), "eq_ignore_ascii_case");
    /// ```
    #[intrinsic(StringEqIgnoreAsciiCase)]
    pub fn eq_ignore_ascii_case(self, other: String) -> bool;

    /// Lowercase ASCII letters and preserve other scalars.
    ///
    /// The receiver is unchanged. Unicode normalization is not performed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("ABCé".to_ascii_lowercase() == "abcé", "to_ascii_lowercase");
    /// ```
    #[intrinsic(StringToAsciiLowercase)]
    pub fn to_ascii_lowercase(self) -> String;

    /// Uppercase ASCII letters and preserve other scalars.
    ///
    /// The receiver is unchanged. Unicode normalization is not performed.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("abcé".to_ascii_uppercase() == "ABCé", "to_ascii_uppercase");
    /// ```
    #[intrinsic(StringToAsciiUppercase)]
    pub fn to_ascii_uppercase(self) -> String;

    /// Return Unicode lowercase contents.
    ///
    /// Context-sensitive Unicode mappings are applied. Length may change; no locale is consulted.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("ΟΣ".to_lowercase() == "ος", "to_lowercase");
    /// ```
    #[intrinsic(StringToLowercase)]
    pub fn to_lowercase(self) -> String;

    /// Return Unicode uppercase contents.
    ///
    /// A scalar can expand into several scalars. Length may change; no locale is consulted.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("straße".to_uppercase() == "STRASSE", "to_uppercase");
    /// ```
    #[intrinsic(StringToUppercase)]
    pub fn to_uppercase(self) -> String;

    /// Lazily iterate the UTF-8 bytes.
    ///
    /// Bytes are not characters. The iterator retains the immutable source and is fused.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".bytes().next() == Some(195u8), "bytes");
    /// ```
    #[intrinsic(StringBytes)]
    pub fn bytes(self) -> Iter<u8>;

    /// Lazily iterate byte offsets and Unicode scalar strings.
    ///
    /// Each offset begins its scalar in the original UTF-8 contents. The iterator is fused.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("éx".char_indices().nth(1usize) == Some((2usize, "x")), "char_indices");
    /// ```
    #[intrinsic(StringCharIndices)]
    pub fn char_indices(self) -> Iter<(usize, String)>;

    /// Test whether a byte offset is a Unicode scalar boundary.
    ///
    /// Zero and len_bytes() are boundaries. Out-of-range offsets return false.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".is_char_boundary(2usize), "is_char_boundary");
    /// ```
    #[intrinsic(StringIsCharBoundary)]
    pub fn is_char_boundary(self, index: usize) -> bool;

    /// Lazily split around non-overlapping string separators.
    ///
    /// Retains empty fields, including a trailing field. An empty separator yields an empty field at each end and one field per Unicode scalar.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("a,b,".split(",").collect::<ArrayList<String>>().join("|") == "a|b|", "split");
    /// ```
    #[intrinsic(StringSplit)]
    pub fn split(self, separator: String) -> Iter<String>;

    /// Lazily split into at most count fields.
    ///
    /// Zero yields no fields. One yields the complete string. The last field contains the unsplit remainder.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("a,b,c".splitn(2usize, ",").collect::<ArrayList<String>>().join("|") == "a|b,c", "splitn");
    /// ```
    #[intrinsic(StringSplitN)]
    pub fn splitn(self, count: usize, separator: String) -> Iter<String>;

    /// Split at the first matching separator.
    ///
    /// The separator is excluded. An empty separator splits at the start. Returns None when absent.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("a=b=c".split_once("=") == Some(("a", "b=c")), "split_once");
    /// ```
    #[intrinsic(StringSplitOnce)]
    pub fn split_once(self, separator: String) -> Option<(String, String)>;

    /// Split at the last matching separator.
    ///
    /// The separator is excluded. An empty separator splits at the end. Returns None when absent.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("a=b=c".rsplit_once("=") == Some(("a=b", "c")), "rsplit_once");
    /// ```
    #[intrinsic(StringRsplitOnce)]
    pub fn rsplit_once(self, separator: String) -> Option<(String, String)>;

    /// Lazily split on Unicode whitespace.
    ///
    /// Adjacent whitespace is coalesced. Leading and trailing whitespace produce no empty fields. Empty input produces no fields.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("  a　b  ".split_whitespace().collect::<ArrayList<String>>().join("|") == "a|b", "split_whitespace");
    /// ```
    #[intrinsic(StringSplitWhitespace)]
    pub fn split_whitespace(self) -> Iter<String>;

    /// Lazily iterate lines without line terminators.
    ///
    /// Recognizes LF and CRLF. A lone CR is retained. A final terminator does not create an extra line; empty input yields none.
    /// Returned strings own their contents. Iterators stop permanently after None.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("a".lines().next() == Some("a"), "lines");
    /// ```
    #[intrinsic(StringLines)]
    pub fn lines(self) -> Iter<String>;

    /// Remove leading and trailing Unicode whitespace.
    ///
    /// Uses the Unicode White_Space property, not only ASCII spaces. Interior whitespace is preserved.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("  hello  ".trim() == "hello", "trim");
    /// ```
    #[intrinsic(StringTrim)]
    pub fn trim(self) -> String;

    /// Remove leading Unicode whitespace.
    ///
    /// Trailing and interior whitespace are preserved.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("  hello  ".trim_start() == "hello  ", "trim_start");
    /// ```
    #[intrinsic(StringTrimStart)]
    pub fn trim_start(self) -> String;

    /// Remove trailing Unicode whitespace.
    ///
    /// Leading and interior whitespace are preserved.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("  hello  ".trim_end() == "  hello", "trim_end");
    /// ```
    #[intrinsic(StringTrimEnd)]
    pub fn trim_end(self) -> String;

    /// Return the first matching substring byte offset.
    ///
    /// Returns None when absent. An empty needle matches at byte offset zero.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("éhello".find("hello") == Some(2usize), "find");
    /// ```
    #[intrinsic(StringFind)]
    pub fn find(self, needle: String) -> Option<usize>;

    /// Return the last matching substring byte offset.
    ///
    /// Returns None when absent. An empty needle matches at len_bytes().
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("ababa".rfind("aba") == Some(2usize), "rfind");
    /// ```
    #[intrinsic(StringRfind)]
    pub fn rfind(self, needle: String) -> Option<usize>;

    /// Remove one matching prefix.
    ///
    /// Returns None when absent. An empty prefix succeeds without changing the contents.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".strip_prefix("he") == Some("llo"), "strip_prefix");
    /// ```
    #[intrinsic(StringStripPrefix)]
    pub fn strip_prefix(self, prefix: String) -> Option<String>;

    /// Remove one matching suffix.
    ///
    /// Returns None when absent. An empty suffix succeeds without changing the contents.
    /// The receiver is unchanged; matching does not normalize Unicode.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".strip_suffix("lo") == Some("hel"), "strip_suffix");
    /// ```
    #[intrinsic(StringStripSuffix)]
    pub fn strip_suffix(self, suffix: String) -> Option<String>;

    /// Return the UTF-8 byte length.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// The byte length may differ from both the Unicode scalar count and the displayed
    /// character count.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".len_bytes() == [0, 0].len(), "UTF-8 bytes");
    /// ```
    #[intrinsic(StringLenBytes)]
    pub fn len_bytes(self) -> usize;

    /// Return the Unicode scalar count, not the grapheme count.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// A Unicode scalar value is not necessarily a complete user-perceived character. Combining
    /// sequences can contain multiple scalars.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".len_chars() == [0].len(), "Unicode scalars");
    /// ```
    #[intrinsic(StringLenChars)]
    pub fn len_chars(self) -> usize;

    /// Return whether the string is empty.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("".is_empty(), "empty");
    /// ```
    #[intrinsic(StringIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Return the concatenation of two strings.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".concat(" world") == "hello world", "concatenated");
    /// ```
    #[intrinsic(StringConcat)]
    pub fn concat(self, rhs: String) -> String;

    /// Test whether the string contains a substring.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".contains("ell"), "substring");
    /// ```
    #[intrinsic(StringContains)]
    pub fn contains(self, needle: String) -> bool;

    /// Test whether the string starts with a prefix.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".starts_with("he"), "prefix");
    /// ```
    #[intrinsic(StringStartsWith)]
    pub fn starts_with(self, needle: String) -> bool;

    /// Test whether the string ends with a suffix.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".ends_with("lo"), "suffix");
    /// ```
    #[intrinsic(StringEndsWith)]
    pub fn ends_with(self, needle: String) -> bool;

    /// Return the half-open byte slice, or None for invalid bounds or UTF-8 boundaries.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// `start` is inclusive and `end` is exclusive, both measured in UTF-8 bytes. Reversed
    /// bounds, out-of-range bounds and positions inside a UTF-8 sequence return `None`. An
    /// empty range at a valid boundary returns `Some("")`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é!".slice("".len_bytes(), [0, 0].len()) == Some("é"), "valid boundary");
    /// std::debug::assert("é!".slice("".len_bytes(), [0].len()) == None, "inside scalar");
    /// ```
    #[intrinsic(StringSlice)]
    pub fn slice(self, start: usize, end: usize) -> Option<String>;
}

/// Produce a fresh iterator over this shared source.
impl Iterable for String {
    /// The value yielded at each traversal position.
    type Item = String;
    /// The native iterator retaining this source and its current position.
    type Iter = Iter<String>;
    /// Begin a new traversal without copying elements or transferring ownership.
    ///
    /// Native collection guards prevent structural mutation during traversal.
    /// Strings yield one Unicode scalar string at a time.
    #[intrinsic(CollectionIter)]
    fn iter(self) -> Iter<String>;
}
