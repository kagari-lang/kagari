//! Immutable UTF-8 strings. Byte offsets and Unicode scalar counts are distinct.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// An immutable UTF-8 string with value equality and hashing.
///
/// `len_bytes` counts UTF-8 bytes, not Unicode scalar values or grapheme clusters.
/// `slice` uses a half-open byte range and returns `None` for invalid bounds or a
/// boundary inside a scalar. Iteration produces one-scalar strings; a user-perceived
/// character can contain several scalars. Operations do not normalize Unicode.
///
/// String operations return values and do not modify their receiver. Object identity
/// is not a portable way to compare strings; use `==` to compare their contents.
///
/// # Examples
///
/// ```kgr
/// val text = "é!";
/// std::debug::assert(text.len_bytes() == [0, 0, 0].len(), "UTF-8 bytes");
/// std::debug::assert(text.slice("".len_bytes(), [0, 0].len()) == Some("é"), "scalar boundary");
/// std::debug::assert(text.concat("?") == "é!?", "new string");
/// std::debug::assert(text == "é!", "original unchanged");
/// ```
#[builtin_type(String)]
pub type String;

impl String {
    /// Return the UTF-8 byte length.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// The byte length may differ from both the Unicode scalar count and the displayed
    /// character count.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".len_bytes() == [0, 0].len(), "UTF-8 bytes");
    /// ```
    #[intrinsic(StringLenBytes)]
    pub fn len_bytes(self) -> usize;

    /// Return the Unicode scalar count, not the grapheme count.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// A Unicode scalar value is not necessarily a complete user-perceived character. Combining
    /// sequences can contain multiple scalars.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é".len_chars() == [0].len(), "Unicode scalars");
    /// ```
    #[intrinsic(StringLenChars)]
    pub fn len_chars(self) -> usize;

    /// Return whether the string is empty.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("".is_empty(), "empty");
    /// ```
    #[intrinsic(StringIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Return the concatenation of two strings.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".concat(" world") == "hello world", "concatenated");
    /// ```
    #[intrinsic(StringConcat)]
    pub fn concat(self, rhs: String) -> String;

    /// Test whether the string contains a substring.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".contains("ell"), "substring");
    /// ```
    #[intrinsic(StringContains)]
    pub fn contains(self, needle: String) -> bool;

    /// Test whether the string starts with a prefix.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".starts_with("he"), "prefix");
    /// ```
    #[intrinsic(StringStartsWith)]
    pub fn starts_with(self, needle: String) -> bool;

    /// Test whether the string ends with a suffix.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("hello".ends_with("lo"), "suffix");
    /// ```
    #[intrinsic(StringEndsWith)]
    pub fn ends_with(self, needle: String) -> bool;

    /// Return the half-open byte slice, or None for invalid bounds or UTF-8 boundaries.
    ///
    /// The input string is not modified. String equality compares contents.
    ///
    /// `start` is inclusive and `end` is exclusive, both measured in UTF-8 bytes. Reversed
    /// bounds, out-of-range bounds and positions inside a UTF-8 sequence return `None`. An
    /// empty range at a valid boundary returns `Some("")`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert("é!".slice("".len_bytes(), [0, 0].len()) == Some("é"), "valid boundary");
    /// std::debug::assert("é!".slice("".len_bytes(), [0].len()) == None, "inside scalar");
    /// ```
    #[intrinsic(StringSlice)]
    pub fn slice(self, start: usize, end: usize) -> Option<String>;
}
