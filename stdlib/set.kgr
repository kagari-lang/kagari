//! Hash sets using Eq and Hash. Equal values occupy one membership entry.
//!
//! `Set` provides read-only access; `LinkedHashSet` also permits writes.
//! Read-only views share storage and observe changes through writable aliases.
//! `from` constructs fresh shallow storage; referenced elements retain identity.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// Read-only access to an insertion-ordered collection of distinct `T` values.
///
/// Elements require `Eq + Hash`. Equality determines membership; hashing chooses
/// candidate buckets. Equal elements must have equal hashes, but collisions are
/// allowed. The caller must not change an element's equality or hash while it is
/// stored, even through another reference. Remove it before such a change and
/// insert it again afterwards.
///
/// Assignment shares the set. `==` compares set identity, not membership. Set
/// operations that return a new set copy element references without deep-copying
/// objects. Iteration follows insertion order. Structural mutation during guarded
/// iteration traps. Custom equality and hash implementations may also trap.
///
/// # Examples
///
/// ```kgr
/// val values: LinkedHashSet<i32> = LinkedHashSet::new();
/// values.insert(7);
/// values.insert(7);
/// std::debug::assert(values.len() == [0].len(), "one distinct member");
/// std::debug::assert(values.contains(7), "membership");
/// ```

#[builtin_type(LinkedHashSet)]
pub type LinkedHashSet<T>;

impl<T: Eq + Hash> LinkedHashSet<T> {
    /// Keep accepted elements without calling user Hash again for retained keys.
    ///
    /// Prepares independent temporary storage, then commits once. Callback or
    /// allocation failure preserves the target's slots and order. Changes to
    /// referenced objects and other completed callback effects are not rolled back.
    /// Callbacks may read this collection, but writes through aliases trap.
    /// Retain visits each original element exactly once, from left to right.
    /// Sorting takes O(n log n) comparisons and O(n) temporary storage; callers
    /// must supply a consistent ordering. Dedup only compares adjacent candidates.
    ///
    /// # Panics
    ///
    /// Propagates callback, resource and mutation-guard failures. Structural
    /// replacement during guarded iteration is rejected before commit.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val s = LinkedHashSet::from([1, 2]); s.retain(|n| n == 2); std::debug::assert(s.len() == 1usize, "retained");
    /// ```
    #[intrinsic(SetRetain)]
    pub fn retain(self, predicate: fn(T) -> bool);

    /// Return the number of elements.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.len() == [0].len(), "length");
    /// ```
    #[intrinsic(SetLen)]
    pub fn len(self) -> usize;

    /// Return whether the set is empty.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(SetIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Test membership using Eq and Hash.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.contains(7), "member");
    /// ```
    #[intrinsic(SetContains)]
    pub fn contains(self, item: T) -> bool;

    /// Return a shallow array of elements.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// The returned array has independent container storage. Do not rely on a particular
    /// enumeration order.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.to_array().get("".len_bytes()) == Some(7), "snapshot");
    /// ```
    #[intrinsic(SetToArray)]
    pub fn to_array(self) -> ArrayList<T>;


}

impl<T: Eq + Hash> LinkedHashSet<T> {
    /// Create a fresh empty set with writable access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(LinkedHashSetNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow set from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// Equal elements are deduplicated. Elements must remain stable while stored.
    /// Input is traversed in order using the selected Eq and Hash implementations.
    ///
    /// # Panics
    ///
    /// Propagates traps from user comparison or hashing. No partial result is returned.
    /// Completed callback effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = LinkedHashSet::from([1, 2]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(LinkedHashSetFrom)]
    pub fn from(items: [T]) -> Self;

    /// Insert an element and return the same set. An equal element is not duplicated.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// values.insert(7);
    /// std::debug::assert(values.len() == [0].len(), "deduplicated");
    /// ```
    #[intrinsic(SetInsert)]
    pub fn insert(self, item: T) -> LinkedHashSet<T>;

    /// Remove an equal element and report whether one existed.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.remove(7), "removed");
    /// std::debug::assert(!values.remove(7), "absent");
    /// ```
    #[intrinsic(SetRemove)]
    pub fn remove(self, item: T) -> bool;

    /// Remove all elements and return the same set.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::new();
    /// values.insert(7);
    /// values.clear();
    /// std::debug::assert(values.is_empty(), "cleared");
    /// ```
    #[intrinsic(SetClear)]
    pub fn clear(self) -> LinkedHashSet<T>;
}

/// Produce a fresh iterator over this shared source.
impl<T: Eq + Hash> Iterable for LinkedHashSet<T> {
    /// The value yielded at each traversal position.
    type Item = T;
    /// The native iterator retaining this source and its current position.
    type Iter = Iter<T>;
    /// Begin a new traversal without copying elements or transferring ownership.
    ///
    /// Native collection guards prevent structural mutation during traversal.
    /// Strings yield one Unicode scalar string at a time.
    #[intrinsic(CollectionIter)]
    fn iter(self) -> Iter<T>;
}

/// Construct fresh shallow storage from an iterable source.
impl<T: Eq + Hash> FromIterator<T> for LinkedHashSet<T> {
    /// Collect the source in traversal order into a fresh collection.
    ///
    /// Referenced objects retain identity. Sets discard equal duplicates; maps
    /// keep the last value for each equal key. Source and key-operation failures
    /// propagate without rolling back completed callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = [20, 22, 20].iter().collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "collected");
    /// ```
    #[intrinsic(CollectionFromIterator)]
    fn from_iter<I: Iterable<Item = T>>(source: I) -> Self;
}

/// Read-only access to a collection of distinct elements.
///
/// The interface does not require `Eq + Hash` or prescribe traversal order.
/// `LinkedHashSet<T>` uses `T: Eq + Hash` and insertion order; scripts may implement
/// other storage and equivalence policies. `contains` tests membership and `iter`
/// yields elements. Construct a concrete implementation before requesting a view.
///
/// A view shares its underlying object; it is not an immutable snapshot. Element
/// reads are shallow, type arguments are invariant, and equality and hashing use
/// the underlying object's identity rather than comparing all elements.
///
/// # Examples
///
/// ```kgr
/// val storage = LinkedHashSet::from([10, 20, 10]);
/// val view: Set<i32> = storage;
/// storage.insert(30);
/// std::debug::assert(view.contains(30), "live membership");
/// std::debug::assert_eq(view.len(), 3usize, "distinct elements");
/// ```
pub trait Set<T>: Iterable<Item = T, Iter = Iter<T>> {
    /// Returns the number of elements.
    fn len(self) -> usize;
    /// Reports whether the set is empty.
    fn is_empty(self) -> bool;
    /// Tests whether the set contains an element.
    fn contains(self, value: T) -> bool;
    /// Elements from the left set followed by previously absent elements from the right.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.union(b).len() == 3usize, "union");
    /// ```
    #[intrinsic(SetUnion)]
    fn union(self, rhs: Set<T>) -> LinkedHashSet<T> where T: Eq + Hash;

    /// Elements of the left set that also belong to the right set.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.intersection(b).contains(2), "intersection");
    /// ```
    #[intrinsic(SetIntersection)]
    fn intersection(self, rhs: Set<T>) -> LinkedHashSet<T> where T: Eq + Hash;

    /// Elements of the left set that do not belong to the right set.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.difference(b).contains(1), "difference");
    /// ```
    #[intrinsic(SetDifference)]
    fn difference(self, rhs: Set<T>) -> LinkedHashSet<T> where T: Eq + Hash;

    /// Left-only elements followed by right-only elements.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.symmetric_difference(b).len() == 2usize, "symmetric_difference");
    /// ```
    #[intrinsic(SetSymmetricDifference)]
    fn symmetric_difference(self, rhs: Set<T>) -> LinkedHashSet<T> where T: Eq + Hash;

    /// Whether every element of this set belongs to the other set.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.is_subset(b) == false, "is_subset");
    /// ```
    #[intrinsic(SetIsSubset)]
    fn is_subset(self, rhs: Set<T>) -> bool ;

    /// Whether every element of the other set belongs to this set.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.is_superset(b) == false, "is_superset");
    /// ```
    #[intrinsic(SetIsSuperset)]
    fn is_superset(self, rhs: Set<T>) -> bool ;

    /// Whether the two sets have no common elements.
    ///
    /// Uses the queried set's membership policy. Implementations used together
    /// should agree on equivalence. Both sources are guarded during traversal.
    /// Relations short-circuit and do not require hashing. New sets require
    /// `Eq + Hash`, retain source traversal order and shallow element references.
    /// The inputs are unchanged; callback side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Propagates membership, iteration, hashing and resource failures.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val a: Set<i32> = LinkedHashSet::from([1, 2]);
    /// val b: Set<i32> = LinkedHashSet::from([2, 3]);
    /// std::debug::assert(a.is_disjoint(b) == false, "is_disjoint");
    /// ```
    #[intrinsic(SetIsDisjoint)]
    fn is_disjoint(self, rhs: Set<T>) -> bool ;

}

/// Writable access to a collection of distinct elements.
///
/// Extends `Set<T>` with insertion, removal and clearing. Inserting an existing
/// element has no effect; `insert` returns unit. `remove` reports whether an element
/// was removed. Passing a mutable view as `Set<T>` shares the same object.
/// Implementations must validate and prepare a mutation before committing it.
/// For hash storage, callers must keep stored elements' equality and hashes stable.
///
/// # Examples
///
/// ```kgr
/// val view: MutableSet<i32> = LinkedHashSet::new();
/// view.insert(42);
/// view.insert(42);
/// val readable: Set<i32> = view;
/// std::debug::assert_eq(readable.len(), 1usize, "unique element");
/// std::debug::assert(view.remove(42), "removed");
/// ```
pub trait MutableSet<T>: Set<T> {
    /// Adds an element if absent.
    fn insert(self, value: T);
    /// Removes an element and reports whether it existed.
    fn remove(self, value: T) -> bool;
    /// Removes all elements.
    fn clear(self);
}

/// Provides the Set capability for the native storage class.
impl<T: Eq + Hash> Set<T> for LinkedHashSet<T> {
    /// Returns the number of elements.
    #[intrinsic(SetLen)]
    fn len(self) -> usize;
    /// Reports whether the set is empty.
    #[intrinsic(SetIsEmpty)]
    fn is_empty(self) -> bool;
    /// Tests whether the set contains an element.
    #[intrinsic(SetContains)]
    fn contains(self, value: T) -> bool;
}

/// Provides the MutableSet capability for the native storage class.
impl<T: Eq + Hash> MutableSet<T> for LinkedHashSet<T> {
    /// Adds an element if absent.
    #[intrinsic(SetInsert)]
    fn insert(self, value: T);
    /// Removes an element and reports whether it existed.
    #[intrinsic(SetRemove)]
    fn remove(self, value: T) -> bool;
    /// Removes all elements.
    #[intrinsic(SetClear)]
    fn clear(self);
}

impl<T: Eq + Hash> LinkedHashSet<T> {
    /// Construct empty storage with room for at least capacity elements.
    ///
    /// Capacity is an implementation detail and may exceed the requested minimum.
    /// Reservation never changes length, order or object identity. Size overflow
    /// or allocation failure traps without changing the logical contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::with_capacity(8usize);
    /// values.reserve(16usize);
    /// std::debug::assert(values.capacity() >= 16usize && values.is_empty(), "capacity");
    /// ```
    #[intrinsic(SetWithCapacity)]
    pub fn with_capacity(capacity: usize) -> LinkedHashSet<T>;

    /// Return the number of elements that fit without growing storage.
    ///
    /// Capacity is an implementation detail and may exceed the requested minimum.
    /// Reservation never changes length, order or object identity. Size overflow
    /// or allocation failure traps without changing the logical contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::with_capacity(8usize);
    /// values.reserve(16usize);
    /// std::debug::assert(values.capacity() >= 16usize && values.is_empty(), "capacity");
    /// ```
    #[intrinsic(SetCapacity)]
    pub fn capacity(self) -> usize;

    /// Reserve room for at least additional elements beyond the current length.
    ///
    /// Capacity is an implementation detail and may exceed the requested minimum.
    /// Reservation never changes length, order or object identity. Size overflow
    /// or allocation failure traps without changing the logical contents.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashSet<i32> = LinkedHashSet::with_capacity(8usize);
    /// values.reserve(16usize);
    /// std::debug::assert(values.capacity() >= 16usize && values.is_empty(), "capacity");
    /// ```
    #[intrinsic(SetReserve)]
    pub fn reserve(self, additional: usize);

}
