//! Hash sets using Eq and Hash. Equal values occupy one membership entry.
//!
//! `Set` provides read-only access; `MutableSet` also permits writes.
//! Read-only views share storage and observe changes through writable aliases.
//! `from` constructs fresh shallow storage; referenced elements retain identity.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// Read-only access to an insertion-ordered collection of distinct `T` values.
///
/// Elements require `Eq + Hash`. Equality determines membership; hashing chooses
/// candidate buckets. Equal elements must have equal hashes, but collisions are
/// allowed. The caller must not change an element's equality or hash while it is
/// stored, even through another reference. Remove it before such a change and
/// insert it again afterwards.
///
/// Assignment shares the set. `==` compares set identity, not membership. Set
/// operations that return a new set copy element references without deep-copying
/// objects. Iteration follows insertion order. Structural mutation during guarded
/// iteration traps. Custom equality and hash implementations may also trap.
///
/// # Examples
///
/// ```kgr
/// val values: MutableSet<i32> = MutableSet::new();
/// values.insert(7);
/// values.insert(7);
/// std::debug::assert(values.len() == [0].len(), "one distinct member");
/// std::debug::assert(values.contains(7), "membership");
/// ```
#[builtin_type(Set)]
pub type Set<T>;

/// A writable shared set. Copies preserve object identity.
///
/// # Examples
///
/// ```kgr
/// val values = MutableSet::from([1, 2]);
/// std::debug::assert(!values.is_empty(), "populated");
/// ```
#[builtin_type(MutableSet)]
pub type MutableSet<T>;

impl<T: Eq + Hash> Set<T> {
    /// Create a fresh empty set with read-only access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: Set<i32> = Set::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(SetNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow set from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// Equal elements are deduplicated. Elements must remain stable while stored.
    /// Input is traversed in order using the selected Eq and Hash implementations.
    ///
    /// # Panics
    ///
    /// Propagates traps from user comparison or hashing. No partial result is returned.
    /// Completed callback effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = Set::from([1, 2]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(SetFrom)]
    pub fn from(items: [T]) -> Self;

    /// Return the number of elements.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.len() == [0].len(), "length");
    /// ```
    #[intrinsic(SetLen)]
    pub fn len(self) -> usize;

    /// Return whether the set is empty.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(SetIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Test membership using Eq and Hash.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.contains(7), "member");
    /// ```
    #[intrinsic(SetContains)]
    pub fn contains(self, item: T) -> bool;

    /// Return a shallow array of elements.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// The returned array has independent container storage. Do not rely on a particular
    /// enumeration order.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.to_array().get("".len_bytes()) == Some(7), "snapshot");
    /// ```
    #[intrinsic(SetToArray)]
    pub fn to_array(self) -> MutableArray<T>;

    /// Create a set of elements in either set. Referenced objects remain shared.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Neither input container is modified. Do not rely on a particular enumeration order.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(1);
    /// val other: MutableSet<i32> = MutableSet::new();
    /// other.insert(2);
    /// val combined = values.union(other);
    /// std::debug::assert(combined.contains(1) && combined.contains(2), "union");
    /// ```
    #[intrinsic(SetUnion)]
    pub fn union(self, rhs: Set<T>) -> MutableSet<T>;

    /// Create a set of elements in both sets. Referenced objects remain shared.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Neither input container is modified. Do not rely on a particular enumeration order.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(1);
    /// values.insert(2);
    /// val other: MutableSet<i32> = MutableSet::new();
    /// other.insert(2);
    /// val common = values.intersection(other);
    /// std::debug::assert(common.len() == [0].len() && common.contains(2), "intersection");
    /// ```
    #[intrinsic(SetIntersection)]
    pub fn intersection(self, rhs: Set<T>) -> MutableSet<T>;

    /// Create a set of elements in the first set but not the second. Referenced objects remain
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Neither input container is modified. Do not rely on a particular enumeration order.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(1);
    /// values.insert(2);
    /// val other: MutableSet<i32> = MutableSet::new();
    /// other.insert(2);
    /// val remaining = values.difference(other);
    /// std::debug::assert(remaining.len() == [0].len() && remaining.contains(1), "difference");
    /// ```
    #[intrinsic(SetDifference)]
    pub fn difference(self, rhs: Set<T>) -> MutableSet<T>;
}

impl<T: Eq + Hash> MutableSet<T> {
    /// Create a fresh empty set with writable access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(MutableSetNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow set from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// Equal elements are deduplicated. Elements must remain stable while stored.
    /// Input is traversed in order using the selected Eq and Hash implementations.
    ///
    /// # Panics
    ///
    /// Propagates traps from user comparison or hashing. No partial result is returned.
    /// Completed callback effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = MutableSet::from([1, 2]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(MutableSetFrom)]
    pub fn from(items: [T]) -> Self;

    /// Insert an element and return the same set. An equal element is not duplicated.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// values.insert(7);
    /// std::debug::assert(values.len() == [0].len(), "deduplicated");
    /// ```
    #[intrinsic(SetInsert)]
    pub fn insert(self, item: T) -> MutableSet<T>;

    /// Remove an equal element and report whether one existed.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// std::debug::assert(values.remove(7), "removed");
    /// std::debug::assert(!values.remove(7), "absent");
    /// ```
    #[intrinsic(SetRemove)]
    pub fn remove(self, item: T) -> bool;

    /// Remove all elements and return the same set.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableSet<i32> = MutableSet::new();
    /// values.insert(7);
    /// values.clear();
    /// std::debug::assert(values.is_empty(), "cleared");
    /// ```
    #[intrinsic(SetClear)]
    pub fn clear(self) -> MutableSet<T>;
}
