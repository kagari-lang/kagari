pub trait From<Source> {
    fn from(value: Source) -> Self;
}
pub trait Into<Target> {
    fn into(self) -> Target;
}
pub trait TryFrom<Source> {
    type Error;
    fn try_from(value: Source) -> Result<Self, Self::Error>;
}
pub trait TryInto<Target> {
    type Error;
    fn try_into(self) -> Result<Target, Self::Error>;
}
#[builtin_enum(TryFromIntError)]
pub enum TryFromIntError {
    OutOfRange,
}
#[builtin_enum(Infallible)]
pub enum Infallible {}
