//! Helpers for native Array, Map, Set and String iteration. These are not arbitrary Iterator operations.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// Return the size of a native iterable collection.
///
/// Accepted native sources are arrays, maps, sets and strings. Array and set items are
/// elements; map items are `(key, value)` tuples; string items are one-scalar strings.
///
/// Map and set enumeration order is not a public ordering guarantee. This helper does not
/// consume a custom Iterator.
///
/// # Examples
///
/// ```kgr
/// std::debug::assert(std::iter::len("é!") == [0, 0].len(), "scalar count");
/// ```
#[intrinsic(IterLen)]
pub fn len<I: Iterable>(value: I) -> usize;

/// Test whether a native iterable collection is empty.
///
/// Accepted native sources are arrays, maps, sets and strings. Array and set items are
/// elements; map items are `(key, value)` tuples; string items are one-scalar strings.
///
/// Map and set enumeration order is not a public ordering guarantee. This helper does not
/// consume a custom Iterator.
///
/// # Examples
///
/// ```kgr
/// std::debug::assert(std::iter::is_empty(""), "empty");
/// ```
#[intrinsic(IterIsEmpty)]
pub fn is_empty<I: Iterable>(value: I) -> bool;

/// Return the indexed native iteration item, or None if out of bounds.
///
/// Accepted native sources are arrays, maps, sets and strings. Array and set items are
/// elements; map items are `(key, value)` tuples; string items are one-scalar strings.
///
/// Map and set enumeration order is not a public ordering guarantee. This helper does not
/// consume a custom Iterator.
///
/// Indices are zero-based positions in native enumeration. An out-of-range index returns
/// `None`.
///
/// # Examples
///
/// ```kgr
/// std::debug::assert(std::iter::get("é!", "".len_bytes()) == Some("é"), "scalar");
/// ```
#[intrinsic(IterGet)]
pub fn get<I: Iterable>(value: I, index: usize) -> Option<I::Item>;

/// Collect native iteration items into a shallow array.
///
/// Accepted native sources are arrays, maps, sets and strings. Array and set items are
/// elements; map items are `(key, value)` tuples; string items are one-scalar strings.
///
/// Map and set enumeration order is not a public ordering guarantee. This helper does not
/// consume a custom Iterator.
///
/// # Examples
///
/// ```kgr
/// val items = std::iter::to_array("hi");
/// std::debug::assert(items.get("".len_bytes()) == Some("h"), "collected");
/// ```
#[intrinsic(IterToArray)]
pub fn to_array<I: Iterable>(value: I) -> MutableArray<I::Item>;

/// Call the callback once for each native iteration item.
///
/// Accepted native sources are arrays, maps, sets and strings. Array and set items are
/// elements; map items are `(key, value)` tuples; string items are one-scalar strings.
///
/// Map and set enumeration order is not a public ordering guarantee. This helper does not
/// consume a custom Iterator.
///
/// The callback returns unit. Earlier callback side effects remain if a later callback
/// fails.
///
/// # Panics
///
/// Structural modification of a guarded source traps. Callback traps and execution
/// termination propagate to the caller.
///
/// # Examples
///
/// ```kgr
/// var total = 0;
/// std::iter::for_each([1, 2, 3], |item| { total += item; });
/// std::debug::assert(total == 6, "visited");
/// ```
#[intrinsic(IterForEach)]
pub fn for_each<I: Iterable>(value: I, callback: fn(I::Item) -> ()) -> ();

/// A stateful source of successive items.
///
/// next returns Some(item) or None. Do not assume custom iterators remain exhausted after
/// returning None unless their own contract promises it. A for loop stops at the first
/// None. Native cursors enforce structural modification guards and release execution
/// resources on exit.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     val cursor = [7].iter();
///     std::debug::assert(cursor.next() == Some(7), "first");
///     std::debug::assert(cursor.next() == None, "end");
/// }
/// ```
pub trait Iterator {
    /// The item returned by each successful step.
    type Item;
    /// Advance once and return the next item, or None.
    fn next(self) -> Option<Self::Item>;

    /// Collect remaining items into the destination selected by the result type.
    ///
    /// This terminal operation drives next until its first None. The destination's
    /// FromIterator implementation determines storage and duplicate handling.
    /// Array targets preserve order, Set targets deduplicate with Eq/Hash, and Map
    /// targets collect (key, value) pairs with the last value winning for equal keys.
    /// Native targets allocate fresh shallow storage. Annotate the result to choose
    /// read-only or mutable access. Earlier callback effects remain after a trap.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: Array<i32> = [20, 22].iter().collect();
    /// val unique: MutableSet<i32> = [20, 20, 22].iter().collect();
    /// std::debug::assert_eq(values.len(), unique.len(), "unique items");
    /// ```
    #[intrinsic(IteratorCollect)]
    fn collect<C: FromIterator<Self::Item>>(self) -> C;

    /// Lazily transform each item. Construction does not call the callback.
    #[intrinsic(IteratorMap)]
    fn map<U>(self, callback: fn(Self::Item) -> U) -> Cursor<U>;

    /// Lazily retain items for which the predicate returns true.
    /// Predicates receive ordinary values, including shared object references.
    #[intrinsic(IteratorFilter)]
    fn filter(self, predicate: fn(Self::Item) -> bool) -> Cursor<Self::Item>;

    /// Lazily transform items and omit callback results that are None.
    #[intrinsic(IteratorFilterMap)]
    fn filter_map<U>(self, callback: fn(Self::Item) -> Option<U>) -> Cursor<U>;

    /// Yield at most count items without evaluating any later items.
    #[intrinsic(IteratorTake)]
    fn take(self, count: usize) -> Cursor<Self::Item>;

    /// Lazily skip the first count items, then yield remaining items.
    #[intrinsic(IteratorSkip)]
    fn skip(self, count: usize) -> Cursor<Self::Item>;

    /// Yield (index, item) pairs starting at zero. Indices use usize.
    #[intrinsic(IteratorEnumerate)]
    fn enumerate(self) -> Cursor<(usize, Self::Item)>;

    /// Lazily pair items, stepping the left iterator before the right iterator.
    /// A missing item on either side ends the current traversal.
    #[intrinsic(IteratorZip)]
    fn zip<I: Iterable>(self, other: I) -> Cursor<(Self::Item, I::Item)>;

    /// Yield this iterator's items, then the other iterable's items.
    /// The first None permanently advances from the first iterator to the second.
    #[intrinsic(IteratorChain)]
    fn chain<I: Iterable<Item = Self::Item>>(self, other: I) -> Cursor<Self::Item>;
}

/// Obtain an iterator without transferring ownership of the source.
///
/// The associated Iter must implement Iterator with the same Item. Native collections
/// produce guarded cursors. An Iterator can itself be used as an iterable under the
/// standard derived rule. Custom iterators define their own consistency behavior.
/// Calling iter on a collection creates fresh progress; calling it on an iterator
/// returns the same stateful iterator. Aliases share progress. Neither operation
/// deep-copies elements or invalidates the source.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     var total = 0;
///     for item in [1, 2, 3] { total += item; }
///     std::debug::assert(total == 6, "iteration");
/// }
/// ```
pub trait Iterable {
    /// The item yielded by the iterator.
    type Item;
    /// The resulting iterator type.
    type Iter: Iterator<Item = Self::Item>;
    /// Create or obtain the iterator.
    fn iter(self) -> Self::Iter;
}

/// Construct a collection from the items of an iterable source.
///
/// The destination chooses its storage and duplicate policy. Construction uses
/// ordinary element values and does not deep-copy referenced objects. Native Array,
/// MutableArray, Set, MutableSet, Map and MutableMap implement this protocol. Their
/// from_iter constructors infer element types from the source. User-defined
/// collections can implement this protocol with the same generic source contract.
///
/// # Examples
///
/// ```kgr
/// struct Total { val value: i32 }
/// impl FromIterator<i32> for Total {
///     fn from_iter<I: Iterable<Item = i32>>(source: I) -> Self {
///         var value = 0;
///         for item in source { value += item; }
///         Total { value }
///     }
/// }
/// fn main() {
///     val total = Total::from_iter([20, 22]);
///     std::debug::assert_eq(total.value, 42, "collected");
/// }
/// ```
pub trait FromIterator<T> {
    /// Construct Self by consuming the source's iteration items.
    fn from_iter<I: Iterable<Item = T>>(source: I) -> Self;
}

/// A native iterator retaining its source and current position.
///
/// Obtain a cursor through `iter` on a native collection or string. It implements
/// `Iterator` and yields `Some(item)` until exhausted. Array and set items are
/// elements, map items are `(key, value)` tuples, and string items are one-scalar
/// strings. Yielded object references keep their identity.
///
/// The runtime manages structural iteration guards and releases them when the
/// cursor is closed or execution is cleaned up. Do not structurally modify a guarded
/// source. Map and set iteration order is unspecified. The representation is opaque;
/// there is no empty-struct constructor for a cursor.
///
/// # Examples
///
/// ```kgr
/// val cursor = [7].iter();
/// std::debug::assert(cursor.next() == Some(7), "first item");
/// std::debug::assert(cursor.next() == None, "exhausted");
/// ```
#[builtin_type(Cursor)]
pub type Cursor<T>;
