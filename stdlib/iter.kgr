//! Lazy iteration, terminal operations and collection construction.
//!
//! Callbacks execute on ordinary script frames and inherit the execution budget.

/// A stateful source of successive items.
///
/// next returns Some(item) or None. Do not assume custom iterators remain exhausted after
/// returning None unless their own contract promises it. A for loop stops at the first
/// None. Native iterators enforce structural modification guards and release execution
/// resources on exit.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     val iter = [7].iter();
///     std::debug::assert(iter.next() == Some(7), "first");
///     std::debug::assert(iter.next() == None, "end");
/// }
/// ```
pub trait Iterator {
    /// The item returned by each successful step.
    type Item;
    /// Advance once and return the next item, or None.
    fn next(self) -> Option<Self::Item>;

    /// Join remaining string items, inserting `separator` between adjacent items.
    ///
    /// Available only when Item is String; other values require explicit formatting.
    /// Reads each item once, stopping at the first None. Empty input produces an
    /// empty string. Aliases observe the consumed iterator progress. String fragments
    /// are buffered and joined once, avoiding repeated concatenation of the prefix.
    ///
    /// # Panics
    ///
    /// Source or callback traps, cancellation and resource exhaustion propagate.
    /// Earlier side effects remain visible. Native iteration guards are released on
    /// completion or failure; no partial result string is returned.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val text = [1, 2, 3].iter().map(|x| f"{x}").join(", ");
    /// std::debug::assert(text == "1, 2, 3", "formatted items");
    /// val parts = ["first", "second", "third"].iter();
    /// parts.next();
    /// std::debug::assert(parts.join("/") == "second/third", "remaining items");
    /// ```
    /// This standard traversal operation cannot be overridden by an implementation.
    #[intrinsic(IteratorJoin)]
    fn join(self, separator: String) -> String where Self: Iterator<Item = String>;

    /// Collect remaining items into the destination selected by the result type.
    ///
    /// This terminal operation invokes the selected FromIterator once with this
    /// original iterator. The constructor determines how much progress to consume,
    /// as well as storage and duplicate handling. Native Array/Map/Set constructors
    /// drive next until its first None; a custom constructor may consume fewer items.
    /// Array targets preserve order, Set targets deduplicate with Eq/Hash, and Map
    /// targets collect (key, value) pairs with the last value winning for equal keys.
    /// Native targets allocate fresh shallow storage. Annotate the result to choose
    /// the concrete destination. Earlier callback effects remain after a trap.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [20, 22].iter().collect();
    /// val unique: LinkedHashSet<i32> = [20, 20, 22].iter().collect();
    /// std::debug::assert_eq(values.len(), unique.len(), "unique items");
    /// ```
    ///
    /// # Fallible collection
    ///
    /// Result items can collect into Result<C, E> when C implements FromIterator<T>.
    /// Option items can similarly collect into Option<C>. The first Err or None
    /// stops traversal without reading later items. Err retains its original stack.
    /// Successful payloads are buffered before invoking C::from_iter exactly once.
    /// On failure the destination constructor is not called. Empty input invokes
    /// the constructor with an empty source and wraps its result in Ok or Some.
    /// Earlier callback effects remain visible. Nested wrappers apply recursively.
    ///
    /// ```kgr
    /// val items: ArrayList<Result<i32, String>> = [Ok(20), Ok(22)];
    /// val result: Result<ArrayList<i32>, String> = items.iter().collect();
    /// std::debug::assert_eq(result.map(|x| x[0] + x[1]), Ok(42), "collected");
    /// val missing: Option<ArrayList<i32>> = [Some(20), None].iter().collect();
    /// std::debug::assert_eq(missing, None, "short circuit");
    /// ```
    #[intrinsic(IteratorCollect)]
    fn collect<C: FromIterator<Self::Item>>(self) -> C;

    /// Lazily transform each item. Construction does not call the callback.
    ///
    ///
    /// A callback runs once for each item requested by downstream consumers.
    /// Discarding a pipeline never runs its callback.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [10, 11].iter().map(|x| x * 2).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "mapped");
    /// ```
    #[intrinsic(IteratorMap)]
    fn map<U>(self, callback: fn(Self::Item) -> U) -> Iter<U>;

    /// Lazily retain items for which the predicate returns true.
    /// Predicates receive ordinary values, including shared object references.
    ///
    ///
    /// Finding one output may consume many source items. The predicate can mutate
    /// shared objects, but cannot structurally modify a guarded source.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [20, 1, 22].iter().filter(|x| x % 2 == 0).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "retained");
    /// ```
    #[intrinsic(IteratorFilter)]
    fn filter(self, predicate: fn(Self::Item) -> bool) -> Iter<Self::Item>;

    /// Lazily transform items and omit callback results that are None.
    ///
    ///
    /// Some(value) yields one output; None continues searching. Returning None
    /// does not terminate the source traversal.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [0, 20, 22].iter()
    ///     .filter_map(|x| if x == 0 { None } else { Some(x) }).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "present values");
    /// ```
    #[intrinsic(IteratorFilterMap)]
    fn filter_map<U>(self, callback: fn(Self::Item) -> Option<U>) -> Iter<U>;

    /// Yield at most count items without evaluating any later items.
    ///
    ///
    /// A zero count never calls next on the source. Reaching the limit releases
    /// this iterator's native source guards when traversal finishes.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [20, 22, 99].iter().take("ab".len_bytes()).collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "limited");
    /// ```
    #[intrinsic(IteratorTake)]
    fn take(self, count: usize) -> Iter<Self::Item>;

    /// Lazily skip the first count items, then yield remaining items.
    ///
    ///
    /// Skipped items are consumed only when next is requested. Skipping counts
    /// items, not UTF-8 bytes. A first None ends the current traversal.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [99, 20, 22].iter().skip("a".len_bytes()).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "remaining");
    /// ```
    #[intrinsic(IteratorSkip)]
    fn skip(self, count: usize) -> Iter<Self::Item>;

    /// Yield (index, item) pairs starting at zero. Indices use usize.
    ///
    ///
    /// Indices count yielded items, starting at zero for this adapter.
    /// Index overflow traps instead of wrapping.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<(usize, String)> = ["left", "right"].iter().enumerate().collect();
    /// std::debug::assert_eq(values[1][0], "a".len_bytes(), "index");
    /// std::debug::assert_eq(values[1][1], "right", "item");
    /// ```
    #[intrinsic(IteratorEnumerate)]
    fn enumerate(self) -> Iter<(usize, Self::Item)>;

    /// Lazily pair items, stepping the left iterator before the right iterator.
    /// A missing item on either side ends the current traversal.
    ///
    ///
    /// The other source is converted with iter once during construction. When
    /// the right side ends first, one unmatched left item may be consumed. Using
    /// the same iterator on both sides consumes two successive items per pair.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<(i32, String)> = [20, 22].iter().zip(["left", "right"]).collect();
    /// std::debug::assert_eq(values[1][0], 22, "paired");
    /// ```
    #[intrinsic(IteratorZip)]
    fn zip<I: Iterable>(self, other: I) -> Iter<(Self::Item, I::Item)>;

    /// Yield this iterator's items, then the other iterable's items.
    /// The first None permanently advances from the first iterator to the second.
    ///
    ///
    /// The other source is converted with iter once during construction. Neither
    /// side is reset. Once both sides return None, this adapter stays exhausted.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [20].iter().chain([22]).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "chained");
    /// ```
    #[intrinsic(IteratorChain)]
    fn chain<I: Iterable<Item = Self::Item>>(self, other: I) -> Iter<Self::Item>;

    /// Return the first matching item, leaving subsequent items unconsumed.
    ///
    ///
    /// The matching item is consumed. Aliases can continue from the following
    /// item. If no item matches before the first None, returns None.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val iter = [1, 20, 22].iter();
    /// std::debug::assert_eq(iter.find(|x| x == 20), Some(20), "found");
    /// std::debug::assert_eq(iter.next(), Some(22), "continuation");
    /// ```
    #[intrinsic(IteratorFind)]
    fn find(self, predicate: fn(Self::Item) -> bool) -> Option<Self::Item>;

    /// Stop at the first true predicate result. Empty iterators return false.
    ///
    ///
    /// Consumes the decisive item and releases native guards before returning.
    /// Later items remain available through the same iterator.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val iter = [1, 20, 22].iter();
    /// std::debug::assert(iter.any(|x| x == 20), "match");
    /// std::debug::assert_eq(iter.next(), Some(22), "continuation");
    /// ```
    #[intrinsic(IteratorAny)]
    fn any(self, predicate: fn(Self::Item) -> bool) -> bool;

    /// Stop at the first false predicate result. Empty iterators return true.
    ///
    ///
    /// Consumes the first failing item and releases native guards before returning.
    /// Later items remain available through the same iterator.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val iter = [20, 1, 22].iter();
    /// std::debug::assert(!iter.all(|x| x % 2 == 0), "first failure");
    /// std::debug::assert_eq(iter.next(), Some(22), "continuation");
    /// ```
    #[intrinsic(IteratorAll)]
    fn all(self, predicate: fn(Self::Item) -> bool) -> bool;

    /// Count remaining items. Overflow traps instead of wrapping.
    ///
    ///
    /// Visits every remaining item through the first None. This is a consuming
    /// terminal operation, not a constant-time collection size query.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert_eq([20, 22].iter().count(), "ab".len_bytes(), "count");
    /// ```
    #[intrinsic(IteratorCount)]
    fn count(self) -> usize;

    /// Accumulate remaining items from left to right, starting with initial.
    ///
    ///
    /// The callback receives (accumulator, item). Empty input returns initial
    /// unchanged. Both values remain rooted during callback execution.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val sum = [20, 22].iter().fold(0, |sum, item| sum + item);
    /// std::debug::assert_eq(sum, 42, "folded");
    /// ```
    #[intrinsic(IteratorFold)]
    fn fold<A>(self, initial: A, callback: fn(A, Self::Item) -> A) -> A;

    /// Call the callback once for each remaining item. Earlier effects survive traps.
    ///
    ///
    /// Visits items in traversal order until the first None. Use a for loop when
    /// the body needs break, continue or return from the enclosing function.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// var sum = 0;
    /// [20, 22].iter().for_each(|item| { sum += item; });
    /// std::debug::assert_eq(sum, 42, "visited");
    /// ```
    #[intrinsic(IteratorForEach)]
    fn for_each(self, callback: fn(Self::Item) -> ());

    /// Split items into matching and nonmatching destinations, preserving order.
    /// Items are buffered in two shallow arrays before invoking FromIterator.
    ///
    ///
    /// The first destination contains matching items; the second contains the
    /// others. The result type selects C. Predicate effects precede destination
    /// construction, which runs once for the matching side before the other side,
    /// including empty sides. The predicate runs once per visited item. A failure
    /// constructing the matching side skips construction of the other side.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val split: (ArrayList<i32>, ArrayList<i32>) = [20, 1, 22].iter().partition(|x| x % 2 == 0);
    /// std::debug::assert_eq(split[0][0] + split[0][1], 42, "matching");
    /// std::debug::assert_eq(split[1][0], 1, "other");
    /// ```
    #[intrinsic(IteratorPartition)]
    fn partition<C: FromIterator<Self::Item>>(self, predicate: fn(Self::Item) -> bool) -> (C, C);

    /// Group the entire input by a key computed once per item.
    /// This Kagari extension returns fresh mutable groups in first-key insertion order.
    /// Items within each group retain traversal order. Keys obey Eq and Hash.
    ///
    ///
    /// Unlike adjacent-run grouping, equal keys anywhere in the input share a
    /// group. This eagerly consumes remaining input. Keys must keep stable Eq/Hash
    /// behavior while stored. Containers are fresh; element objects remain shared.
    ///
    /// # Panics
    ///
    /// Source traps, callback traps, resource exhaustion and cancellation propagate.
    /// Structural modification of a guarded source traps before the modification.
    /// Completed callback side effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val groups = [20, 1, 22, 3].iter().group_by(|x| x % 2);
    /// val even = groups.get(0).unwrap_or([0]);
    /// std::debug::assert_eq(even[0] + even[1], 42, "grouped");
    /// std::debug::assert_eq(groups.keys()[0], 0, "first key order");
    /// ```
    #[intrinsic(IteratorGroupBy)]
    fn group_by<K: Eq + Hash>(self, key: fn(Self::Item) -> K) -> LinkedHashMap<K, ArrayList<Self::Item>>;
    /// Yield items while the predicate remains true.
    ///
    /// The first rejected item is consumed. No later source items are requested.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [1, 2, 9].iter().take_while(|x| x < 3).collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "prefix");
    /// ```
    #[intrinsic(IteratorTakeWhile)]
    fn take_while(self, predicate: fn(Self::Item) -> bool) -> Iter<Self::Item>;

    /// Skip the initial items accepted by the predicate.
    ///
    /// After the first rejection, yield every remaining item without testing again.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [1, 3, 1].iter().skip_while(|x| x < 3).collect();
    /// std::debug::assert_eq(values[1], 1, "suffix");
    /// ```
    #[intrinsic(IteratorSkipWhile)]
    fn skip_while(self, predicate: fn(Self::Item) -> bool) -> Iter<Self::Item>;

    /// Observe each yielded item without replacing it.
    ///
    /// The callback runs only when an item is requested downstream.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// var seen = 0;
    /// val items = [20, 22].iter().inspect(|x| { seen += x; });
    /// std::debug::assert_eq(seen, 0, "lazy");
    /// items.count();
    /// std::debug::assert_eq(seen, 42, "observed");
    /// ```
    #[intrinsic(IteratorInspect)]
    fn inspect(self, callback: fn(Self::Item) -> ()) -> Iter<Self::Item>;

    /// Stop permanently after the first absent item.
    ///
    /// Later calls return None without advancing the source again.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val items = [7].iter().fuse();
    /// std::debug::assert_eq(items.next(), Some(7), "item");
    /// std::debug::assert_eq(items.next(), None, "end");
    /// std::debug::assert_eq(items.next(), None, "still ended");
    /// ```
    #[intrinsic(IteratorFuse)]
    fn fuse(self) -> Iter<Self::Item>;

    /// Return the first present callback result.
    ///
    /// The matching item is consumed; subsequent source items remain unconsumed.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val found = [1, 20, 22].iter().find_map(|x| if x > 1 { Some(x) } else { None });
    /// std::debug::assert_eq(found, Some(20), "found");
    /// ```
    #[intrinsic(IteratorFindMap)]
    fn find_map<U>(self, callback: fn(Self::Item) -> Option<U>) -> Option<U>;

    /// Return the zero-based position of the first matching item.
    ///
    /// Positions count from the current iterator position. The matching item is consumed.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val found = [20, 22].iter().position(|x| x == 22);
    /// std::debug::assert_eq(found, Some("a".len_bytes()), "position");
    /// ```
    #[intrinsic(IteratorPosition)]
    fn position(self, predicate: fn(Self::Item) -> bool) -> Option<usize>;

    /// Skip index items and return the following item.
    ///
    /// Index zero means the next item. Out-of-range requests exhaust the source.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val items = [1, 20, 22].iter();
    /// std::debug::assert_eq(items.nth("a".len_bytes()), Some(20), "nth");
    /// std::debug::assert_eq(items.next(), Some(22), "remaining");
    /// ```
    #[intrinsic(IteratorNth)]
    fn nth(self, index: usize) -> Option<Self::Item>;

    /// Return the last remaining item.
    ///
    /// Traverses through the first None. Empty input returns None.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert_eq([20, 22].iter().last(), Some(22), "last");
    /// ```
    #[intrinsic(IteratorLast)]
    fn last(self) -> Option<Self::Item>;

    /// Reduce items from left to right without an initial value.
    ///
    /// The first item initializes the accumulator. Empty input returns None.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert_eq([20, 22].iter().reduce(|a, b| a + b), Some(42), "reduced");
    /// ```
    #[intrinsic(IteratorReduce)]
    fn reduce(self, callback: fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item>;

    /// Return the minimum item using a comparison function.
    ///
    /// Empty input returns None. Equal minima retain the first item.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().min_by(|a, b| a.cmp(b));
    /// std::debug::assert_eq(item, Some(20), "minimum");
    /// ```
    #[intrinsic(IteratorMinBy)]
    fn min_by(self, compare: fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item>;

    /// Return the maximum item using a comparison function.
    ///
    /// Empty input returns None. Equal maxima retain the last item.
    /// Aliases share source progress. Completed callback effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Source and callback traps, cancellation and resource exhaustion propagate.
    /// Native iteration guards are released when traversal ends or execution fails.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().max_by(|a, b| a.cmp(b));
    /// std::debug::assert_eq(item, Some(22), "maximum");
    /// ```
    #[intrinsic(IteratorMaxBy)]
    fn max_by(self, compare: fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item>;
    /// Return the minimum remaining item.
    ///
    /// Empty input returns None. Equal extrema retain the first item.
    ///
    /// # Panics
    ///
    /// Source, comparison and callback traps propagate; completed effects remain.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().min();
    /// std::debug::assert_eq(item, Some(20), "extreme");
    /// ```
    #[intrinsic(IteratorMin)]
    fn min(self) -> Option<Self::Item> where Self::Item: Ord;

    /// Return the maximum remaining item.
    ///
    /// Empty input returns None. Equal extrema retain the last item.
    ///
    /// # Panics
    ///
    /// Source, comparison and callback traps propagate; completed effects remain.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().max();
    /// std::debug::assert_eq(item, Some(22), "extreme");
    /// ```
    #[intrinsic(IteratorMax)]
    fn max(self) -> Option<Self::Item> where Self::Item: Ord;

    /// Return the minimum remaining item.
    ///
    /// Empty input returns None. Equal extrema retain the first item.
    /// The key function runs exactly once per visited item, in source order.
    ///
    /// # Panics
    ///
    /// Source, comparison and callback traps propagate; completed effects remain.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().min_by_key(|x| x);
    /// std::debug::assert_eq(item, Some(20), "extreme");
    /// ```
    #[intrinsic(IteratorMinByKey)]
    fn min_by_key<K: Ord>(self, key: fn(Self::Item) -> K) -> Option<Self::Item>;

    /// Return the maximum remaining item.
    ///
    /// Empty input returns None. Equal extrema retain the last item.
    /// The key function runs exactly once per visited item, in source order.
    ///
    /// # Panics
    ///
    /// Source, comparison and callback traps propagate; completed effects remain.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val item = [22, 20].iter().max_by_key(|x| x);
    /// std::debug::assert_eq(item, Some(22), "extreme");
    /// ```
    #[intrinsic(IteratorMaxByKey)]
    fn max_by_key<K: Ord>(self, key: fn(Self::Item) -> K) -> Option<Self::Item>;
    /// Lazily expand one level of iterable items.
    ///
    /// Exhaust each inner iterator before requesting the next outer item.
    /// Empty inner iterables are skipped. Aliases share outer and inner progress.
    /// The first outer None ends this adapter permanently.
    /// Inner sources and callbacks remain rooted across calls and execution sessions.
    ///
    /// # Panics
    ///
    /// Source and callback traps propagate. Structural mutation of guarded sources
    /// traps. Short-circuiting closes active native inner and outer guards.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [20, 22].iter().flat_map(|x| [x]).collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "flattened map");
    /// ```
    #[intrinsic(IteratorFlatMap)]
    fn flat_map<I: Iterable>(self, callback: fn(Self::Item) -> I) -> Iter<I::Item>;

    /// Lazily expand one level of iterable items.
    ///
    /// Exhaust each inner iterator before requesting the next outer item.
    /// Empty inner iterables are skipped. Aliases share outer and inner progress.
    /// The first outer None ends this adapter permanently.
    /// Inner sources and callbacks remain rooted across calls and execution sessions.
    ///
    /// # Panics
    ///
    /// Source and callback traps propagate. Structural mutation of guarded sources
    /// traps. Short-circuiting closes active native inner and outer guards.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: ArrayList<i32> = [[20], [22]].iter().flatten().collect();
    /// std::debug::assert_eq(values[0] + values[1], 42, "flattened");
    /// ```
    #[intrinsic(IteratorFlatten)]
    fn flatten(self) -> Iter<<Self::Item as Iterable>::Item> where Self::Item: Iterable;
    /// Aggregate remaining items using the destination's Sum implementation.
    ///
    /// Annotate the result to select the destination type. Native numeric inputs
    /// aggregate from left to right in the same numeric type; empty input returns 0.
    /// User destinations choose their own construction and identity rules.
    ///
    /// # Panics
    ///
    /// Integer overflow traps. Source and implementation failures propagate.
    /// Completed effects remain; native guards are released on completion or failure.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val total: i32 = [20, 22].iter().sum();
    /// std::debug::assert_eq(total, 42, "aggregate");
    /// ```
    #[intrinsic(IteratorSum)]
    fn sum<S: Sum<Self::Item>>(self) -> S;

    /// Aggregate remaining items using the destination's Product implementation.
    ///
    /// Annotate the result to select the destination type. Native numeric inputs
    /// aggregate from left to right in the same numeric type; empty input returns 1.
    /// User destinations choose their own construction and identity rules.
    ///
    /// # Panics
    ///
    /// Integer overflow traps. Source and implementation failures propagate.
    /// Completed effects remain; native guards are released on completion or failure.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val total: i32 = [6, 7].iter().product();
    /// std::debug::assert_eq(total, 42, "aggregate");
    /// ```
    #[intrinsic(IteratorProduct)]
    fn product<S: Product<Self::Item>>(self) -> S;
}

/// Obtain an iterator without transferring ownership of the source.
///
/// The associated Iter must implement Iterator with the same Item. Native collections
/// produce guarded iterators. An Iterator can itself be used as an iterable under the
/// standard derived rule. Custom iterators define their own consistency behavior.
/// Calling iter on a collection creates fresh progress; calling it on an iterator
/// returns the same stateful iterator. Aliases share progress. Neither operation
/// deep-copies elements or invalidates the source.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     var total = 0;
///     for item in [1, 2, 3] { total += item; }
///     std::debug::assert(total == 6, "iteration");
/// }
/// ```
pub trait Iterable {
    /// The item yielded by the iterator.
    type Item;
    /// The resulting iterator type.
    type Iter: Iterator<Item = Self::Item>;
    /// Create or obtain the iterator.
    fn iter(self) -> Self::Iter;
}

/// Construct a collection from the items of an iterable source.
///
/// The destination chooses its storage and duplicate policy. Construction uses
/// ordinary element values and does not deep-copy referenced objects. Native Array,
/// ArrayList, Set, LinkedHashSet, Map and LinkedHashMap implement this protocol. Their
/// from_iter constructors infer element types from the source. User-defined
/// collections can implement this protocol with the same generic source contract.
///
/// # Examples
///
/// ```kgr
/// struct Total { val value: i32 }
/// impl FromIterator<i32> for Total {
///     fn from_iter<I: Iterable<Item = i32>>(source: I) -> Self {
///         var value = 0;
///         for item in source { value += item; }
///         Total { value }
///     }
/// }
/// fn main() {
///     val total = Total::from_iter([20, 22]);
///     std::debug::assert_eq(total.value, 42, "collected");
/// }
/// ```
pub trait FromIterator<T> {
    /// Construct Self by consuming the source's iteration items.
    fn from_iter<I: Iterable<Item = T>>(source: I) -> Self;
}

/// A native iterator retaining its source and current position.
///
/// Obtain an iterator through `iter` on a native collection or string. It implements
/// `Iterator` and yields `Some(item)` until exhausted. Array and set items are
/// elements, map items are `(key, value)` tuples, and string items are one-scalar
/// strings. Yielded object references keep their identity.
///
/// The runtime manages structural iteration guards and releases them when the
/// iterator is closed or execution is cleaned up. Do not structurally modify a guarded
/// source. Map and set traversal uses insertion order. The representation is opaque;
/// there is no empty-struct constructor for an iterator. Native iterators read slots on
/// demand; replacing an unvisited slot is visible to subsequent steps. A rooted
/// iterator retains its source, callbacks and captures across execution sessions.
/// Structural changes after a traversal ends invalidate subsequent resumption.
///
/// `Iter<T>` is the concrete native type. `Iterable::Iter` is an associated type
/// that may select this type or any user-defined implementation of `Iterator`.
///
/// # Examples
///
/// ```kgr
/// val iter = [7].iter();
/// std::debug::assert(iter.next() == Some(7), "first item");
/// std::debug::assert(iter.next() == None, "exhausted");
/// ```
#[builtin_type(Iter)]
pub type Iter<T>;

/// Advance a native iterator using its retained traversal state.
///
/// Adapter and terminal methods, including `map`, `filter` and `collect`, use
/// the defaults declared on `Iterator`. Aliases of an iterator share progress.
impl<T> Iterator for Iter<T> {
    /// The value produced by each successful step.
    type Item = T;

    /// Return the next item, or `None` when this iterator is exhausted.
    ///
    /// Object items preserve their identity. Advancing a lazy adapter evaluates
    /// its pending callbacks as needed to produce the next item.
    ///
    /// # Panics
    ///
    /// Traps if the source was structurally modified before resumption, or if
    /// an adapter callback traps. Execution limits also apply to each step.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: Iter<i32> = [20, 22].iter();
    /// std::debug::assert(values.next() == Some(20), "first item");
    /// std::debug::assert(values.next() == Some(22), "second item");
    /// std::debug::assert(values.next() == None, "exhausted");
    /// ```
    #[intrinsic(IterNext)]
    fn next(self) -> Option<T>;
}

/// Construct an aggregate from a sequence of input values.
///
/// Numeric types implement Sum for the same input type. Empty numeric input
/// returns 0; integer arithmetic is checked. User types define their own
/// aggregation behavior and may select a different result representation.
///
/// # Examples
///
/// ```kgr
/// struct Total { val value: i32 }
/// impl Sum<i32> for Total {
///     fn sum<I: Iterable<Item = i32>>(source: I) -> Self {
///         var value = 0;
///         for item in source { value += item; }
///         Total { value }
///     }
/// }
/// fn main() {
///     val total: Total = [20, 22].iter().sum();
///     std::debug::assert_eq(total.value, 42, "custom aggregate");
/// }
/// ```
pub trait Sum<T> {
    /// Aggregate the iterable source into Self.
    fn sum<I: Iterable<Item = T>>(source: I) -> Self;
}

/// Construct an aggregate from a sequence of input values.
///
/// Numeric types implement Product for the same input type. Empty numeric input
/// returns 1; integer arithmetic is checked. User types define their own
/// aggregation behavior and may select a different result representation.
///
/// # Examples
///
/// ```kgr
/// struct Total { val value: i32 }
/// impl Product<i32> for Total {
///     fn product<I: Iterable<Item = i32>>(source: I) -> Self {
///         var value = 1;
///         for item in source { value *= item; }
///         Total { value }
///     }
/// }
/// fn main() {
///     val total: Total = [6, 7].iter().product();
///     std::debug::assert_eq(total.value, 42, "custom aggregate");
/// }
/// ```
pub trait Product<T> {
    /// Aggregate the iterable source into Self.
    fn product<I: Iterable<Item = T>>(source: I) -> Self;
}

// Numeric implementations retain checked scalar destinations and iterable sources.

impl Sum<i8> for i8 {
    /// Sum this scalar type from an iterable, using checked arithmetic. Empty input returns 0.
    #[intrinsic(NumericSum)]
    fn sum<I: Iterable<Item = i8>>(source: I) -> Self;
}

impl Product<i8> for i8 {
    /// Multiply this scalar type from an iterable, using checked arithmetic. Empty input returns 1.
    #[intrinsic(NumericProduct)]
    fn product<I: Iterable<Item = i8>>(source: I) -> Self;
}

