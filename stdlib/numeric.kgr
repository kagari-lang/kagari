//! Explicit integer arithmetic policies.
//!
//! Ordinary operators trap on overflow in every build profile. These methods
//! select wrapping, checked, overflowing or saturating behavior explicitly.
//! isize and usize are always 64-bit. No operation modifies its receiver.
//!
//! # Examples
//!
//! ```kgr
//! std::debug::assert(255u8.wrapping_add(1u8) == 0u8, "wrap");
//! std::debug::assert(255u8.checked_add(1u8) == None, "checked");
//! std::debug::assert(255u8.overflowing_add(1u8) == (0u8, true), "carry");
//! std::debug::assert(255u8.saturating_add(1u8) == 255u8, "clamp");
//! std::debug::assert(0u16.wrapping_add_signed(-1i16) == 65535u16, "offset");
//! std::debug::assert(128u8.rotate_left(1u32) == 1u8, "rotate");
//! ```
//!
//! Checked operations return None for overflow or division by zero. Signed
//! MIN / -1 and MIN % -1 also return None. Overflowing operations return the
//! wrapped result and a flag; the flag is signed overflow for signed receivers
//! and carry/borrow for unsigned receivers. It is not both CPU flags at once.

impl i8 {
    /// Return the low bits of the result, wrapping at the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).wrapping_add(1i8) == -128i8, "wrapping_add");
    /// ```
    #[numeric(WrappingAdd)]
    pub fn wrapping_add(self, rhs: i8) -> i8;

    /// Return the low bits of the result, wrapping at the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((-128i8).wrapping_sub(1i8) == 127i8, "wrapping_sub");
    /// ```
    #[numeric(WrappingSub)]
    pub fn wrapping_sub(self, rhs: i8) -> i8;

    /// Return the low bits of the result, wrapping at the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).wrapping_mul(2i8) == -2i8, "wrapping_mul");
    /// ```
    #[numeric(WrappingMul)]
    pub fn wrapping_mul(self, rhs: i8) -> i8;

    /// Return None on overflow or an undefined integer operation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).checked_add(1i8) == None, "checked_add");
    /// ```
    #[numeric(CheckedAdd)]
    pub fn checked_add(self, rhs: i8) -> Option<i8>;

    /// Return None on overflow or an undefined integer operation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((-128i8).checked_sub(1i8) == None, "checked_sub");
    /// ```
    #[numeric(CheckedSub)]
    pub fn checked_sub(self, rhs: i8) -> Option<i8>;

    /// Return None on overflow or an undefined integer operation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).checked_mul(2i8) == None, "checked_mul");
    /// ```
    #[numeric(CheckedMul)]
    pub fn checked_mul(self, rhs: i8) -> Option<i8>;

    /// Return None on overflow or an undefined integer operation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((-128i8).checked_div(-1i8) == None, "checked_div");
    /// ```
    #[numeric(CheckedDiv)]
    pub fn checked_div(self, rhs: i8) -> Option<i8>;

    /// Return None on overflow or an undefined integer operation.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((42i8).checked_rem(5i8) == Some(2i8), "checked_rem");
    /// ```
    #[numeric(CheckedRem)]
    pub fn checked_rem(self, rhs: i8) -> Option<i8>;

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).overflowing_add(1i8) == (-128i8, true), "overflowing_add");
    /// ```
    #[numeric(OverflowingAdd)]
    pub fn overflowing_add(self, rhs: i8) -> (i8, bool);

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((-128i8).overflowing_sub(1i8) == (127i8, true), "overflowing_sub");
    /// ```
    #[numeric(OverflowingSub)]
    pub fn overflowing_sub(self, rhs: i8) -> (i8, bool);

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).overflowing_mul(2i8) == (-2i8, true), "overflowing_mul");
    /// ```
    #[numeric(OverflowingMul)]
    pub fn overflowing_mul(self, rhs: i8) -> (i8, bool);

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).saturating_add(1i8) == 127i8, "saturating_add");
    /// ```
    #[numeric(SaturatingAdd)]
    pub fn saturating_add(self, rhs: i8) -> i8;

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((-128i8).saturating_sub(1i8) == -128i8, "saturating_sub");
    /// ```
    #[numeric(SaturatingSub)]
    pub fn saturating_sub(self, rhs: i8) -> i8;

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((127i8).saturating_mul(2i8) == 127i8, "saturating_mul");
    /// ```
    #[numeric(SaturatingMul)]
    pub fn saturating_mul(self, rhs: i8) -> i8;

    /// Rotate bits by a count reduced modulo the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((1i8).rotate_left(1u32) == 2i8, "rotate_left");
    /// ```
    #[numeric(RotateLeft)]
    pub fn rotate_left(self, rhs: u32) -> i8;

    /// Rotate bits by a count reduced modulo the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((1i8).rotate_right(1u32) == -128i8, "rotate_right");
    /// ```
    #[numeric(RotateRight)]
    pub fn rotate_right(self, rhs: u32) -> i8;

}

