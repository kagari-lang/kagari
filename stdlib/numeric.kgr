    #[numeric(CheckedRem)]
    pub fn checked_rem(self, rhs: u64) -> Option<u64>;

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((18446744073709551615u64).overflowing_add(1u64) == (0u64, true), "overflowing_add");
    /// ```
    #[numeric(OverflowingAdd)]
    pub fn overflowing_add(self, rhs: u64) -> (u64, bool);

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((0u64).overflowing_sub(1u64) == (18446744073709551615u64, true), "overflowing_sub");
    /// ```
    #[numeric(OverflowingSub)]
    pub fn overflowing_sub(self, rhs: u64) -> (u64, bool);

    /// Return the wrapped result and whether the mathematical result overflows.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((18446744073709551615u64).overflowing_mul(2u64) == (18446744073709551614u64, true), "overflowing_mul");
    /// ```
    #[numeric(OverflowingMul)]
    pub fn overflowing_mul(self, rhs: u64) -> (u64, bool);

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((18446744073709551615u64).saturating_add(1u64) == 18446744073709551615u64, "saturating_add");
    /// ```
    #[numeric(SaturatingAdd)]
    pub fn saturating_add(self, rhs: u64) -> u64;

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((0u64).saturating_sub(1u64) == 0u64, "saturating_sub");
    /// ```
    #[numeric(SaturatingSub)]
    pub fn saturating_sub(self, rhs: u64) -> u64;

    /// Clamp the mathematical result to the receiver type range.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((18446744073709551615u64).saturating_mul(2u64) == 18446744073709551615u64, "saturating_mul");
    /// ```
    #[numeric(SaturatingMul)]
    pub fn saturating_mul(self, rhs: u64) -> u64;

    /// Return the low bits of the result, wrapping at the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((0u64).wrapping_add_signed(-1i64) == 18446744073709551615u64, "wrapping_add_signed");
    /// ```
    #[numeric(WrappingAddSigned)]
    pub fn wrapping_add_signed(self, rhs: i64) -> u64;

    /// Rotate bits by a count reduced modulo the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((1u64).rotate_left(1u32) == 2u64, "rotate_left");
    /// ```
    #[numeric(RotateLeft)]
    pub fn rotate_left(self, rhs: u32) -> u64;

    /// Rotate bits by a count reduced modulo the receiver width.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert((1u64).rotate_right(1u32) == 9223372036854775808u64, "rotate_right");
    /// ```
    #[numeric(RotateRight)]
    pub fn rotate_right(self, rhs: u32) -> u64;

}

