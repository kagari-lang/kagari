    #[numeric(SaturatingAdd)]
    pub fn saturating_add(self, rhs: usize) -> usize;

    /// Clamp the mathematical result to the receiver type range.
    #[numeric(SaturatingSub)]
    pub fn saturating_sub(self, rhs: usize) -> usize;

    /// Clamp the mathematical result to the receiver type range.
    #[numeric(SaturatingMul)]
    pub fn saturating_mul(self, rhs: usize) -> usize;

    /// Return the low bits of the result, wrapping at the receiver width.
    #[numeric(WrappingAddSigned)]
    pub fn wrapping_add_signed(self, rhs: isize) -> usize;

    /// Rotate bits by a count reduced modulo the receiver width.
    #[numeric(RotateLeft)]
    pub fn rotate_left(self, rhs: u32) -> usize;

    /// Rotate bits by a count reduced modulo the receiver width.
    #[numeric(RotateRight)]
    pub fn rotate_right(self, rhs: u32) -> usize;

}

