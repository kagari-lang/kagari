//! Optional values, conditional transformations and explicit Result conversion.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// An optional value: either `Some(T)` or `None`.
///
/// Use `Option` when absence is expected and needs no error payload. `get` operations
/// use it to report a missing element. `None` carries no error origin or stack.
/// Pattern matching handles both alternatives; `?` extracts `Some` or returns
/// `None` early from a function returning `Option`.
///
/// Default equality compares the variant and then its payload using the payload's
/// comparison rules. Copying an option preserves references to mutable payloads.
/// `unwrap_or` evaluates its fallback eagerly; `unwrap_or_else` calls a fallback
/// only when the value is absent.
///
/// # Examples
///
/// ```kgr
/// fn increment(value: Option<i32>) -> Option<i32> {
///     val number = value?;
///     Some(number + 1)
/// }
/// fn main() {
///     std::debug::assert(increment(Some(7)) == Some(8), "present");
///     std::debug::assert(increment(None) == None, "propagated absence");
/// }
/// ```
#[builtin_enum(Option)]
pub enum Option<T> {
    /// Contains a value.
    Some(T),
    /// Contains no value and carries no error trace.
    None,
}

impl<T> Option<T> {
    /// Call fallback only when absent.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).unwrap_or_else(|| 9) == 7, "unwrap_or_else");
    /// ```
    #[intrinsic(OptionUnwrapOrElse)]
    pub fn unwrap_or_else(self, fallback: fn() -> T) -> T;

    /// Call fallback only when absent.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).or_else(|| Some(9)) == Some(7), "or_else");
    /// ```
    #[intrinsic(OptionOrElse)]
    pub fn or_else(self, fallback: fn() -> Option<T>) -> Option<T>;

    /// Transform a present value or return the eagerly evaluated fallback.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).map_or(0, |x| x + 1) == 8, "map_or");
    /// ```
    #[intrinsic(OptionMapOr)]
    pub fn map_or<U>(self, fallback: U, transform: fn(T) -> U) -> U;

    /// Call exactly the selected fallback or transformation.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).map_or_else(|| 0, |x| x + 1) == 8, "map_or_else");
    /// ```
    #[intrinsic(OptionMapOrElse)]
    pub fn map_or_else<U>(self, fallback: fn() -> U, transform: fn(T) -> U) -> U;

    /// Retain a present value only if the predicate returns true.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).filter(|x| x > 5) == Some(7), "filter");
    /// ```
    #[intrinsic(OptionFilter)]
    pub fn filter(self, predicate: fn(T) -> bool) -> Option<T>;

    /// Test a present value; absence returns false without calling the predicate.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).is_some_and(|x| x > 5), "is_some_and");
    /// ```
    #[intrinsic(OptionIsSomeAnd)]
    pub fn is_some_and(self, predicate: fn(T) -> bool) -> bool;

    /// Combine two present values, otherwise return None.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).zip(Some("x")) == Some((7, "x")), "zip");
    /// ```
    #[intrinsic(OptionZip)]
    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)>;

    /// Test whether a value is present.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).is_some(), "present");
    /// ```
    #[intrinsic(OptionIsSome)]
    pub fn is_some(self) -> bool;

    /// Test whether no value is present.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Option<i32> = None;
    /// std::debug::assert(value.is_none(), "absent");
    /// ```
    #[intrinsic(OptionIsNone)]
    pub fn is_none(self) -> bool;

    /// Return the contained value or the eagerly evaluated fallback.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The fallback argument is evaluated even when it is not selected. Use a conditional
    /// callback API when fallback computation must be lazy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Option<i32> = None;
    /// std::debug::assert(value.unwrap_or(7) == 7, "fallback");
    /// ```
    #[intrinsic(OptionUnwrapOr)]
    pub fn unwrap_or(self, fallback: T) -> T;

    /// Transform Some with one callback call; preserve None.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).map(|x| x + 1) == Some(8), "mapped");
    /// ```
    #[intrinsic(OptionMap)]
    pub fn map<U>(self, callback: fn(T) -> U) -> Option<U>;

    /// Call the callback only for Some and return its Option.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(7).and_then(|x| Some(x + 1)) == Some(8), "chained");
    /// ```
    #[intrinsic(OptionAndThen)]
    pub fn and_then<U>(self, callback: fn(T) -> Option<U>) -> Option<U>;

    /// Convert None into Err at this call site. The error argument is evaluated eagerly.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The fallback argument is evaluated even when it is not selected. Use a conditional
    /// callback API when fallback computation must be lazy.
    ///
    /// Converting `None` constructs a new `Err` whose origin is this conversion site. `None`
    /// itself has no error stack.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val value: Option<i32> = None;
    /// val result: Result<i32, String> = value.ok_or("missing");
    /// std::debug::assert(result.is_err(), "converted");
    /// ```
    #[intrinsic(OptionOkOr)]
    pub fn ok_or<E>(self, error: E) -> Result<T, E>;

    /// Call the callback only for None and capture the new Err origin at this conversion.
    ///
    /// Arguments are evaluated from left to right. Payload objects retain their identity;
    /// passing or returning them does not deep-copy them.
    ///
    /// The callback expression is evaluated once, but its body runs at most once and only for
    /// the selected variant. Skipped callbacks have no body side effects.
    ///
    /// Converting `None` constructs a new `Err` whose origin is this conversion site. `None`
    /// itself has no error stack.
    ///
    /// # Panics
    ///
    /// A trap or termination from a called callback propagates normally; it is not converted
    /// into `None` or `Err`.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// var calls = 0;
    /// val result: Result<i32, String> = Some(7).ok_or_else(|| { calls += 1; "missing" });
    /// std::debug::assert(result.is_ok() && calls == 0, "lazy fallback");
    /// ```
    #[intrinsic(OptionOkOrElse)]
    pub fn ok_or_else<E>(self, callback: fn() -> E) -> Result<T, E>;
}

/// Collect successful payloads, stopping at the first failure.
impl<T, C: FromIterator<T>> FromIterator<Option<T>> for Option<C> {
    /// Buffer successful items and construct C only after successful exhaustion.
    ///
    /// The first Err or None stops traversal without reading subsequent items.
    /// An Err retains its original diagnostic stack. On failure C::from_iter is
    /// not called; on success it is called once, including for empty input.
    /// Source side effects are not rolled back, and referenced items remain shared.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val result: Option<ArrayList<i32>> = [Some(20), Some(22)].iter().collect();
    /// std::debug::assert_eq(result.map(|x| x[0] + x[1]), Some(42), "success");
    /// ```
    #[intrinsic(OptionFromIterator)]
    fn from_iter<I: Iterable<Item = Option<T>>>(source: I) -> Self;
}

impl<T> Option<Option<T>> {
    /// Remove one layer of optional nesting.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(Some(Some(7)).flatten() == Some(7), "flatten");
    /// ```
    #[intrinsic(OptionFlatten)]
    pub fn flatten(self) -> Option<T>;
}

impl<T, E> Option<Result<T, E>> {
    /// Exchange the Option and Result layers, preserving an existing error origin.
    ///
    /// Arguments evaluate from left to right. Only the selected callback runs, once.
    /// Payload references remain shared; this operation does not clone object graphs.
    /// Callback failures propagate through ordinary execution cleanup.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val v: Option<Result<i32, String>> = Some(Ok(7));
    /// std::debug::assert(v.transpose() == Ok(Some(7)), "transpose");
    /// ```
    #[intrinsic(OptionTranspose)]
    pub fn transpose(self) -> Result<Option<T>, E>;
}
