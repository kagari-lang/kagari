//! Standard fmt protocols.

/// Diagnostic formatting as a string.
///
/// Interpolated strings use this protocol for `{value:?}`, including user
/// implementations. The representation is intended for inspection.
///
/// User implementations run ordinary script code and may trap. Builtin diagnostic error
/// previews do not invoke arbitrary user Debug implementations. No stable serialization
/// format is promised.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     std::debug::assert(7.debug() == "7", "debug");
/// }
/// ```
pub trait Debug {
    /// Format this value for diagnostic inspection.
    fn debug(self) -> String;
}

/// User-facing formatting as a string.
///
/// Interpolated strings use this protocol for `{value}`. Each expression is
/// evaluated once and formatted before the next expression runs.
///
/// Choose a representation appropriate for the application. This protocol does not imply
/// parsing, locale handling or a stable serialization format.
///
/// # Examples
///
/// ```kgr
/// fn main() {
///     val count = 7;
///     std::debug::assert(f"count={count}" == "count=7", "display");
/// }
/// ```
pub trait Display {
    /// Format this value for display.
    fn display(self) -> String;
}
