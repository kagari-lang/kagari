//! Resizable arrays with shared object identity. Element reads and copies are shallow.
//!
//! `Array` provides read-only access; `MutableArray` also permits writes.
//! Read-only views share storage and observe changes through writable aliases.
//! `from` constructs fresh shallow storage; referenced elements retain identity.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// A resizable sequence of elements, written `[T]` in type annotations.
///
/// Arrays share object storage. `Array<T>` permits reading its slots. Assignment keeps the
/// same object; mutations through either binding are visible through the other.
/// `val` prevents rebinding, not mutation of the array. `==` compares array identity.
///
/// Indices and lengths use `usize`. `get` and `remove` return `None` for an invalid
/// index. Indexed assignment and `insert` trap on invalid indices. Failed standard
/// mutations leave the target unchanged. Structural changes are forbidden while an
/// active iteration guard exists. Earlier successful mutations are not rolled back.
///
/// # Examples
///
/// ```kgr
/// val values = [10, 20];
/// val alias = values;
/// alias.push(30);
/// std::debug::assert(values.len() == [0, 0, 0].len(), "shared array");
/// std::debug::assert(values.get(values.len()) == None, "past the end");
/// std::debug::assert(values.remove(values.len()) == None, "nothing removed");
/// ```
#[builtin_type(Array)]
pub type Array<T>;

/// A writable shared array. Copies preserve object identity.
///
/// # Examples
///
/// ```kgr
/// val values = MutableArray::from([1, 2]);
/// std::debug::assert(!values.is_empty(), "populated");
/// ```
#[builtin_type(MutableArray)]
pub type MutableArray<T>;

impl<T> Array<T> {
    /// Create a fresh empty array with read-only access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: Array<i32> = Array::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(ArrayNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow array from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// The copy preserves input order and never invokes element equality or hashing.
    ///
    /// # Panics
    ///
    /// Allocation or resource exhaustion terminates execution without returning a partial result.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = Array::from([1, 2]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(ArrayFrom)]
    pub fn from(items: [T]) -> Self;

    /// Return the number of elements.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert([10, 20].len() == [0, 0].len(), "length");
    /// ```
    #[intrinsic(ArrayLen)]
    pub fn len(self) -> usize;

    /// Return whether the array is empty.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableArray<i32> = [];
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(ArrayIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Return the element at index, or None when out of bounds. Object elements retain their
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// An index at or beyond the length returns `None`. Indices are zero-based.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10, 20];
    /// std::debug::assert(values.get([0].len()) == Some(20), "element");
    /// std::debug::assert(values.get([0, 0, 0, 0, 0].len()) == None, "out of bounds");
    /// ```
    #[intrinsic(ArrayGet)]
    pub fn get(self, index: usize) -> Option<T>;
}

impl<T> MutableArray<T> {
    /// Create a fresh empty array with writable access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableArray<i32> = MutableArray::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(MutableArrayNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow array from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// The copy preserves input order and never invokes element equality or hashing.
    ///
    /// # Panics
    ///
    /// Allocation or resource exhaustion terminates execution without returning a partial result.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = MutableArray::from([1, 2]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(MutableArrayFrom)]
    pub fn from(items: [T]) -> Self;

    /// Append an element and return the same array. Aliases observe the change.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// Aliases observe successful changes. Validation and resource preparation precede the
    /// final modification; a failure does not commit that modification. Earlier script side
    /// effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Traps when the operation is forbidden by an active structural-iteration guard.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10];
    /// val alias = values;
    /// values.push(20);
    /// std::debug::assert(alias.get([0].len()) == Some(20), "shared array");
    /// ```
    #[intrinsic(ArrayPush)]
    pub fn push(self, item: T) -> MutableArray<T>;

    /// Remove and return the last element, or None when empty.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// Aliases observe successful changes. Validation and resource preparation precede the
    /// final modification; a failure does not commit that modification. Earlier script side
    /// effects are not rolled back.
    ///
    /// An empty array returns `None`.
    ///
    /// # Panics
    ///
    /// Traps when the operation is forbidden by an active structural-iteration guard.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10];
    /// std::debug::assert(values.pop() == Some(10), "last element");
    /// std::debug::assert(values.pop() == None, "empty array");
    /// ```
    #[intrinsic(ArrayPop)]
    pub fn pop(self) -> Option<T>;

    /// Insert at index and return the same array. An invalid index traps before modification.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// Aliases observe successful changes. Validation and resource preparation precede the
    /// final modification; a failure does not commit that modification. Earlier script side
    /// effects are not rolled back.
    ///
    /// An index equal to the length appends the element. Later elements move one position to
    /// the right.
    ///
    /// # Panics
    ///
    /// Traps when the operation is forbidden by an active structural-iteration guard. An index
    /// greater than the length also traps.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10, 30];
    /// values.insert([0].len(), 20);
    /// std::debug::assert(values.get([0].len()) == Some(20), "inserted");
    /// ```
    #[intrinsic(ArrayInsert)]
    pub fn insert(self, index: usize, item: T) -> MutableArray<T>;

    /// Remove the element at index, or return None when out of bounds.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// Aliases observe successful changes. Validation and resource preparation precede the
    /// final modification; a failure does not commit that modification. Earlier script side
    /// effects are not rolled back.
    ///
    /// An index at or beyond the length returns `None`. Indices are zero-based.
    ///
    /// # Panics
    ///
    /// Traps when the operation is forbidden by an active structural-iteration guard.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10, 20];
    /// std::debug::assert(values.remove("".len_bytes()) == Some(10), "removed");
    /// std::debug::assert(values.get("".len_bytes()) == Some(20), "shifted");
    /// ```
    #[intrinsic(ArrayRemove)]
    pub fn remove(self, index: usize) -> Option<T>;

    /// Remove all elements and return the same array.
    ///
    /// The array is a shared object. Reading an element does not copy an object graph; object
    /// elements keep their identity.
    ///
    /// Aliases observe successful changes. Validation and resource preparation precede the
    /// final modification; a failure does not commit that modification. Earlier script side
    /// effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Traps when the operation is forbidden by an active structural-iteration guard.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [10, 20];
    /// values.clear();
    /// std::debug::assert(values.is_empty(), "cleared");
    /// ```
    #[intrinsic(ArrayClear)]
    pub fn clear(self) -> MutableArray<T>;

    /// Replace every element with a shallow copy of `value`.
    ///
    /// Length is unchanged. Referenced objects retain their identity;
    /// all slots receive the same object reference. This operation does not invoke
    /// user-defined cloning. Read-only aliases observe the replacements.
    /// Element replacement is permitted during iteration.
    ///
    /// # Panics
    ///
    /// Invalid values, cancellation and resource exhaustion trap before committing
    /// any replacements. Earlier side effects remain visible.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [1, 2, 3];
    /// values.fill(9);
    /// std::debug::assert(values[0] == 9 && values[2] == 9, "filled");
    /// ```
    #[intrinsic(ArrayFill)]
    pub fn fill(self, value: T);

    /// Copy all elements from an equally sized read-only array view.
    ///
    /// Copies replace the existing slots without resizing. Values are copied
    /// shallowly; referenced objects remain shared. Copying an array onto itself
    /// is supported. This method does not call user code and returns unit.
    ///
    /// # Panics
    ///
    /// Traps if lengths differ or preparation fails. The destination is unchanged
    /// on failure. Replacements are permitted during iteration.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val destination = [0; 3];
    /// val source: Array<i32> = [4, 5, 6];
    /// destination.copy_from_slice(source);
    /// std::debug::assert(destination[1] == 5, "copied");
    /// ```
    #[intrinsic(ArrayCopyFromSlice)]
    pub fn copy_from_slice(self, source: [T]);

    /// Copy a range of elements to another position in this array.
    ///
    /// Source and destination may overlap. Copies use the original source elements
    /// and retain referenced object identities. Length does not change.
    /// RangeBounds methods run once each, lower bound before upper bound, after
    /// all arguments have been evaluated. Their side effects are not rolled back.
    ///
    /// # Panics
    ///
    /// Traps when bounds overflow, start exceeds end, either region is outside
    /// the array, or preparation fails. No final replacement occurs on failure.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = [1, 2, 3, 4];
    /// values.copy_within(0..3, 1);
    /// std::debug::assert(values[1] == 1 && values[3] == 3, "overlap");
    /// ```
    #[intrinsic(ArrayCopyWithin)]
    pub fn copy_within<R: RangeBounds<usize>>(self, source: R, destination: usize);

}

impl Array<String> {
    /// Join strings into one string, placing `separator` between adjacent elements.
    ///
    /// An empty array produces an empty string. A one-element array returns that
    /// element's contents without a separator. Elements must already be strings;
    /// use `Display` or `Debug` explicitly to format other values. The array is not
    /// modified and no user formatting callbacks are invoked by this operation.
    /// The result buffer is reserved once from the combined byte length.
    ///
    /// # Panics
    ///
    /// Execution terminates if the combined size cannot be represented or the result
    /// buffer cannot be allocated. Previously completed side effects are retained.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// std::debug::assert(["red", "green", "blue"].join(", ") == "red, green, blue", "joined");
    /// val empty: MutableArray<String> = [];
    /// std::debug::assert(empty.join(",") == "", "empty input");
    /// std::debug::assert(["one"].join(",") == "one", "no extra separator");
    /// ```
    #[intrinsic(ArrayJoin)]
    pub fn join(self, separator: String) -> String;
}

/// Produce a fresh iterator over this shared source.
impl<T> Iterable for Array<T> {
    /// The value yielded at each traversal position.
    type Item = T;
    /// The native iterator retaining this source and its current position.
    type Iter = Iter<T>;
    /// Begin a new traversal without copying elements or transferring ownership.
    ///
    /// Native collection guards prevent structural mutation during traversal.
    /// Strings yield one Unicode scalar string at a time.
    #[intrinsic(CollectionIter)]
    fn iter(self) -> Iter<T>;
}

/// Construct fresh shallow storage from an iterable source.
impl<T> FromIterator<T> for Array<T> {
    /// Collect the source in traversal order into a fresh collection.
    ///
    /// Referenced objects retain identity. Sets discard equal duplicates; maps
    /// keep the last value for each equal key. Source and key-operation failures
    /// propagate without rolling back completed callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: Array<i32> = [20, 22].iter().collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "collected");
    /// ```
    #[intrinsic(CollectionFromIterator)]
    fn from_iter<I: Iterable<Item = T>>(source: I) -> Self;
}

/// Produce a fresh iterator over this shared source.
impl<T> Iterable for MutableArray<T> {
    /// The value yielded at each traversal position.
    type Item = T;
    /// The native iterator retaining this source and its current position.
    type Iter = Iter<T>;
    /// Begin a new traversal without copying elements or transferring ownership.
    ///
    /// Native collection guards prevent structural mutation during traversal.
    /// Strings yield one Unicode scalar string at a time.
    #[intrinsic(CollectionIter)]
    fn iter(self) -> Iter<T>;
}

/// Construct fresh shallow storage from an iterable source.
impl<T> FromIterator<T> for MutableArray<T> {
    /// Collect the source in traversal order into a fresh collection.
    ///
    /// Referenced objects retain identity. Sets discard equal duplicates; maps
    /// keep the last value for each equal key. Source and key-operation failures
    /// propagate without rolling back completed callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: MutableArray<i32> = [20, 22].iter().collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "collected");
    /// ```
    #[intrinsic(CollectionFromIterator)]
    fn from_iter<I: Iterable<Item = T>>(source: I) -> Self;
}
