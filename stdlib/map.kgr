#[builtin_type(LinkedHashMap)]
pub type LinkedHashMap<K, V>;

pub trait Map<K, V>: Iterable<Item = (K, V)> {

    fn len(self) -> usize;
    fn is_empty(self) -> bool;
    fn contains_key(self, key: K) -> bool;
    fn get(self, key: K) -> Option<V>;
}
pub trait MutableMap<K, V>: Map<K, V> {
    fn get_or_insert_with(self, key: K, factory: fn() -> V) -> V;
    fn update(self, key: K, transform: fn(Option<V>) -> V) -> V;
    fn insert(self, key: K, value: V);
    fn remove(self, key: K) -> Option<V>;
    fn clear(self);
}
