//! Hash maps using Eq and Hash. Keys must keep stable equality and hash behavior while stored.
//!
//! `Map` provides read-only access; `LinkedHashMap` also permits writes.
//! Read-only views share storage and observe changes through writable aliases.
//! `from` constructs fresh shallow storage; referenced elements retain identity.
//!
//! Resource exhaustion and cancellation follow the execution-session contract.

/// A writable insertion-ordered hash map from `K` to `V`.
///
/// Keys require `Eq + Hash`. Equal keys must produce equal hashes; equal hashes do
/// not imply equal keys. Inserting an existing key replaces its value. The caller
/// must keep the equality and hash of a stored key stable, including changes through
/// aliases. Custom comparison and hashing can execute script code and can trap.
///
/// Assignment shares the map. `==` compares map identity. Snapshot operations such
/// as `keys`, `values`, and `entries` create read-only lists but keep references to objects
/// inside them. Iteration follows insertion order. Structural mutation during guarded
/// iteration traps; completed earlier side effects are preserved.
///
/// # Examples
///
/// ```kgr
/// val names: LinkedHashMap<i32, String> = LinkedHashMap::new();
/// names.insert(1, "first");
/// names.insert(1, "updated");
/// std::debug::assert(names.get(1) == Some("updated"), "lookup");
/// std::debug::assert(names.get(2) == None, "absent key");
/// ```

#[builtin_type(LinkedHashMap)]
pub type LinkedHashMap<K, V>;

impl<K: Eq + Hash, V> LinkedHashMap<K, V> {
    /// Return the number of entries.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.len() == [0].len(), "length");
    /// ```
    #[intrinsic(MapLen)]
    pub fn len(self) -> usize;

    /// Return whether the map is empty.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(MapIsEmpty)]
    pub fn is_empty(self) -> bool;

    /// Test membership using Eq and Hash.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.contains_key(1), "key");
    /// ```
    #[intrinsic(MapContainsKey)]
    pub fn contains_key(self, key: K) -> bool;

    /// Return the associated value, or None if the key is absent.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.get(1) == Some("one"), "value");
    /// std::debug::assert(values.get(2) == None, "absent");
    /// ```
    #[intrinsic(MapGet)]
    pub fn get(self, key: K) -> Option<V>;

    /// Return a read-only shallow snapshot of the keys.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// The snapshot preserves insertion order and has independent slots. Later map
    /// changes do not change those slots; referenced key/value objects remain shared.
    /// Use `ArrayList::from(snapshot)` for a writable copy, or `iter()` to traverse
    /// the map without allocating a snapshot.
    ///
    /// # Panics
    ///
    /// Allocation failure, cancellation or resource exhaustion terminates construction.
    /// No partial snapshot is returned. Snapshot creation does not call key Eq/Hash.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.keys().get("".len_bytes()) == Some(1), "key snapshot");
    /// ```
    #[intrinsic(MapKeys)]
    pub fn keys(self) -> List<K>;

    /// Return a read-only shallow snapshot of the values.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// The snapshot preserves insertion order and has independent slots. Later map
    /// changes do not change those slots; referenced key/value objects remain shared.
    /// Use `ArrayList::from(snapshot)` for a writable copy, or `iter()` to traverse
    /// the map without allocating a snapshot.
    ///
    /// # Panics
    ///
    /// Allocation failure, cancellation or resource exhaustion terminates construction.
    /// No partial snapshot is returned. Snapshot creation does not call key Eq/Hash.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.values().get("".len_bytes()) == Some("one"), "value snapshot");
    /// ```
    #[intrinsic(MapValues)]
    pub fn values(self) -> List<V>;

    /// Return a read-only shallow snapshot of key/value tuples.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// The snapshot preserves insertion order and has independent slots. Later map
    /// changes do not change those slots; referenced key/value objects remain shared.
    /// Use `ArrayList::from(snapshot)` for a writable copy, or `iter()` to traverse
    /// the map without allocating a snapshot.
    ///
    /// # Panics
    ///
    /// Allocation failure, cancellation or resource exhaustion terminates construction.
    /// No partial snapshot is returned. Snapshot creation does not call key Eq/Hash.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.entries().get("".len_bytes()) == Some((1, "one")), "entry snapshot");
    /// ```
    #[intrinsic(MapEntries)]
    pub fn entries(self) -> List<(K, V)>;
}

impl<K: Eq + Hash, V> LinkedHashMap<K, V> {
    /// Create a fresh empty map with writable access.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<String, i32> = LinkedHashMap::new();
    /// std::debug::assert(values.is_empty(), "empty");
    /// ```
    #[intrinsic(LinkedHashMapNew)]
    pub fn new() -> Self;

    /// Construct a fresh shallow map from the supplied elements.
    ///
    /// Referenced objects retain identity. The result does not share input slots.
    /// Equal keys keep the last supplied value. Keys must remain stable while stored.
    /// Input is traversed in order using the selected Eq and Hash implementations.
    ///
    /// # Panics
    ///
    /// Propagates traps from user comparison or hashing. No partial result is returned.
    /// Completed callback effects are not rolled back.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values = LinkedHashMap::from([("one", 1), ("two", 2)]);
    /// std::debug::assert(!values.is_empty(), "populated");
    /// ```
    #[intrinsic(LinkedHashMapFrom)]
    pub fn from(items: [(K, V)]) -> Self;

    /// Insert or replace an entry and return the same map.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "old");
    /// values.insert(1, "new");
    /// std::debug::assert(values.get(1) == Some("new") && values.len() == [0].len(), "replaced");
    /// ```
    #[intrinsic(MapInsert)]
    pub fn insert(self, key: K, item: V) -> LinkedHashMap<K, V>;

    /// Remove the entry and return its value, or None if absent.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// std::debug::assert(values.remove(1) == Some("one"), "removed");
    /// std::debug::assert(values.remove(1) == None, "absent");
    /// ```
    #[intrinsic(MapRemove)]
    pub fn remove(self, key: K) -> Option<V>;

    /// Remove all entries and return the same map.
    ///
    /// Keys are compared with `Eq` and hashed with `Hash`, including user implementations.
    /// Equal keys must have equal hashes; a hash collision alone does not imply equality.
    ///
    /// Do not change fields used by equality or hashing while a key is stored. Keys and values
    /// containing objects share those objects; this operation does not perform a deep copy.
    ///
    /// Mutations affect the same container and are visible through aliases. Failed preparation
    /// does not commit the target modification.
    ///
    /// # Panics
    ///
    /// User equality or hashing may trap where invoked. Mutation guards and execution resource
    /// limits still apply where the operation modifies or allocates storage.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, String> = LinkedHashMap::new();
    /// values.insert(1, "one");
    /// values.clear();
    /// std::debug::assert(values.is_empty(), "cleared");
    /// ```
    #[intrinsic(MapClear)]
    pub fn clear(self) -> LinkedHashMap<K, V>;
}

/// Produce a fresh iterator over this shared source.
impl<K: Eq + Hash, V> Iterable for LinkedHashMap<K, V> {
    /// The value yielded at each traversal position.
    type Item = (K, V);
    /// The native iterator retaining this source and its current position.
    type Iter = Iter<(K, V)>;
    /// Begin a new traversal without copying elements or transferring ownership.
    ///
    /// Native collection guards prevent structural mutation during traversal.
    /// Strings yield one Unicode scalar string at a time.
    #[intrinsic(CollectionIter)]
    fn iter(self) -> Iter<(K, V)>;
}

/// Construct fresh shallow storage from an iterable source.
impl<K: Eq + Hash, V> FromIterator<(K, V)> for LinkedHashMap<K, V> {
    /// Collect the source in traversal order into a fresh collection.
    ///
    /// Referenced objects retain identity. Sets discard equal duplicates; maps
    /// keep the last value for each equal key. Source and key-operation failures
    /// propagate without rolling back completed callback effects.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val values: LinkedHashMap<i32, i32> = [(1, 20), (2, 22)].iter().collect();
    /// std::debug::assert_eq(values.len(), "ab".len_bytes(), "collected");
    /// ```
    #[intrinsic(CollectionFromIterator)]
    fn from_iter<I: Iterable<Item = (K, V)>>(source: I) -> Self;
}

/// Read-only access to key-value associations.
///
/// The interface does not require `Eq + Hash` and does not prescribe an iteration
/// order. Those choices belong to the implementation. `LinkedHashMap<K, V>` requires
/// `K: Eq + Hash` and traverses entries in insertion order. Scripts can provide other
/// implementations. `get` returns `None` for an absent key; `iter` yields `(K, V)` pairs.
///
/// A view shares its object with writable aliases and does not freeze keys or values.
/// Type arguments are invariant. Equality and hashing use underlying object identity.
/// Construct a concrete implementation before converting it to this interface.
///
/// # Examples
///
/// ```kgr
/// val storage = LinkedHashMap::from([("answer", 20)]);
/// val view: Map<String, i32> = storage;
/// storage.insert("answer", 42);
/// std::debug::assert_eq(view.get("answer"), Some(42), "live view");
/// std::debug::assert_eq(view.get("missing"), None, "absent");
/// ```
pub trait Map<K, V>: Iterable<Item = (K, V), Iter = Iter<(K, V)>> {
    /// Return an independent read-only shallow snapshot in iteration order.
    ///
    /// Later map changes do not alter the snapshot's slots. Referenced objects
    /// remain shared. Use ArrayList::from to obtain writable independent slots.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val source: Map<String, i32> = LinkedHashMap::from([("answer", 42)]);
    /// std::debug::assert(source.keys().len() == 1usize, "snapshot");
    /// ```
    #[intrinsic(MapKeysView)]
    fn keys(self) -> List<K>;

    /// Return an independent read-only shallow snapshot in iteration order.
    ///
    /// Later map changes do not alter the snapshot's slots. Referenced objects
    /// remain shared. Use ArrayList::from to obtain writable independent slots.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val source: Map<String, i32> = LinkedHashMap::from([("answer", 42)]);
    /// std::debug::assert(source.values().len() == 1usize, "snapshot");
    /// ```
    #[intrinsic(MapValuesView)]
    fn values(self) -> List<V>;

    /// Return an independent read-only shallow snapshot in iteration order.
    ///
    /// Later map changes do not alter the snapshot's slots. Referenced objects
    /// remain shared. Use ArrayList::from to obtain writable independent slots.
    ///
    /// # Examples
    ///
    /// ```kgr
    /// val source: Map<String, i32> = LinkedHashMap::from([("answer", 42)]);
    /// std::debug::assert(source.entries().len() == 1usize, "snapshot");
    /// ```
    #[intrinsic(MapEntriesView)]
    fn entries(self) -> List<(K, V)>;


    /// Returns the number of entries.
    fn len(self) -> usize;
    /// Reports whether the map is empty.
    fn is_empty(self) -> bool;
    /// Tests whether the map contains a key.
    fn contains_key(self, key: K) -> bool;
    /// Returns the value for a key, or `None`.
    fn get(self, key: K) -> Option<V>;
}

/// Writable access to key-value associations.
///
/// Extends `Map<K, V>` with insertion, removal and clearing. Inserting a key already
/// present replaces its value. `insert` returns unit; `remove` returns the previous
/// value, or `None`. A mutable view can be passed as a read-only `Map` without copying.
/// Key equivalence and traversal order are selected by the implementation.
/// Implementations must validate and prepare a mutation before committing it.
///
/// # Examples
///
/// ```kgr
/// val view: MutableMap<String, i32> = LinkedHashMap::new();
/// view.insert("answer", 42);
/// val readable: Map<String, i32> = view;
/// std::debug::assert_eq(readable.get("answer"), Some(42), "shared view");
/// std::debug::assert_eq(view.remove("answer"), Some(42), "removed");
/// ```
pub trait MutableMap<K, V>: Map<K, V> {
    /// Associates a key with a value, replacing an existing value.
    fn insert(self, key: K, value: V) -> ();
    /// Removes and returns the value for a key, or `None`.
    fn remove(self, key: K) -> Option<V>;
    /// Removes all entries.
    fn clear(self) -> ();
}

/// Provides the Map capability for the native storage class.
impl<K: Eq + Hash, V> Map<K, V> for LinkedHashMap<K, V> {
    /// Returns the number of entries.
    #[intrinsic(MapLen)]
    fn len(self) -> usize;
    /// Reports whether the map is empty.
    #[intrinsic(MapIsEmpty)]
    fn is_empty(self) -> bool;
    /// Tests whether the map contains a key.
    #[intrinsic(MapContainsKey)]
    fn contains_key(self, key: K) -> bool;
    /// Returns the value for a key, or `None`.
    #[intrinsic(MapGet)]
    fn get(self, key: K) -> Option<V>;
}

/// Provides the MutableMap capability for the native storage class.
impl<K: Eq + Hash, V> MutableMap<K, V> for LinkedHashMap<K, V> {
    /// Associates a key with a value, replacing an existing value.
    #[intrinsic(MapInsert)]
    fn insert(self, key: K, value: V) -> ();
    /// Removes and returns the value for a key, or `None`.
    #[intrinsic(MapRemove)]
    fn remove(self, key: K) -> Option<V>;
    /// Removes all entries.
    #[intrinsic(MapClear)]
    fn clear(self) -> ();
}
