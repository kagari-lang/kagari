fn run(n: i32) -> i32 {
    var i = 0;
    var state = 7;
    var sum = 0;
    while i < n {
        state = (state * 17 + 13) % 65521;
        if state % 3 == 0 {
            sum = sum + state % 97;
        } else {
            sum = sum + state % 31;
        }
        i = i + 1;
    }
    sum
}

fn main() -> i32 {
    run(__N__)
}
