fn run(n: i32) -> i32 {
    val values: ArrayList<i32> = [];
    var i = 0;
    while i < n {
        values.push(i % 97);
        i = i + 1;
    }
    i = 0;
    while i < n {
        values[i] = values[i] * 3 + 1;
        i = i + 1;
    }
    i = 0;
    var sum = 0;
    while i < n {
        sum = sum + values[i];
        i = i + 1;
    }
    sum
}

fn main() -> i32 {
    run(__N__)
}
