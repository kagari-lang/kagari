fn run(n: i32) -> i32 {
    val values: HashMap<i32, i32> = HashMap::new();
    var i = 0;
    while i < n {
        values.insert(i * 17 + 1, i % 97);
        i = i + 1;
    }
    i = 0;
    while i < n {
        val key = i * 17 + 1;
        val value = match values.get(key) {
            Some(value) => value,
            None => -1,
        };
        values.insert(key, value + 1);
        i = i + 1;
    }
    i = 0;
    var sum = 0;
    while i < n {
        val value = match values.get(i * 17 + 1) {
            Some(value) => value,
            None => -1,
        };
        sum = sum + value;
        i = i + 1;
    }
    sum
}

fn main() -> i32 {
    run(__N__)
}
