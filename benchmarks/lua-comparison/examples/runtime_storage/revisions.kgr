pub fn revision_growth(n: i32) -> i32 {
    val values: Vec<i32> = Vec::new();
    var i = 0;
    while i < n { values.push(i); i = i + 1; }
    values.len() as i32
}

pub fn revision_iterator(n: i32) -> i32 {
    val values: Vec<i32> = Vec::new();
    var i = 0;
    while i < n { values.push(i); i = i + 1; }
    var count = 0;
    for value in values { if value >= 0 { count = count + 1; } }
    count
}

pub fn revision_callback(n: i32) -> i32 {
    val values: Vec<i32> = Vec::new();
    var i = 0;
    while i < n { values.push(i); i = i + 1; }
    values.retain(|value: i32| value >= 0);
    values.reverse();
    values.len() as i32
}
